# Build artifacts (generated by the pipeline; never committed)
build/

# Local agent tooling (skills installed via `npx skills add`) — not part of the
# project; lives in the working tree only.
.agents/
.claude/
skills-lock.json

# Licensed TLG corpus material must never enter the repo
TLG Files/
*.TXT
*.IDT
Diogenes-Resources/

# ...but the Bonitz index is a public-domain 1870 volume we OCR'd ourselves,
# not TLG. This filesystem is case-insensitive, so the *.TXT rule above also
# matches .txt and was silently keeping every transcription, adjudication and
# reconciled column out of version control.
!bonitz/**/*.txt

# The Bonitz scan itself and everything derived from it is large and
# reproducible from book.pdf — 791MB that a bare `git add bonitz` would
# otherwise sweep in alongside the 3.7MB of transcription that matters.
bonitz/book.pdf
bonitz/images/
bonitz/chunks/
bonitz/work/review_crops/
bonitz/work/*.html
bonitz/work/aristotle-forms.json

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
app/node_modules/
shared/node_modules/
app/dist/
app/.astro/

# Local planning roadmap — not published
planned changes.md

# Pipeline-generated app data (same category as build/ — never committed)
app/src/data/

# Copyright-encumbered translation sources — kept LOCAL ONLY for the full build,
# never committed/published (the -public manifests don't use them). J. L. Ackrill
# (Clarendon, 1963): the Bekker-key guide + a local-only third translation.
sources/cat-ackrill/
sources/int-ackrill/
