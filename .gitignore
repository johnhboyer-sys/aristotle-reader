# Build artifacts (generated by the pipeline; never committed)
build/

# Local agent tooling (skills installed via `npx skills add`) — not part of the
# project; lives in the working tree only.
.agents/
.claude/
skills-lock.json

# Licensed TLG corpus material must never enter the repo
TLG Files/
*.TXT
*.IDT
Diogenes-Resources/

# ...but the Bonitz index is a public-domain 1870 volume we OCR'd ourselves,
# not TLG. This filesystem is case-insensitive, so the *.TXT rule above also
# matches .txt and was silently keeping every transcription, adjudication and
# reconciled column out of version control.
!bonitz/**/*.txt

# The Bonitz scan itself and everything derived from it is large and
# reproducible from book.pdf — 791MB that a bare `git add bonitz` would
# otherwise sweep in alongside the 3.7MB of transcription that matters.
bonitz/book.pdf
bonitz/images/
bonitz/chunks/
bonitz/work/review_crops/
bonitz/work/*.html
bonitz/work/aristotle-forms.json

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
app/node_modules/
shared/node_modules/
app/dist/
app/.astro/

# Local planning roadmap — not published
planned changes.md

# Pipeline-generated app data (same category as build/ — never committed)
app/src/data/

# Copyright-encumbered translation sources — kept LOCAL ONLY for the full build,
# never committed/published (the -public manifests don't use them). J. L. Ackrill
# (Clarendon, 1963): the Bekker-key guide + a local-only third translation.
sources/cat-ackrill/
sources/int-ackrill/

# Playwright MCP scratch (browser snapshots/console logs from a verification run)
.playwright-mcp/

# --- bonitz: 8 GB of scans, models and derived crops (2026-08-08) ---
# `git add bonitz` without these pulls in the lot. The text record that
# matters is mirrored in ~/Developer/bonitz-text.git.
bonitz/work/scan400/
# NOT `bonitz/work/kraken/` — git never descends into an excluded DIRECTORY,
# so the negation below could never fire and NOTES.md, the running record of
# every decision on this corpus, was silently untracked. Exclude the contents
# and the negation works.
bonitz/work/kraken/*
!bonitz/work/kraken/NOTES.md
bonitz/work/kraken400/
bonitz/work/review4_crops_*/
bonitz/work/review5_crops_*/
bonitz/work/sweeps/crops/
# Review pages embed their 400 dpi crops as base64, so one runs 6-17 MB, and
# they regenerate from the TSV plus the scans:
#   python3 -m bonitz_pipeline.mark_review --class A --html <path>
# John's ruling, 2026-08-08: keep them out. The VERDICTS are text and stay in
# (work/sweeps/mark-verdicts.json) — the page is a view of them, not the record.
bonitz/work/sweeps/*.html
bonitz/work/codex/strips400/
bonitz/raw/genie400/
bonitz/raw/llama400/
bonitz/raw/llama400-pilot*/
bonitz/work/*.log
