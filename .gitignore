# Build artifacts (generated by the pipeline; never committed)
build/

# Local agent tooling (skills installed via `npx skills add`) — not part of the
# project; lives in the working tree only.
.agents/
.claude/
skills-lock.json

# Licensed TLG corpus material must never enter the repo
TLG Files/
*.TXT
*.IDT
Diogenes-Resources/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
app/node_modules/
shared/node_modules/
app/dist/
app/.astro/

# Local planning roadmap — not published
planned changes.md

# Pipeline-generated app data (same category as build/ — never committed)
app/src/data/

# ...but `*.TXT` above matches lowercase `.txt` too, because git on macOS is
# case-insensitive. Model transcriptions live under sources/*/work/ and must not
# be swallowed by the TLG rule.
!sources/*/work/*/out/*.txt

# Vendored page scans — public domain, but far too large for git. Every file is
# re-fetchable from the Internet Archive identifier recorded in the sibling
# PROVENANCE.md; the notes stay tracked, the rasters do not.
sources/*/scan/

# Derived page rasters under sources/*/work/ — tiles cut for a reading pass and
# zoom crops made while checking the ink. Regenerable from the scan; the
# transcriptions and prompts beside them stay tracked.
sources/*/work/*/tiles/
sources/*/work/*/tmpzoom/
sources/*/work/verify/

# Copyright-encumbered translation sources — kept LOCAL ONLY for the full build,
# never committed/published (the -public manifests don't use them). J. L. Ackrill
# (Clarendon, 1963): the Bekker-key guide + a local-only third translation.
sources/cat-ackrill/
sources/int-ackrill/

# Bonitz working rasters and PDFs — the Index Aristotelicus scan (105 MB), the
# page chunks cut from it, the TIFF page images, and the OCR scratch. These were
# untracked but NOT ignored, which left 1.1 GB sitting one `git add -A` away
# from the history; book.pdf alone exceeds GitHub's 100 MiB per-file hard limit,
# so such a push is rejected only AFTER the commit exists locally. Same rule as
# sources/*/scan/ above: the scan is re-fetchable and the crops regenerable,
# while the transcriptions under bonitz/output stay tracked.
bonitz/book.pdf
bonitz/chunks/
bonitz/images/
bonitz/work/
