---
// The site's web fonts, served from the site itself (app/public/fonts/). One
// stylesheet declares every face; a browser fetches a file only when a page
// uses that face for a character in the file's range. data-reader-font tells
// the reader (shared/components/Reader.svelte) that its two optional faces
// are here, so it fetches no stylesheet of its own.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<link rel="stylesheet" href={`${base}/fonts/fonts.css`} data-reader-font="cardo garamond" />
