---
import ThemeToggle from './ThemeToggle.astro';
const { active = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navLinks = [['/', 'Works'], ['/search', 'Search'], ['/lemma/', 'Lexicon'], ['/phrases', 'Phrases'], ['/support', 'Support']];
---
      <header class="b-nav">
        <a class="b-brand" href={`${base}/`}>Aristotle Reader</a>
        <nav class="b-links" aria-label="Site">
          {navLinks.map(([href, label]) => <a href={`${base}${href}`} class={href === active ? 'on' : ''}>{label}</a>)}
          <ThemeToggle bMoon />
          <a class="b-ib b-only-s" href={`${base}/search`} aria-label="Search"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.8" cy="6.8" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.4"/></svg></a>
          <details class="b-sm b-only-s"><summary aria-label="Menu"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.4"/></svg></summary><div class="b-sm-p">{navLinks.map(([href,label]) => <a href={`${base}${href}`} aria-current={href === active ? 'page' : undefined}>{label}</a>)}</div></details>
        </nav>
      </header>
