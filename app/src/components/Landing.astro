---
// A work's landing page, served at the bare /<work> slug. An overview that
// describes the work, credits the Greek source + translations, lists the
// table of contents (linking into the reader), surfaces the "start reading"
// editions, and points to in-print modern translations/commentaries we can't
// host. The reader itself lives at /<work>/book/<n> for every work.
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { publicDir } from 'astro:config/server';
import plates from '../data/plates.json';
import BFonts from './BFonts.astro';
import BNav from './BNav.astro';
import BFoot from './BFoot.astro';
import ThemeInit from './ThemeInit.astro';
import Pwa from './Pwa.astro';
import {
  AUTHENTICITY_LABEL, CATEGORIES, DIVISION_NAMES, getWork, bookLabel, workPath, visibleTranslations,
  furtherReading, inPrintHref, workLanding, resourcesFor,
} from '@shared/lib/works';
import { sanitizeHtml } from '../lib/html';
import { isChapterSection } from '@shared/lib/data';
import { jsonLdSafe } from '../lib/jsonld';
import { bookSpan, translatorName, transParts } from '../lib/nav';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
import CommandPalette from '@shared/components/CommandPalette.svelte';

interface Props { workId: string; }
const { workId } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const work = getWork(workId)!;
// Author-facing strings (title, meta description, JSON-LD) derive from
// work.author, not a hardcoded "Aristotle" — the Isagoge is Porphyry's.
const author = work.author;
// What the reader cites by: Bekker column and line, or (the Athenian
// Constitution) chapter and section.
const usesBekker = !work.citation || work.citation.scheme === 'bekker';
const citationName = isChapterSection(work) ? 'chapter and section' : 'Bekker';

interface ChapterRef { chapter: string; column: string; line: string; bekker: string; }
const allChapters: Record<string, ChapterRef[]> = JSON.parse(
  readFileSync(fileURLToPath(new URL(`data/${workId}/chapters.json`, publicDir)), 'utf-8'),
);
interface BookOutline { book: number; label: string; chapters: ChapterRef[]; }
const outline: BookOutline[] = Array.from({ length: work.books }, (_, i) => {
  const b = i + 1;
  return { book: b, label: bookLabel(work, b), chapters: allChapters[String(b)] ?? [] };
});
const totalChapters = outline.reduce((n, b) => n + b.chapters.length, 0);

const editions = visibleTranslations(work);
const primary = editions.find((t) => t.id === work.defaultTranslation)
  ?? editions.find((t) => t.slot === 'english') ?? editions[0];

const translatorNames = editions.map((t) => translatorName(t.name));
const commentaries = (work.commentaries ?? [])
  .map((id) => getWork(id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));
const resources = resourcesFor(workId);
const reading = furtherReading(workId);

const readHref = (q = '') => `${base}${workPath(workId, 1)}${q}`;

const dataFile = (name: string) => fileURLToPath(new URL(`data/${workId}/${name}`, publicDir));
const readOptional = (name: string) => existsSync(dataFile(name)) ? JSON.parse(readFileSync(dataFile(name), 'utf8')) : {};
const genericTitles = readOptional('chapter-titles.json');
const translationTitles = readOptional('third-titles.json');
const titles: Record<string, Record<string,string>> = translationTitles[primary?.id] || genericTitles;
const ostwaldTitles = primary?.id === 'ostwald' && Object.values(translationTitles.ostwald || {}).some((chapters) => Object.keys(chapters as object).length);
const division = CATEGORIES.find(c => [...(c.works || []), ...(c.subcategories || []).flatMap(g => g.works)].some(w => w.id === workId));
const divisionName = division ? DIVISION_NAMES[division.title] : 'Commentary';
const extent = `${work.books > 1 ? `${work.books} books, ` : ''}${totalChapters} chapter${totalChapters === 1 ? '' : 's'}`;
const chapterTitle = (book: number, chapter: string) => (titles[String(book)]?.[chapter] || `Chapter ${chapter}`).replace(/\[\^[^\]]*\]/g, '');
const chapterLink = (book: number, chapter: string) => `${base}${workPath(workId, book)}#ch-${book}-${chapter}`;
const plate = plates[workId as keyof typeof plates];
// ── SEO ─────────────────────────────────────────────────────────────────────
const pageTitle = `${work.title} — ${author}, in Greek & English`;
const metaDescription =
  `${work.title} by ${author}: the original Greek (${work.greekSource.short})` +
  ` with English translation` +
  (translatorNames.length ? ` (${translatorNames.join(', ')})` : '') +
  `, table of contents, morphology, and ${citationName} citation. ${work.blurb}`;
const canonical = Astro.site
  ? new URL(`${base}${workPath(workId, 1).replace(/\/book\/1$/, '')}/`, Astro.site).href
  : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: work.title,
  ...(work.greekTitle ? { alternateName: work.greekTitle } : {}),
  author: { '@type': 'Person', name: author },
  ...(translatorNames.length
    ? { translator: translatorNames.map((name) => ({ '@type': 'Person', name })) }
    : {}),
  inLanguage: ['grc', 'en'],
  ...(canonical ? { url: canonical } : {}),
  numberOfPages: totalChapters,
  isPartOf: { '@type': 'CreativeWorkSeries', name: 'The Works of Aristotle' },
  description: work.blurb,
};
// Breadcrumb (Home › Work) for a SERP breadcrumb rich result. Absolute URLs
// required, so emitted only when Astro.site is set.
const breadcrumbLd = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Aristotle',
          item: new URL(`${base}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: work.title,
          item: new URL(`${base}${workLanding(workId)}/`, Astro.site).href },
      ],
    }
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    document.documentElement.classList.add('poster-fitting');
    setTimeout(() => document.documentElement.classList.remove('poster-fitting'), 3000);
  </script>
  <ThemeInit />
  <Pwa />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="book" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Aristotle Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumbLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <BFonts />

</head>
<body>
  <CommandPalette work={workId} client:load />
  <div class="frame dir-b pg-work" data-work-page={workId}>
    <div class="b-page">
      <BNav />
      <main>
        <p class="b-crumb"><a href={`${base}/`}>Works</a> / <span>{divisionName}</span></p>
        <div class={`b-top pl-${plate.place}`} style={`--ix:${plate.ink[0]};--iy:${plate.ink[1]};--iw:${plate.ink[2] - plate.ink[0]};--ih:${plate.ink[3] - plate.ink[1]}`}>
        <section class="b-po work pl dp-paper tp-side" data-tp="side" data-ts="1" data-work={workId}>
          <picture><source media="(max-width: 960px)" srcset={`${base}/plates/phone/${workId}.jpg`} width="640" height="558"/><img src={`${base}/plates/desk/${workId}.jpg`} width="1280" height="914" alt={plate.alt} decoding="async"/></picture>
          <h1 class="b-po-t" data-fit="poster" data-title={work.title}>{work.title}</h1>
        </section>
        <div class="b-po-below">
          {work.greekTitle && <p class="b-wk-gt" lang="grc" data-fit="line">{work.greekTitle}</p>}
          <div class="b-ctas" data-work={workId} data-books={JSON.stringify(work.bookLabels)} data-chapters={JSON.stringify(allChapters)}>
            <a class="b-btn pri" data-start href={primary ? readHref(`?trans=${primary.id}`) : readHref()}>Start reading</a>
            <span id="work-resume-slot"></span>
            <a class="b-btn" data-greek href={readHref('?view=greek')}>Greek only</a>
            {editions.length >= 2 && <a class="b-btn" data-compare href={readHref('?trans=compare')}>Compare translations</a>}
          </div>
          <div class="b-words">
            <p class="b-wk-blurb">{work.blurb}{work.authenticity && work.authenticity !== 'genuine' && <span class="b-tag">{AUTHENTICITY_LABEL[work.authenticity]}</span>}</p>
            {work.related?.map(r => getWork(r.id) && <p class="b-cred b-related"><a href={`${base}${workLanding(r.id)}`}>{r.label}</a></p>)}
            <section class="b-wk" data-section="facts">
              <dl class="b-facts">
                <dt>Greek</dt><dd>{work.greekSource.full}{work.greekSource.licence && <> <a href={work.greekSource.licence.url}>{work.greekSource.licence.name}</a></>}</dd>
                <dt>English</dt><dd>{editions.map(t => { const parts = transParts(t.name); return <><div><span data-english-entry><a href={readHref(`?trans=${t.id}`)}>{parts.who}</a>{parts.rest && `, ${parts.rest}`}</span>{editions.length > 1 && primary?.id === t.id && <>{' '}<small>opens first</small></>}</div>{workId === 'EN' && t.id === 'ostwald' && <div data-english-entry><a href={`${base}/EN/glossary`}>glossary</a></div>}</>; })}</dd>
                <dt>Length</dt><dd>{extent}</dd>
              </dl>
            </section>
          </div>
        </div>
        </div>
        <section class="b-sec" data-section="books">
          <h2 class="b-h2">{work.books > 1 ? 'Books and chapters' : 'Chapters'}</h2>
          {ostwaldTitles && <p class="b-note3">Chapter titles are Ostwald’s.</p>}
          {work.books > 1 && <p class="b-bkall"><button type="button" data-books-open>Open all books</button><button type="button" data-books-close>Close all</button></p>}
          <div class={work.books > 1 ? 'b-bks' : undefined}>
          {outline.map(b => {
            const rows = <ol class="b-chs">{b.chapters.map(c => <li><a href={chapterLink(b.book,c.chapter)} data-book={b.book} data-chapter={c.chapter}><span class="b-cn">{c.chapter}</span><span class="b-ct">{chapterTitle(b.book,c.chapter)}</span><span class="b-cb">{usesBekker ? c.bekker : ''}</span></a></li>)}</ol>;
            return work.books > 1 ? <>
              <details class="b-bk" data-book={b.book}><summary><span class="b-bkn" lang={/[α-ωΑ-Ω]/.test(b.label) ? 'grc' : 'en'}><span class="b-bkw">Book </span>{b.label}</span><span class="b-bkf">{titles[String(b.book)]?.[b.chapters[0]?.chapter] ? chapterTitle(b.book,b.chapters[0].chapter) : <span class="b-bks2">{usesBekker ? bookSpan(b.chapters).split(' · ')[1] ?? '' : ''}</span>}</span><span class="b-bkc">{b.chapters.length} chapter{b.chapters.length === 1 ? '' : 's'}</span></summary>{rows}</details>
            </> : rows;
          })}
          </div>
        </section>
        <section class="b-sec b-two" data-section="reference">
          {(reading.length > 0 || resources.length > 0) && <div>
            {reading.length > 0 && <section data-section="print"><h2 class="b-h2">In print</h2><ul class="b-print">{reading.map(r => <li><small>{r.kind === 'collection' ? 'In print' : r.kind === 'translation' ? 'Translation' : 'Commentary'}</small><span><a data-citation href={inPrintHref(r)} target="_blank" rel="noopener nofollow" set:html={sanitizeHtml(r.cite)}/></span></li>)}</ul></section>}
            {resources.length > 0 && <section data-section="resources"><h2 class="b-h2">Resources</h2><ul class="b-print">{resources.map(r => <li><span><a href={r.url} target="_blank" rel="noopener">{r.label}</a>{' — '}{r.blurb}{r.exercises && <> See {r.exercises}, relevant to this work.</>}{' '}Developed by <a href={r.authorUrl} target="_blank" rel="noopener">{r.authorName}</a>.</span></li>)}</ul></section>}
          </div>}
          <div>
            {commentaries.length > 0 && <section data-section="commentary"><h2 class="b-h2">Commentary</h2><ul class="b-trs">{commentaries.map(c => <li><a href={`${base}${workLanding(c.id)}`}><span>{c.author}, <i>{c.title}</i></span><small>{c.blurb}</small></a></li>)}</ul></section>}
            <section data-section="sources"><h2 class="b-h2">Sources</h2><p class="b-cred"><a href={`${base}/attribution`}>Texts &amp; licences</a></p>

            </section>
          </div>
        </section>
      </main>
      <BFoot />
    </div>
  </div>
  <script>
    import { initPosters } from '../lib/poster-fit';
    import { resumeFor } from '@shared/lib/resume';
    import { parseBekker } from '@shared/lib/data';
    initPosters();
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-books-open],[data-books-close]')) button.addEventListener('click', () => {
      for (const book of document.querySelectorAll<HTMLDetailsElement>('.b-bk')) book.open = button.hasAttribute('data-books-open');
    });
    const controls = document.querySelector<HTMLElement>('.b-ctas')!;
    const id = controls.dataset.work!;
    const saved = resumeFor(id);
    if (saved) {
      const labels: string[] = JSON.parse(controls.dataset.books!);
      const chapters = JSON.parse(controls.dataset.chapters!);
      const book = Math.max(1,Math.min(labels.length,saved.book));
      const ref = saved.cite ? parseBekker(saved.cite) : null;
      const index = (column: string,line: number) => Number(column.slice(0,-1))*100000+(column.endsWith('b')?10000:0)+line;
      const chapter = ref ? [...(chapters[String(book)] || [])].reverse().find(c => {
        const endText = String(c.bekker).split(/[–—]/).pop()!.trim();
        const end = parseBekker(/^\d+[ab]\d/.test(endText) ? endText : `${c.column}${endText}`);
        return end && index(c.column,Number(c.line)) <= index(ref.column,ref.line) && index(ref.column,ref.line) <= index(end.column,end.line);
      }) : null;
      const link = document.createElement('a'); link.className = 'b-btn'; link.dataset.resume = '';
      const base = import.meta.env.BASE_URL.replace(/\/$/,'');
      link.href = `${base}/${id}/book/${book}${saved.cite ? `#${saved.cite}` : ''}`;
      link.textContent = `Resume at ${labels.length > 1 ? `Book ${labels[book-1]}` : ''}${chapter ? `${labels.length > 1 ? ', ' : ''}chapter ${chapter.chapter}` : labels.length === 1 ? 'the saved place' : ''}`;
      document.getElementById('work-resume-slot')!.append(link);
    }
  </script>
</body>
</html>
