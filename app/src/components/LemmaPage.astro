---
import { readFileSync } from 'node:fs';
import ThemeInit from './ThemeInit.astro';
import Pwa from './Pwa.astro';
import BFonts from './BFonts.astro';
import BNav from './BNav.astro';
import BFoot from './BFoot.astro';
import { sanitizeHtml } from '../lib/html';
import { nearbyFor, ostwaldFor } from '../lib/lemma-index';
import { lemmaWorkHref } from '../lib/lemma-view';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '@shared/styles/b.css';

interface Props { slug: string; }
const { slug } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Distinctiveness {
  in_aristotle: number;
  before_aristotle: number;
  contemporary: number;
  label: string | null;
}
interface LemmaData {
  slug: string; key: string; head: string; lemmaBeta: string;
  count: number; glosses: string[];
  byWork: { work: string; title: string; count: number }[];
  instancesByWork: unknown[];
  truncated: boolean;
  bonitz: null;
  distinctiveness?: Distinctiveness;
}
const data: LemmaData = JSON.parse(
  readFileSync(`public/data/lemmata/${slug}.json`, 'utf-8'),
);

// The LSJ entry is served by grammata's T8 lookup at runtime (John,
// 2026-09-03: "replace those lsj entries on index with the lsj t8 from
// grammata"), the same widget the reading pages' popup mounts. Until then this
// page rendered the local shards through shared/lib/html.ts at build time, and
// three classes of forms-block defect (HANDOFF-LSJ.md §5) lived only here. The
// desktop app is offline-first and still renders the local shards. The LSJ key
// is the same beta-code key the concordance attributed the lemma to.

const nearby = nearbyFor(slug);
const ostwald = ostwaldFor(slug);

// ── SEO ─────────────────────────────────────────────────────────────────────
const gloss = data.glosses[0] ?? '';
const pageTitle = `${data.head} (${data.slug}) — Aristotle's Greek Lexicon: ${gloss || 'definition & occurrences'}`;
const metaDescription =
  `${data.head} in Aristotle${gloss ? ` — "${gloss}"` : ''}. Appears ${data.count}` +
  ` times across the corpus (${data.byWork.slice(0, 3).map((b) => b.title).join(', ')}…),` +
  ` with the LSJ definition, frequency by work, and every occurrence linked to the` +
  ` parallel Greek–English text with Bekker citation.`;
const canonical = Astro.site
  ? new URL(`${base}/lemma/${data.slug}/`, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const definedTerm = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: data.head,
  ...(gloss ? { description: gloss } : {}),
  inLanguage: 'grc',
  ...(canonical ? { url: canonical } : {}),
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: "Lexicon of Aristotle's Greek",
    url: Astro.site ? new URL(`${base}/lemma/`, Astro.site).href : undefined,
  },
};
const breadcrumb = Astro.site ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Aristotle', item: new URL(`${base}/`, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Greek Lexicon', item: new URL(`${base}/lemma/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.head, item: canonical },
  ],
} : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Aristotle Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(definedTerm)} />
  {breadcrumb && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumb)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-lexicon">
    <BNav active="/lemma/" />
    <main>
      <section class="b-lx">
        <h1 class="b-wp" lang="grc" data-fit="word" data-title={data.head} data-fmax="150">{data.head}</h1>
        {data.glosses.length > 0 && <div class="b-lx-h"><p class="b-lx-gl">{data.glosses.join('; ')}</p></div>}
        <dl class="b-lx-n">
          <div><dt>in Aristotle</dt><dd>{data.count.toLocaleString()}</dd></div>
          {data.distinctiveness && <>
            <div><dt>in authors before him</dt><dd>{data.distinctiveness.before_aristotle.toLocaleString()}</dd></div>
            <div><dt>in his contemporaries</dt><dd>{data.distinctiveness.contemporary.toLocaleString()}</dd></div>
          </>}
          <div><dt>works</dt><dd>{data.byWork.length}</dd></div>
        </dl>
      </section>
      <section class="b-sec">
        <h2 class="b-h2">By work</h2>
        <ol class="b-bw">{data.byWork.map(w => <li data-work={w.work}>
          <a href={lemmaWorkHref(base, data.key, w.work)}><span>{w.title}</span><b>{w.count}</b></a>
        </li>)}</ol>
      </section>
      <section class="b-sec b-two">
        <div><h2 class="b-h2">LSJ</h2><div class="grammata-mount" data-key={data.key} lang="grc"></div></div>
        <div>
          {ostwald.length > 0 && <>
            <h2 class="b-h2">Ostwald</h2>
            {ostwald.map(entry => <div class="b-ostwald" data-glossary={entry.slug}>
              <p set:html={sanitizeHtml(entry.bodyHtml)} />
              <p class="b-cite"><a href={`${base}/EN/glossary/#${entry.slug}`}>Martin Ostwald, <i>Nicomachean Ethics</i>, Bobbs-Merrill, 1962, Glossary of Technical Terms</a></p>
            </div>)}
          </>}
          <h2 class="b-h2">Nearby</h2>
          <p class="b-near">{nearby.map(e => <a href={`${base}/lemma/${e.slug}/`} lang="grc" class:list={{on: e.slug === slug}} aria-current={e.slug === slug ? 'page' : undefined}>{e.head}</a>)}</p>
        </div>
      </section>
    </main>
    <BFoot />
  </div>
<script>
  const head = document.querySelector<HTMLElement>('[data-fit="word"]');
  const canvas = document.createElement('canvas').getContext('2d');
  if (head && canvas) {
    document.fonts.load('400 100px "Gentium Book Plus"').then(() => {
      canvas.font = '400 100px "Gentium Book Plus"';
      const width = canvas.measureText(head.dataset.title ?? '').width;
      const fit = () => {
        const W = head.clientWidth;
        if (!W || !width) return;
        head.style.fontSize = `${Math.max(24, Math.min(W < 500 ? 80 : Number(head.dataset.fmax), W / width * 100 * .98)).toFixed(1)}px`;
        head.dataset.fitted = 'true';
      };
      fit();
      new ResizeObserver(fit).observe(head);
    });
  }
</script>
<script>
  // Served by grammata (grammar-site's deploy), not rendered here — the same
  // contract as shared/components/WordPopup.svelte: do not vendor, proxy, pin
  // or cache-bust this URL (its deploys ARE the update mechanism) and do not
  // style anything inside the container. With a key the word argument is
  // ignored; lang:'grc' skips the Latin fetch.
  // PUBLIC_GRAMMATA_LOOKUP names another address at BUILD time, as there.
  const GRAMMATA_LOOKUP: string =
    import.meta.env.PUBLIC_GRAMMATA_LOOKUP || 'https://grammata.pages.dev/t8/lookup.js';
  const mount = document.querySelector<HTMLElement>('.grammata-mount');
  const key = mount?.dataset.key;
  if (mount && key) {
    // @vite-ignore keeps the remote specifier out of the bundle graph.
    import(/* @vite-ignore */ GRAMMATA_LOOKUP)
      .then((m) => m.lookup('', mount, { lang: 'grc', key }))
      .catch((e) => {
        // A failed module load is the one case the widget cannot report itself.
        mount.textContent = 'Lookup failed';
        console.error('[grammata] lookup failed', e);
      });
  }
</script>
</body>
</html>
