---
// The reader page body, shared by the two routes:
//   /<work>/book/<n>  (multi-book works)   — src/pages/[work]/book/[n].astro
//   /<work>           (single-book works)   — src/pages/[work]/index.astro
// `bookless` works (Categories, Poetics) are a single treatise of chapters with
// no book level, so all book-level chrome (the "· Book N" title, the book nav
// row, the per-book TOC grouping) is dropped.
import { readFileSync } from 'node:fs';
import Reader from '@shared/components/Reader.svelte';
import BekkerJump from '@shared/components/BekkerJump.svelte';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import HelpButton from './HelpButton.svelte';
import BFonts from './BFonts.astro';
import ThemeInit from './ThemeInit.astro';
import Pwa from './Pwa.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getWork, bookLabel, isBookless, workPath, workLanding, visibleTranslations } from '@shared/lib/works';
import { isChapterSection, isNonBekker } from '@shared/lib/data';
import { jsonLdSafe } from '../lib/jsonld';
import { chapterHref as chapterHrefFor, translatorName as translatorPerson } from '../lib/nav';
import { shareCard } from '../lib/og';

interface Props { workId: string; n: number; }
const { workId, n } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const work = getWork(workId)!;
// Authorship is per-work, not always Aristotle — the Isagoge is Porphyry's.
// Derive every author-facing string (title-page prose, JSON-LD, <h1>, intro)
// from work.author so non-Aristotle works aren't mislabelled to crawlers and
// screen readers.
const author = work.author;
const bookless = isBookless(work);
// Non-Bekker works (the Isagoge's Busse pages, the Athenian Constitution's
// chapter.section) have no Bekker lines, so the "Go to Bekker line" jump doesn't
// apply, nor does a chapter's Bekker span. A chapter-section work's span is its
// chapter number, which the outline already prints.
const nonBekker = isNonBekker(work);
const chapterSection = isChapterSection(work);
const label = bookLabel(work, n);

interface ChapterRef { chapter: string; column: string; line: string; bekker: string; }
const allChapters: Record<string, ChapterRef[]> = JSON.parse(
  readFileSync(`public/data/${workId}/chapters.json`, 'utf-8'),
);
const chapters = allChapters[String(n)] ?? [];

// The book's reading data, read at build time and handed to the Reader island so
// the Greek + English text is server-rendered into the static HTML (crawlable +
// instant paint) instead of fetched client-side. Same shape fetchBook returns.
const bookData = JSON.parse(
  readFileSync(`public/data/${workId}/book-${String(n).padStart(2, '0')}.json`, 'utf-8'),
);

// Optional one-line chapter titles/descriptions for the outline sidebar, keyed
// {book: {chapter: "…"}}. The file is written by hand/curation per work and may
// not exist yet — the outline degrades to chapter number + Bekker range.
let chapterTitles: Record<string, Record<string, string>> = {};
try {
  chapterTitles = JSON.parse(
    readFileSync(`public/data/${workId}/chapter-titles.json`, 'utf-8'),
  );
} catch { /* no titles yet */ }

// A translation's own chapter titles, {transId: {book: {chapter: title}}} —
// Ostwald heads each chapter of the Ethics himself. Written by the pipeline;
// absent for every work whose translations carry none.
let transTitles: Record<string, Record<string, Record<string, string>>> = {};
try {
  transTitles = JSON.parse(
    readFileSync(`public/data/${workId}/third-titles.json`, 'utf-8'),
  );
} catch { /* this work's translations head no chapters */ }
const bookTransTitles = Object.fromEntries(
  Object.entries(transTitles).map(([id, byBook]) => [id, byBook[String(n)] ?? {}]),
);

// The full-work outline for the sidebar: every book, its chapters in order.
const outline = Array.from({ length: work.books }, (_, i) => {
  const b = i + 1;
  return { book: b, label: bookLabel(work, b), chapters: allChapters[String(b)] ?? [] };
});
const chapterHref = (b: number, chapter: string) => chapterHrefFor(base, workId, n, b, chapter);
// The translations on offer and the one that opens first (the picker's label).
const editions = visibleTranslations(work);
const primaryEdition = editions.find((t) => t.id === work.defaultTranslation)
  ?? editions.find((t) => t.slot === 'english') ?? editions[0];
// The head's short work name, for a row too narrow for the full one.
const shortName = work.abbr;
// A chapter's title in the contents: the work's own, else the opening
// translation's (Ostwald titles his chapters), else its Bekker span.
const noMarks = (s: string) => s.replace(/\[\^[^\]]*\]/g, '').trim();
const tocTitle = (book: number, c: ChapterRef) => noMarks(
  chapterTitles[String(book)]?.[c.chapter]
  || transTitles[primaryEdition?.id ?? '']?.[String(book)]?.[c.chapter]
  || (nonBekker ? '' : c.bekker));
// The visible tab title + og:title. Front-loads the work name (what people
// search) and appends the parallel-text long-tail phrasing ("greek english
// translation") that these deep book pages can realistically rank for, since
// they can't win the bare head term against Wikipedia/SEP on a github.io path.
const pageTitle = bookless
  ? `${work.title} — Greek Text & English Translation`
  : `${work.title}, Book ${label} — Greek Text & English Translation`;

// ── SEO: server-rendered signals ───────────────────────────────────────────
// The reading text is now server-rendered (bookData is read at build above and
// handed to the Reader island, so the Greek/English lines are in the static
// HTML, not a "Loading…" placeholder). These tags supply the rest of what
// crawlers want: a canonical URL, a real description, a Schema.org Book record,
// a semantic <h1>, and a topical intro paragraph.
const bookSuffix = bookless ? '' : `, Book ${label}`;
const primaryTrans =
  work.translations.find((t) => t.slot === 'english') ?? work.translations[0];
// Translator entries read "Name (Publisher, Year)"; keep just the person name.
const translatorName = translatorPerson(primaryTrans?.name);
const canonical = Astro.site
  ? new URL(`${base}${workPath(workId, n)}/`, Astro.site).href
  : undefined;
// Social share card: the work's own (public/og/<Work>.jpg, from scripts/make-og-cards.mjs),
// else the site's. Crawlers require an absolute URL, so it's built off Astro.site + base.
const ogCard = shareCard(workId);
const ogImage = Astro.site
  ? new URL(`${base}/${ogCard}`, Astro.site).href
  : undefined;
const metaDescription =
  `Read ${author}'s ${work.title}${bookSuffix} — the original Greek` +
  ` (${work.greekSource.short}) side by side with` +
  (translatorName ? ` ${translatorName}'s` : ' an') +
  ` English translation, with click-to-parse morphology, dictionary entries,` +
  (chapterSection ? ` and chapter and section citation.` : ` and Bekker citation.`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: `${work.title}${bookSuffix}`,
  ...(work.greekTitle ? { alternateName: work.greekTitle } : {}),
  author: { '@type': 'Person', name: author },
  ...(translatorName
    ? { translator: { '@type': 'Person', name: translatorName } }
    : {}),
  inLanguage: ['grc', 'en'],
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'CreativeWorkSeries', name: 'The Works of Aristotle' },
  description: metaDescription,
};
// Breadcrumb trail (Home › Work › Book N) — gives Google the page's place in the
// hierarchy and can render as a breadcrumb rich result in the SERP. Absolute
// URLs required, so emitted only when Astro.site is set.
const breadcrumbLd = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Aristotle',
          item: new URL(`${base}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: work.title,
          item: new URL(`${base}${workLanding(workId)}/`, Astro.site).href },
        ...(bookless
          ? []
          : [{ '@type': 'ListItem', position: 3, name: `Book ${label}`,
              item: new URL(`${base}${workPath(workId, n)}/`, Astro.site).href }]),
      ],
    }
  : null;
// A short topical paragraph (the curated one-line blurb, framed with the Greek
// source and translator) so the page carries real descriptive prose for search
// snippets and screen readers, distinct from the dense parallel-text body.
const intro =
  `${work.title}${bookSuffix} by ${author}, in the original Greek` +
  (translatorName ? `, with the English translation of ${translatorName}` : '') +
  `. ${work.blurb}`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="tlPYj47QxxAGIB0RGMjr2fycUYsaqZK-yeOj9SmIjE4" />
  <ThemeInit />
  <Pwa />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Aristotle Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumbLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <BFonts />
  <!-- Display faces used only by the print masthead; media="print" defers the
       fetch so it never costs the on-screen reader. -->
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@1,600&family=DM+Mono:wght@400&display=swap" rel="stylesheet" media="print" />
</head>
<body data-work={workId} data-book={n} data-books={work.books} data-base={base}>
<div class="frame dir-b pg-reader">
<div class="b-rd">
  <!-- Bypass blocks (WCAG 2.4.1): visible only while focused, the first stop
       on the page; it targets the anchor just above the Reader island. -->
  <a class="skip-to-text" href="#reading-text">Skip to the text</a>
  <!-- A topical intro for search engines and screen readers; the visible
       heading is the book head the reader draws. -->
  <p class="sr-only">{intro}</p>
  <header class="b-rh">
    <button type="button" class="b-ib" data-toc-toggle aria-label="Contents" aria-expanded="false" aria-controls="toc-sidebar"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.4"/></svg></button>
    <a class="b-rh-w" href={`${base}${workLanding(workId)}`}><span class="full">{work.title}</span><span class="short">{shortName}</span></a>
    {!bookless && (
      <details class="b-bkm">
        <summary class="b-rh-b">Book {label} <svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></summary>
        <div class="b-menu">
          <ul class="b-bm">
            {outline.map((b) => (
              <>
                <li><a href={`${base}${workPath(workId, b.book)}`} aria-current={b.book === n ? 'page' : undefined}><span>Book {b.label}</span><small>{b.chapters.length} chapter{b.chapters.length === 1 ? '' : 's'}</small></a></li>
                {work.missingBooks && work.missingBooks.after === b.book && (
                  <li><a class="b-bm-gap" href={`${base}${workPath(work.missingBooks.linkWork, work.missingBooks.linkBook)}`}>Books {work.missingBooks.label} → {work.missingBooks.linkLabel}</a></li>
                )}
              </>
            ))}
          </ul>
        </div>
      </details>
    )}
    <span class="b-rh-ch" data-reader-context><span data-ctx-n>{chapters[0] ? `Chapter ${chapters[0].chapter}` : ''}</span></span>
    <span class="b-sp"></span>
    <span class="b-seg hide-s" role="group" aria-label="Reading view">
      {['greek', 'both', 'english'].map((v) => <button type="button" data-reader-view={v} aria-pressed={v === 'both' ? 'true' : 'false'}>{v[0].toUpperCase() + v.slice(1)}</button>)}
    </span>
    {editions.length > 1 && (
      <button type="button" class="b-rh-b hide-s" data-reader-picker aria-expanded="false" aria-haspopup="true"><span data-label>{primaryEdition?.short}</span> <svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button>
    )}
    <button type="button" class="b-phone-view" data-view-toggle aria-label="Reading view" aria-expanded="false" aria-controls="phone-view-menu"><span data-view-label>Both</span><svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button>
    <div class="b-menu b-view-menu" id="phone-view-menu" role="group" aria-label="Reading view" hidden>
      {['greek', 'both', 'english'].map((v) => <button type="button" data-reader-view={v} aria-pressed={v === 'both' ? 'true' : 'false'}>{v[0].toUpperCase() + v.slice(1)}</button>)}
    </div>
    <a class="b-ib" href={`${base}/search`} aria-label="Search"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.8" cy="6.8" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.4"/></svg></a>
    <button type="button" class="b-ib b-aab" data-aa aria-label="Text and view settings" aria-expanded="false">Aa</button>
    <ThemeToggle bMoon />
  </header>

  <!-- Closed, the drawer is hidden and inert, so none of its links is a tab
       stop; setToc() below opens it. -->
  <aside class="b-toc" id="toc-sidebar" aria-label={`${work.title}: contents`} hidden inert>
    <div class="b-toc-h"><a href={`${base}/`}>All works</a><a class="b-toc-search" href={`${base}/search`}>Search</a><button type="button" class="b-x" data-toc-close aria-label="Close contents"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.4"/></svg></button></div>
    <p class="b-toc-w">{work.title}</p>
    {!nonBekker && <div class="b-toc-go"><BekkerJump work={workId} inputId="bekker-input-toc" alwaysOpen client:load /></div>}
    <nav class="toc-outline" aria-label="Books and chapters">
      {bookless ? (
        <ol class="b-toc-c">{outline[0].chapters.map((c) => <li><a href={chapterHref(1, c.chapter)} data-ch={`ch-1-${c.chapter}`}><span>{c.chapter}</span><span>{tocTitle(1, c)}</span></a></li>)}</ol>
      ) : outline.map((b) => (
        <>
          <details class="b-toc-b" open={b.book === n}>
            <summary class="b-toc-bh"><span class="toc-book-label">Book {b.label}</span><small>{b.chapters.length} chapter{b.chapters.length === 1 ? '' : 's'}</small></summary>
            <ol class="b-toc-c">{b.chapters.map((c) => <li><a href={chapterHref(b.book, c.chapter)} data-ch={`ch-${b.book}-${c.chapter}`}><span>{c.chapter}</span><span>{tocTitle(b.book, c)}</span></a></li>)}</ol>
          </details>
          {work.missingBooks && work.missingBooks.after === b.book && (
            <p class="b-toc-gap"><a href={`${base}${workPath(work.missingBooks.linkWork, work.missingBooks.linkBook)}`}>Books {work.missingBooks.label} → {work.missingBooks.linkLabel}</a></p>
          )}
        </>
      ))}
    </nav>
    <p class="b-toc-links"><a href={`${base}/lemma/`}>Lexicon</a><a href={`${base}/attribution`}>Texts &amp; licences</a><a href={`${base}/support`}>Support</a><button type="button" data-reader-help>Help</button></p>
  </aside>

  <HelpButton client:load />
  <CommandPalette work={workId} client:load />
  <!-- The skip link's target. The Reader island owns .reader-body (role=main)
       and is a shared component, so the anchor sits just outside it. -->
  <span id="reading-text" tabindex="-1"></span>
  <Reader work={workId} bookNum={n} bookData={bookData} chapterTitles={chapterTitles[String(n)] ?? {}} transTitles={bookTransTitles} b client:load />
</div>
</div>

<script>
  // Contents drawer, the Book menu, Help, and the head's one-row fit. The
  // reader island owns the view, translation and Aa state (Reader.svelte).
  const head = document.querySelector<HTMLElement>('.b-rh')!;
  const toc = document.getElementById('toc-sidebar') as HTMLElement;
  const tocToggle = head.querySelector<HTMLElement>("[data-toc-toggle]")!;
  const bookMenu = head.querySelector<HTMLDetailsElement>('.b-bkm');
  const viewToggle = head.querySelector<HTMLButtonElement>('[data-view-toggle]')!;
  const viewMenu = head.querySelector<HTMLElement>('#phone-view-menu')!;
  // Focus returns to the toggle only when the menu itself closed it (a choice,
  // Escape); a tap elsewhere keeps focus where the tap put it.
  const setViewMenu = (open: boolean, refocus = true) => {
    viewMenu.hidden = !open;
    viewToggle.setAttribute('aria-expanded', String(open));
    if (open) viewMenu.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus();
    else if (refocus) viewToggle.focus();
  };
  viewToggle.addEventListener('click', () => setViewMenu(viewMenu.hidden));
  window.matchMedia('(max-width: 700px)').addEventListener('change', () => {
    if (!viewMenu.hidden) setViewMenu(false, false);
  });
  viewMenu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-reader-view]')) setViewMenu(false);
  });
  const setToc = (open: boolean) => {
    toc.hidden = !open;
    toc.inert = !open;
    tocToggle.setAttribute('aria-expanded', String(open));
    if (open) toc.querySelector<HTMLElement>('a, button')?.focus();
  };
  tocToggle.addEventListener('click', () => setToc(toc.hidden));
  toc.querySelector("[data-toc-close]")?.addEventListener('click', () => { setToc(false); tocToggle.focus(); });
  // A chapter of this book is a #hash link: it scrolls, so the drawer closes.
  toc.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', () => setToc(false)));
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!viewMenu.hidden && !viewMenu.contains(t) && !viewToggle.contains(t)) setViewMenu(false, false);
    if (!toc.hidden && !toc.contains(t) && !tocToggle.contains(t)) setToc(false);
    if (bookMenu?.open && !bookMenu.contains(t)) bookMenu.open = false;
  });
  bookMenu?.addEventListener('toggle', () => {
    if (!bookMenu.open) return;
    const r = bookMenu.querySelector('summary')!.getBoundingClientRect();
    bookMenu.style.setProperty('--bkm-left', `${Math.max(12, Math.round(r.left))}px`);
  });
  head.querySelector("[data-aa]")!.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-settings'));
  });
  document.querySelectorAll('[data-reader-help]').forEach((b) => b.addEventListener('click', () => {
    setToc(false);
    window.dispatchEvent(new CustomEvent('open-help'));
  }));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      // preventDefault marks the key as spent: the word panel stays open.
      if (!viewMenu.hidden) { e.preventDefault(); setViewMenu(false); return; }
      if (!toc.hidden) { e.preventDefault(); setToc(false); tocToggle.focus(); return; }
      if (bookMenu?.open) { e.preventDefault(); bookMenu.open = false; bookMenu.querySelector('summary')?.focus(); return; }
      window.dispatchEvent(new CustomEvent('close-settings'));
      return;
    }
    // [ / ] step to the previous/next book. Ignored while typing or with
    // modifiers held (bracket characters occur in search/palette inputs).
    if (e.key !== '[' && e.key !== ']') return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    const cur = Number(document.body.dataset.book);
    const max = Number(document.body.dataset.books);
    const next = e.key === ']' ? cur + 1 : cur - 1;
    if (!Number.isFinite(next) || next < 1 || next > max) return;
    window.location.href = `${document.body.dataset.base}/${document.body.dataset.work}/book/${next}`;
  });

  // Keep one row: cut the long work name, then the chapter, until it fits.
  const CUTS = ['cut-name', 'cut-ch'];
  // The row overflows when its last item passes the head's right padding
  // (scrollWidth misses items that only eat into the padding).
  const overflows = () => {
    const end = head.getBoundingClientRect().right - parseFloat(getComputedStyle(head).paddingRight);
    return [...head.children].some((c) => !c.classList.contains('b-menu') && c.getBoundingClientRect().right > end + 0.5);
  };
  const fit = () => {
    head.classList.remove(...CUTS);
    for (const cut of CUTS) {
      if (!overflows()) break;
      head.classList.add(cut);
    }
  };
  // Round 7 C: hide only in the sideways band, with menus keeping the bar shown.
  const sideways = window.matchMedia('(min-width: 701px) and (max-width: 960px) and (max-height: 500px)');
  let lastY = window.scrollY;
  let downFrom = lastY;
  const menusOpen = () => !toc.hidden || !!head.querySelector('details[open], [aria-expanded="true"]');
  const setAway = (away: boolean) => {
    const next = away && sideways.matches && !menusOpen();
    if (head.classList.contains('b-rh-away') === next) return;
    head.classList.toggle('b-rh-away', next);
    window.dispatchEvent(new CustomEvent('reader-head-visibility'));
  };
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y < lastY || y <= 0) { setAway(false); downFrom = y; }
    else if (y - downFrom > 8) setAway(true);
    if (menusOpen()) { setAway(false); downFrom = y; }
    lastY = y;
  }, { passive: true });
  document.addEventListener('pointerdown', (e) => {
    if (e.clientY <= 44) { setAway(false); downFrom = window.scrollY; }
  }, { passive: true });
  head.addEventListener('focusin', () => { setAway(false); downFrom = window.scrollY; });
  const keepShown = () => { if (menusOpen()) setAway(false); };
  new MutationObserver(keepShown).observe(head, { subtree: true, attributes: true, attributeFilter: ['open', 'aria-expanded'] });
  new MutationObserver(keepShown).observe(toc, { attributes: true, attributeFilter: ['hidden'] });
  sideways.addEventListener('change', () => { setAway(false); downFrom = lastY = window.scrollY; });
  fit();
  new ResizeObserver(fit).observe(head);
  window.addEventListener('reader-head-fit', fit);
  document.fonts?.ready.then(fit);
</script>
</body>
</html>
