---
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import BFonts from '../components/BFonts.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
import { shareCard } from '../lib/og';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Page Not Found — Aristotle Reader';
const metaDescription =
  "The requested Aristotle Reader page could not be found. Return to the corpus or search Aristotle's Greek and English texts.";
const canonical = Astro.site ? new URL(`${base}/404/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/${shareCard()}`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Aristotle Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="noindex,follow" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-404"><div class="b-page">
  <BNav active="" />
  <main class="nf">
    <figure class="nf-fig">
      <picture class="th-light"><img src={`${base}/plates/desk/404.jpg`} width="1280" height="914" alt="An engraved goat-stag: a bearded goat with a deer’s body and branching horns, labelled Tragelaphus." loading="lazy" decoding="async" /></picture>
      <picture class="th-dark"><img src={`${base}/plates/dark/desk/404.webp`} width="1280" height="914" alt="An engraved goat-stag: a bearded goat with a deer’s body and branching horns, labelled Tragelaphus." loading="lazy" decoding="async" /></picture>
      <figcaption><span lang="grc">τραγέλαφος</span> · the goat-stag</figcaption>
    </figure>
    <h1 class="nf-h">Page not found</h1>
    <p class="nf-p">The <em>goat-stag</em> is Aristotle’s example of a name that signifies something which does not exist (<em>De Interpretatione</em> 16a16). So, it would seem, is the page you’re looking for.</p>
    <div class="b-ctas nf-b">
      <a class="b-btn pri" href={`${base}/`}>Back to the corpus</a>
      <a class="b-btn" href={`${base}/search`}>Search</a>
    </div>
  </main>
  <BFoot />
  </div></div>
</body>
</html>
