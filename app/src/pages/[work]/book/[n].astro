---
import { readFileSync } from 'node:fs';
import Reader from '../../../components/Reader.svelte';
import BekkerJump from '../../../components/BekkerJump.svelte';
import WorkSwitcher from '../../../components/WorkSwitcher.svelte';
import { WORKS, getWork, bookLabel } from '../../../lib/works';
import '../../../styles/global.css';

export function getStaticPaths() {
  return WORKS.flatMap((w) =>
    Array.from({ length: w.books }, (_, i) => ({
      params: { work: w.id, n: String(i + 1) },
    })),
  );
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const workId = Astro.params.work!;
const work = getWork(workId)!;
const n = Number(Astro.params.n);
const label = bookLabel(work, n);

interface ChapterRef { chapter: string; column: string; line: string; bekker: string; }
const allChapters: Record<string, ChapterRef[]> = JSON.parse(
  readFileSync(`public/data/${workId}/chapters.json`, 'utf-8'),
);
const chapters = allChapters[String(n)] ?? [];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{work.title} · Book {label}</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="page-header">
    <div class="header-bar">
      <div class="header-title">
        <a class="home-link" href={`${base}/`} title="All works" aria-label="All works">Aristotle</a>
        <span class="title-sep">›</span>
        <WorkSwitcher work={workId} client:load />
      </div>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel">
        <span class="nav-toggle-icon" aria-hidden="true">☰</span><span class="nav-toggle-text">Menu</span>
      </button>
    </div>
    <div class="nav-panel" id="nav-panel">
      <BekkerJump work={workId} client:load />
      <nav class="book-nav" aria-label="Navigation">
        {Array.from({ length: work.books }, (_, i) => (
          <a
            href={`${base}/${workId}/book/${i + 1}`}
            class={i + 1 === n ? 'current' : ''}
            aria-current={i + 1 === n ? 'page' : undefined}
          >
            {bookLabel(work, i + 1)}
          </a>
        ))}
        <a href={`${base}/search`} class="search-link">Search</a>
        <a href={`${base}/attribution`} class="search-link">Texts &amp; Licences</a>
      </nav>
      {chapters.length > 0 && (
        <nav class="chapter-nav" aria-label={`Book ${label} chapters`}>
          <span class="chapter-nav-label">Book {label} · Chapters</span>
          {chapters.map((c) => (
            <a href={`#ch-${n}-${c.chapter}`} title={`Chapter ${c.chapter} · ${c.bekker}`}>{c.chapter}</a>
          ))}
        </nav>
      )}
    </div>
  </header>

  <script>
    // Mobile only: the menu button shows/hides the nav panel. On desktop the
    // panel is always visible (CSS), so the button is hidden and this is inert.
    const header = document.querySelector('.page-header');
    const toggle = header?.querySelector('.nav-toggle');
    toggle?.addEventListener('click', () => {
      const open = header!.classList.toggle('nav-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  </script>

  <Reader work={workId} bookNum={n} client:load />
</body>
</html>
