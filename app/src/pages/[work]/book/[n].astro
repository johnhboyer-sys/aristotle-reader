---
// Multi-book works route at /<work>/book/<n>. Single-book works are bookless
// and route at /<work> (src/pages/[work]/index.astro) — they are excluded here
// so /Cat/book/1 and /Poet/book/1 are never generated.
import ReaderShell from '../../../components/ReaderShell.astro';
import { WORKS, isBookless } from '../../../lib/works';
import '../../../styles/global.css';

export function getStaticPaths() {
  return WORKS.filter((w) => !isBookless(w)).flatMap((w) =>
    Array.from({ length: w.books }, (_, i) => ({
      params: { work: w.id, n: String(i + 1) },
    })),
  );
}

const workId = Astro.params.work!;
const n = Number(Astro.params.n);
---
<ReaderShell workId={workId} n={n} />
