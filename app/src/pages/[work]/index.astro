---
// Single-book (bookless) works route directly at /<work> — a single treatise of
// chapters with no book level (Categories, Poetics). Multi-book works are served
// by src/pages/[work]/book/[n].astro instead.
import ReaderShell from '../../components/ReaderShell.astro';
import { WORKS, isBookless } from '../../lib/works';
import '../../styles/global.css';

export function getStaticPaths() {
  return WORKS.filter((w) => isBookless(w)).map((w) => ({ params: { work: w.id } }));
}

const workId = Astro.params.work!;
---
<ReaderShell workId={workId} n={1} />
