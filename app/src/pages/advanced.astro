---
import { readFileSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import BFonts from '../components/BFonts.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import { jsonLdSafe } from '../lib/jsonld';
import { WORKS, AUTHENTIC_IDS, searchableTranslations } from '@shared/lib/works';
import { greekNumeral } from '@shared/lib/numerals';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
import '@shared/styles/b-guide.css';
import { shareCard } from '../lib/og';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The contents column, numbered like the section heads it lists. The search
// page links to #combo, #variants, and the bare page; the phrase index to
// #phrases. Keep those ids.
const TOC = [
  { id: 'typing', title: 'Typing Greek', gist: 'Beta Code and the keyboard' },
  { id: 'wildcards', title: 'Wildcards', gist: 'find a word you only partly know' },
  { id: 'lemma', title: 'Lemma', gist: 'every form of one dictionary word' },
  { id: 'variants', title: 'Word endings', gist: 'one phrase, all its forms' },
  { id: 'english', title: 'English searches', gist: 'any form, and every translation' },
  { id: 'grammatical', title: 'Search by grammar', gist: 'find forms, not spellings' },
  { id: 'combo', title: 'Proximity', gist: 'two ideas in one passage' },
  { id: 'results', title: 'Reading the results', gist: 'group, sort, and narrow' },
  { id: 'phrases', title: 'The phrase index', gist: 'what Aristotle repeats' },
  { id: 'honesty', title: 'What these tools cannot tell you', gist: '' },
];
const num = (id: string) => greekNumeral(TOC.findIndex((t) => t.id === id) + 1);

// Beta Code, as the search box reads it (shared/lib/betacode.ts).
const BETA_LETTERS: [string, string][] = [
  ['a', 'α'], ['b', 'β'], ['g', 'γ'], ['d', 'δ'], ['e', 'ε'], ['z', 'ζ'],
  ['h', 'η'], ['q', 'θ'], ['i', 'ι'], ['k', 'κ'], ['l', 'λ'], ['m', 'μ'],
  ['n', 'ν'], ['c', 'ξ'], ['o', 'ο'], ['p', 'π'], ['r', 'ρ'], ['s', 'σ ς'],
  ['t', 'τ'], ['u', 'υ'], ['f', 'φ'], ['x', 'χ'], ['y', 'ψ'], ['w', 'ω'],
];
const BETA_MARKS: [string, string, string][] = [
  [')', 'ἀ', 'smooth breathing'], ['(', 'ἁ', 'rough breathing'],
  ['/', 'ά', 'acute'], ['\\', 'ὰ', 'grave'], ['=', 'ᾶ', 'circumflex'],
  ['|', 'ᾳ', 'iota subscript'], ['+', 'ϊ', 'diaeresis'],
];

// ── Every number on this page, counted off the built corpus ───────────────
//
// None is typed in. They are read from the files this site serves, so a
// rebuild corrects them; a figure the files cannot give renders as TKTK
// rather than as a plausible guess. The build and the dev server both run
// with the app directory as the working directory.
const dataRoot = resolve(process.cwd(), 'public/data');
const TKTK = 'TKTK';
const nf = new Intl.NumberFormat('en-US');
const scoreFmt = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });

function readJson<T>(rel: string): T | null {
  try { return JSON.parse(readFileSync(resolve(dataRoot, rel), 'utf8')) as T; } catch { return null; }
}
function readBytes(rel: string): Buffer | null {
  try { return readFileSync(resolve(dataRoot, rel)); } catch { return null; }
}
const n = (v: number | null | undefined) =>
  typeof v === 'number' && Number.isFinite(v) ? nf.format(v) : TKTK;
const score = (v: number | undefined) =>
  typeof v === 'number' && Number.isFinite(v) ? scoreFmt.format(v) : TKTK;

interface Offsets {
  token_count: number;
  chapter_bounds?: { book: number; chapter: string; start: number; accuracy: string }[];
}
interface Summary {
  works: number;
  streams: Record<string, { kept: number }>;
  surface_forms: number;
  surface_forms_ambiguous: number;
}
type Reading = Record<string, string[]>;
interface GrammarDict { width: number; sigs: Reading[][] }
type NgramRow = [number, number, number, number, number?];
type Index = Record<string, unknown>;

const workIds = WORKS.map((w) => w.id).filter((id) => readJson<Offsets>(`${id}/search/offsets.json`) !== null);
const offsets = new Map(workIds.map((id) => [id, readJson<Offsets>(`${id}/search/offsets.json`)!]));
const summary = readJson<Summary>('ngrams/summary.json');
const tokens = workIds.length ? workIds.reduce((sum, id) => sum + (offsets.get(id)?.token_count ?? 0), 0) : null;

// Who wrote what, from the registry the In menu reads.
const works = {
  all: WORKS.length,
  authentic: AUTHENTIC_IDS.length,
  dubious: WORKS.filter((w) => w.authenticity === 'dubious').length,
  spurious: WORKS.filter((w) => w.authenticity === 'spurious').length,
  others: WORKS.filter((w) => w.author !== 'Aristotle').map((w) => `${w.author}'s ${w.title}`),
};

// Distinct spellings, corpus-wide and in one work: what a wildcard reaches
// with Form set to "Only as I typed it".
const formKeys = new Set<string>();
for (const id of workIds) {
  for (const key of Object.keys(readJson<Index>(`${id}/search/greek_form.json`) ?? {})) formKeys.add(key);
}
const ethicsKeys = Object.keys(readJson<Index>('EN/search/greek_form.json') ?? {});
const withPrefix = (keys: Iterable<string>, prefix: string) => {
  let count = 0;
  for (const key of keys) if (key.startsWith(prefix)) count++;
  return count;
};
const wildcard = formKeys.size
  ? {
      distinct: formKeys.size,
      l: withPrefix(formKeys, 'l'),
      fron: withPrefix(formKeys, 'fron'),
      ethicsL: ethicsKeys.length ? withPrefix(ethicsKeys, 'l') : null,
      // l*s as the search reads it: matched over the whole key.
      lS: [...formKeys].filter((key) => /^l[a-z']*s$/.test(key)).length,
    }
  : null;

// English "any form", over the index of each work's main translation: each
// posting is one occurrence of the word.
const englishCount = (words: string[]) => {
  if (!workIds.length) return null;
  let total = 0;
  for (const id of workIds) {
    const idx = readJson<Record<string, unknown[]>>(`${id}/search/english.json`);
    if (!idx) return null;
    for (const w of words) total += Object.hasOwn(idx, w) ? idx[w].length : 0;
  }
  return total;
};
const soul = { one: englishCount(['soul']), forms: englishCount(['souls', "soul's"]) };

// Works with more than one translation the search asks: only those the
// public registry lists, and only where the built index is there.
const indexFile = (slot: string, id: string) =>
  slot === 'overlay' ? `english-overlay-${id}` : slot === 'english' ? 'english' : `english-${slot}`;
const multiTranslated = WORKS.filter((w) =>
  searchableTranslations(w).filter((t) => readBytes(`${w.id}/search/${indexFile(t.slot, t.id)}.json`) !== null).length > 1,
).length;

// The dictionary words the Lemma list can offer: one per fold key.
let pickerKeys: number | null = null;
try {
  pickerKeys = readdirSync(resolve(dataRoot, 'lemma-picker'))
    .filter((f) => f.endsWith('.json'))
    .reduce((sum, f) => sum + Object.keys(readJson<Index>(`lemma-picker/${f}`) ?? {}).length, 0) || null;
} catch { pickerKeys = null; }

// Grammatical queries, counted over the packed column as the search runs
// them: how many words match, and how many of those the analysis settles.
// Each work's column is read once for all the queries.
const GRAMMAR_QUERIES = {
  genPlFem: { case: 'gen', number: 'pl', gender: 'fem' },
  optative: { mood: 'opt' },
  genDual: { case: 'gen', number: 'dual' },
} as const;
type GrammarKey = keyof typeof GRAMMAR_QUERIES;
const grammar = (() => {
  if (!workIds.length) return null;
  const out = Object.fromEntries(Object.keys(GRAMMAR_QUERIES).map((k) => [k, { total: 0, certain: 0 }])) as Record<GrammarKey, { total: number; certain: number }>;
  for (const id of workIds) {
    const dict = readJson<GrammarDict>(`${id}/search/grammar-dict.json`);
    const buffer = readBytes(`${id}/search/grammar-col.bin`);
    if (!dict || !buffer) return null;
    const column = dict.width === 4
      ? new Uint32Array(buffer.buffer, buffer.byteOffset, buffer.byteLength / 4)
      : new Uint16Array(buffer.buffer, buffer.byteOffset, buffer.byteLength / 2);
    for (const [key, query] of Object.entries(GRAMMAR_QUERIES) as [GrammarKey, Record<string, string>][]) {
      const satisfies = (r: Reading) => Object.entries(query).every(([c, v]) => r[c]?.includes(v));
      const matched = new Map<number, boolean>();
      dict.sigs.forEach((readings, sig) => {
        if (!readings.length || !readings.some(satisfies)) return;
        const settled = readings.every(satisfies)
          && Object.keys(query).every((c) => new Set(readings.flatMap((r) => r[c] ?? [])).size === 1);
        matched.set(sig, settled);
      });
      for (const sig of column) {
        const settled = matched.get(sig);
        if (settled === undefined) continue;
        out[key].total++;
        if (settled) out[key].certain++;
      }
    }
  }
  return out;
})();

// One phrase-index row, by its fold key; null when the index no longer keeps it.
function ngramRow(stream: 'form' | 'lemma' | 'english', key: string) {
  const shard = readJson<Record<string, NgramRow>>(`ngrams/${stream}/${key[0]}.json`);
  const row = shard?.[key];
  return row ? { words: row[0], count: row[1], score: row[2], works: row[3] } : null;
}
const essence = ngramRow('form', 'to ti hn einai');
const essenceLemma = ngramRow('lemma', 'o tis eimi eimi');
const mostly = ngramRow('form', 'ws epi to polu');
const mostlyLemma = ngramRow('lemma', 'ws epi o polus');
const accidentally = ngramRow('form', 'kata sumbebhkos');
const theFine = ngramRow('form', 'to kalon');
const theFineLemma = ngramRow('lemma', 'o kalos');

// Works whose chapter starts are known only to the Bekker line: the search
// says so when a match turns on a chapter break in them.
const roughChapters = workIds
  .filter((id) => offsets.get(id)?.chapter_bounds?.some((c) => c.accuracy !== 'exact' && c.start !== 0));
const list = (items: string[]) =>
  items.length < 3 ? items.join(' and ') : `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;

const corpus = {
  works: summary?.works ?? workIds.length,
  tokens,
  formPhrases: summary?.streams?.form?.kept ?? null,
  lemmaPhrases: summary?.streams?.lemma?.kept ?? null,
  englishPhrases: summary?.streams?.english?.kept ?? null,
  surfaceForms: summary?.surface_forms ?? null,
  ambiguousForms: summary?.surface_forms_ambiguous ?? null,
};

// Searches this page sends a reader to, built as the search page writes them.
const searchHref = (q: string) => `${base}/search?${q}`;
const tryNear = searchHref('c=l:areth&c=l:yuxh&cw=10&w=EN');
const tryLine = searchHref('c=l:areth&c=l:yuxh&cu=line&w=EN');
const tryOr = searchHref('c=l:areth&c=l:hdonh&c=lo:luph&w=EN,EE');
const tryNot = searchHref('c=l:areth&c=lb:hdonh&c=ln:luph&cw=10&w=EN,EE');
const tryGrammar = searchHref('c=g:tense.aor,voice.pass,mood.part&w=DA');

const title = 'How search works';
const description =
  'How to search Aristotle in Greek and English: Beta Code, wildcards, a' +
  ' single dictionary word, every form of a phrase, every translation,' +
  ' grammar, proximity, and the phrase index, with worked examples and what' +
  ' each tool cannot tell you.';
const canonical = Astro.site ? new URL(`${base}/advanced/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/${shareCard()}`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  name: title,
  description,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Aristotle Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-guide">
    <BNav active="/search" />

    <main class="guide">
      <header class="guide-head">
        <h1>How search works</h1>
        <p class="guide-lede">
          Tools for asking questions of Aristotle's Greek, and of its
          translations, that a plain word search cannot answer. You need no
          Greek for most of them, and you can read the sections in any order.
          Every number on this page is counted from the texts this site
          serves: {n(corpus.works)} works, {n(corpus.tokens)} Greek words.
          Check any of them against the search itself.
        </p>
      </header>

      <nav class="guide-toc" aria-label="On this page">
        <ol>
          {TOC.map((t, i) => (
            <li>
              <a href={`#${t.id}`}>
                <span class="toc-n" aria-hidden="true">{greekNumeral(i + 1)}</span>
                <span class="toc-t">{t.title}{t.gist && <small>{t.gist}</small>}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <article class="guide-body">
        <section id="first">
          <h2>First, three things worth knowing</h2>
          <p>
            <em>Greek changes the ends of words.</em> English mostly does not:
            "virtue" looks the same wherever it stands. Greek changes the
            ending to show the word's job, so <span lang="grc">ἀρετή</span>,
            <span lang="grc">ἀρετῆς</span>, and <span lang="grc">ἀρετήν</span>
            are one word doing three jobs. A search for one spelling would miss
            most of the places the word occurs. That is why Form starts at
            <em>Any form of this word</em>: type any form, and the search finds
            them all.
          </p>
          <p>
            <em>The search reads every work.</em> In starts at <em>All
            works</em>: all {n(works.all)}, including the {n(works.dubious)}
            dubious and {n(works.spurious)} spurious works that came down
            under Aristotle's name{works.others.length ? <>, and {list(works.others)}</> : ''}.
            Set In to <em>Authentic works</em> for Aristotle's
            {n(works.authentic)}, or <em>Choose works…</em> to pick your own.
          </p>
          <p>
            <em>You can type Greek without a Greek keyboard.</em> Type
            <code>texnh</code> and the search reads <span lang="grc">τέχνη</span>.
            <a href="#typing">Typing Greek</a> has the letters.
          </p>
          <p class="guide-note">
            Numbers like 1094a15 are Bekker numbers, the standard way of citing
            Aristotle: page, column, and line of Bekker's Berlin edition. Most
            editions and translations print them in the margin, so the same
            number finds the same passage in any of them. Results here use them
            throughout.
          </p>
        </section>

        <section id="typing">
          <h2><span class="gh-n" aria-hidden="true">{num('typing')}</span>Typing Greek</h2>
          <p class="guide-q">Use this when you have no Greek keyboard.</p>
          <p>
            Beta Code writes Greek in Latin letters. Each Greek letter has one
            Latin letter, and the marks over the letters are written with
            <code>)</code> <code>(</code> <code>/</code> <code>\</code>
            <code>=</code> <code>|</code> <code>+</code> after the letter they
            belong to. Scholars have long used it to put Greek into computers,
            and the search box reads it without being asked:
            <code>a)reth/</code> is <span lang="grc">ἀρετή</span>, and
            <code>texnh</code> is <span lang="grc">τέχνη</span>.
          </p>
          <div class="beta" role="table" aria-label="Beta Code letters">
            {BETA_LETTERS.map(([key, letter]) => (
              <div class="beta-cell" role="row">
                <code role="cell">{key}</code>
                <span role="cell" lang="grc">{letter}</span>
              </div>
            ))}
          </div>
          <div class="beta beta-marks" role="table" aria-label="Beta Code marks">
            {BETA_MARKS.map(([key, example, name]) => (
              <div class="beta-cell" role="row">
                <code role="cell">{key}</code>
                <span role="cell" lang="grc">{example}</span>
                <small role="cell">{name}</small>
              </div>
            ))}
          </div>
          <p>
            A few letters catch people out. <code>h</code> is
            <span lang="grc">η</span> and <code>w</code> is
            <span lang="grc">ω</span>, so <code>e</code> and <code>o</code>
            stay short. <code>q</code> is <span lang="grc">θ</span>,
            <code>c</code> is <span lang="grc">ξ</span>, and <code>x</code>
            is <span lang="grc">χ</span>. A final <code>s</code> becomes
            <span lang="grc">ς</span> by itself.
          </p>
          <p>
            Turn on <em>Beta Code</em>, beside the search box, and the letters
            turn Greek as you type: <code>a)reth/</code> becomes
            <span lang="grc">ἀρετή</span> in the box, so you can see what you
            asked for. With it off, the box keeps your Latin letters and the
            search reads them the same way.
          </p>
          <p>
            You may leave the marks off: the search ignores accents,
            breathings, and capitals. Turn on <em>Accents</em> to match the
            marks exactly. Then <span lang="grc">λόγος</span> and
            <span lang="grc">λογός</span> are different searches, and a word
            typed without marks finds only words printed without them.
          </p>
          <h3>The keyboard</h3>
          <p>
            <em>Keyboard</em>, beside the search box, opens a Greek keyboard on
            the screen, laid out as Apple lays out Greek. The marks have a row
            of their own: type a vowel, then press a mark, and it joins the
            vowel. Press another mark of the same kind and it replaces the
            first.
          </p>
        </section>

        <section id="wildcards">
          <h2><span class="gh-n" aria-hidden="true">{num('wildcards')}</span>Wildcards</h2>
          <p class="guide-q">Use this when you know how a word begins but not how it ends.</p>
          <p>
            End a word with <code>*</code> and it stands for whatever follows.
            With Form set to <em>Only as I typed it</em>, <code>fron*</code>
            reaches {n(wildcard?.fron)} different spellings across the works:
            <span lang="grc">φρόνησις</span>, <span lang="grc">φρόνιμος</span>,
            <span lang="grc">φρονεῖν</span>, and the rest of that family at
            once. Since Greek marks a word's job at the end, one wildcard
            gathers the whole paradigm. Under <em>Any form of this word</em>,
            the search goes further and adds every other form of the words
            those spellings belong to.
          </p>
          <p>
            A wildcard reaches further the more text you give it. In the
            <em>Nicomachean Ethics</em> alone, <code>l*</code> reaches
            {n(wildcard?.ethicsL)} different spellings; across all
            {n(corpus.works)} works it reaches {n(wildcard?.l)}, out of
            {n(wildcard?.distinct)} in the corpus. The search counts places,
            not spellings, so it answers <code>l*</code> with passages, not
            with a word count.
          </p>
          <p>
            A star can also stand inside a word, and <code>?</code> stands for
            exactly one letter. <code>l*s</code> is every word that begins with
            <span lang="grc">λ</span> and ends with <span lang="grc">ς</span>,
            {n(wildcard?.lS)} different spellings. <code>log?s</code> finds
            <span lang="grc">λόγος</span> but not <span lang="grc">λόγους</span>,
            which has two letters in that place. The pattern must match the
            whole word, so a star in the middle never quietly becomes "every
            word beginning λ".
          </p>
          <p>
            Greek also takes <code>.</code> for one letter, <code>+</code> for
            one or more of the letter before, <code>[ ]</code> for one of
            several letters (<code>[^ ]</code> for any letter but those),
            <code>( | )</code> for either of two, and <code>^</code> and
            <code>$</code> for the start and end of the word.
            <code>(φιλ|σοφ)ια</code> finds both <span lang="grc">φιλία</span>
            and <span lang="grc">σοφία</span>.
          </p>
          <p class="guide-note">
            A star at the start of a word depends on how you type it. In Greek
            letters it is a wildcard: <code>*ικος</code> finds every word ending
            in <span lang="grc">-ικος</span>. In Beta Code a star before a
            letter makes a capital, so there you write the ending as
            <code>.*ikos$</code>. Beta Code also reads <code>( ) | +</code> as
            marks, so groups and alternatives need Greek letters. In English a
            leading star is always a wildcard: <code>*ness</code> finds
            happiness and goodness.
          </p>
          <h3>Running text</h3>
          <p>
            Set Form to <em>Running text</em> and the search reads the Greek as
            one stream of letters, across the breaks between words.
            <code>λογ</code> finds <span lang="grc">λόγος</span> and
            <span lang="grc">ἀναλογία</span>: the letters wherever they stand,
            at the start of a word or inside one. Here <code>.</code> is one
            letter, <code>.*</code> any run of letters, and <code>|</code>
            either of two. Each break between words counts as one space, so you
            can search across words too. Turn on <em>Punctuation</em> to match
            the stops as well: <code>,</code> <code>.</code> <code>;</code> and
            <code>·</code>.
          </p>
        </section>

        <section id="lemma">
          <h2><span class="gh-n" aria-hidden="true">{num('lemma')}</span>Lemma</h2>
          <p class="guide-q">Use this when you want one dictionary word, in every form, and nothing else.</p>
          <p>
            <em>Any form of this word</em> already works out the dictionary
            word from whatever form you type. Lemma is for when you would
            rather choose it yourself. Turn on <em>Lemma</em> and the box asks
            for a dictionary word. Start typing, and a list of
            <em>Dictionary words</em> opens: the headword, a short meaning, and
            how often it occurs. Pick the one you mean. The search then finds
            every form of that word and no other: no spelling that merely looks
            like it, and no other word that one of its forms could also belong
            to.
          </p>
          <p>
            Typing <span lang="grc">ψυχ</span> offers
            <span lang="grc">ψυχή</span> first, as the commonest, then the
            other words that begin that way, such as
            <span lang="grc">ψυχρός</span>, so you choose rather than guess.
            The list holds {n(pickerKeys)} entries, one for every word the
            search can find. A term set to <em>any form</em> in
            <a href="#combo">Proximity</a> picks from the same list.
          </p>
          <p class="guide-note">
            The search ignores accents, so words that differ only by an
            accent or breathing, such as <span lang="grc">ὅρος</span>
            ("boundary"), <span lang="grc">ὄρος</span> ("mountain"), and
            <span lang="grc">ὀρός</span> ("whey"), are one entry in the list,
            shown together. No search here can separate them.
          </p>
        </section>

        <section id="variants">
          <h2><span class="gh-n" aria-hidden="true">{num('variants')}</span>Word endings</h2>
          <p class="guide-q">
            Use this when you know a phrase but want every form of it, not just
            the one you typed.
          </p>
          <p>
            An exact phrase search finds only the version you typed. Search two
            or more Greek words and a button appears beside the results:
            <em>Find this phrase in any inflection</em>. It works out which
            dictionary word each of your words belongs to, then looks for every
            form of those words standing in the order you gave.
          </p>
          <p>
            The phrase index shows how much that gathers.
            <span lang="grc">τὸ καλόν</span> ("the fine") stands
            {n(theFine?.count)} times as those exact letters, in
            {n(theFine?.works)} works. Read as dictionary words,
            <span lang="grc">ὁ καλός</span>, which gathers
            <span lang="grc">τοῦ καλοῦ</span>, <span lang="grc">τῷ καλῷ</span>,
            <span lang="grc">τῶν καλῶν</span>, and the rest, it stands
            {n(theFineLemma?.count)} times, in {n(theFineLemma?.works)}. To
            find those yourself you would have to know that
            <span lang="grc">τό</span>, <span lang="grc">τοῦ</span>, and
            <span lang="grc">τῷ</span> are one word. The tool knows it for you.
          </p>
          <p class="guide-note">
            It invents nothing. <span lang="grc">ὡς ἐπὶ τὸ πολύ</span> ("for
            the most part") stands {n(mostly?.count)} times as written and
            {n(mostlyLemma?.count)} times read as dictionary words. A tool that
            always found more would tell you nothing.
          </p>
        </section>

        <section id="english">
          <h2><span class="gh-n" aria-hidden="true">{num('english')}</span>English searches</h2>
          <p class="guide-q">Use this to find a word in the translations, in any of its forms.</p>
          <p>
            Choose <em>English</em> beside the search box. An English search
            finds a word in all its forms by default: a plural or possessive
            finds its singular, and back. In the main translation of each work
            "soul" stands {n(soul.one)} times, and "souls" and "soul's"
            {n(soul.forms)} times more. Form set to <em>Any form of this
            word</em> finds them all; <em>Only as I typed it</em> finds the one
            spelling you gave. Irregular plurals are known too: "man" finds
            "men".
          </p>
          <p>
            Match works as it does for Greek. <em>All words</em> wants every
            word somewhere in the passage, <em>Any word</em> at least one of
            them, and <em>Exact phrase</em> the words in a row, in your order.
          </p>
          <h3>Every translation</h3>
          <p>
            {n(multiTranslated)} works have more than one translation here, and
            an English search asks each of them. A passage that several
            translations match is one hit: the Greek once, and one
            translation's English. Under it stand the names of the translators
            whose words matched. Click a name to read that translation of the
            passage instead. The <em>Translations</em> list beside the results
            counts the hits in each, and choosing one shows only its hits.
          </p>
          <h3>Greek and English at once</h3>
          <p>
            Choose <em>Both</em> and you get two boxes, Greek and English.
            <em>Hits match</em> decides whether a passage must match
            <em>both languages</em> or <em>either language</em>.
          </p>
        </section>

        <section id="grammatical">
          <h2><span class="gh-n" aria-hidden="true">{num('grammatical')}</span>Search by grammar</h2>
          <p class="guide-q">Use this to find a kind of word rather than a particular word.</p>
          <p>
            Every Greek word here carries a grammatical description: its case,
            number, tense, and so on. You can search those descriptions instead
            of the spelling. In <a href="#combo">Proximity</a>, set a term's
            Kind to <em>by grammar</em>, and the choices open in rows: Case,
            Number, Gender, Tense, Mood, Voice, Person, and Degree. Pick a value
            in as many rows as you like; a word must match them all. You need
            not know how any of these forms are spelled.
          </p>
          <p>
            Grammar searched across all of Aristotle would not be a question:
            there are {n(grammar?.genPlFem.total)} feminine genitive plurals in
            the works, and a list of them tells you about Greek rather than
            about Aristotle. So a grammar term runs on its own only once
            something narrows it: fewer works under In, or a word near or not
            near it. Ask without either, and the page offers <em>Choose
            works</em> and <em>Add a word near or not near</em> instead of
            results. <a href={tryGrammar}>Aorist passive participles in the
            <em>De Anima</em></a> is a question;
            <em>a word near a verb in the optative</em> is another.
          </p>
          <p>
            Grammar also sorts results you already have. Set Group by to
            grammar and the hits fall into groups by their analysis, with a
            <em>Grammar</em> list beside them: tick a case or a tense there to
            keep only those hits.
          </p>
          <h3>When the letters could be two forms</h3>
          <p>
            The same Greek letters can be two different forms. When that
            happens the hit shows what is left open, rather than choosing for
            you.
          </p>
          <p>
            Aristotle's works hold {n(grammar?.optative.total)} words that can
            be read as optatives. Of those, {n(grammar?.optative.certain)} have
            only that reading; a hit on any of the rest comes back marked,
            because you could read those letters another way. The mark is no
            flaw in the search. It reports a fact about the Greek.
          </p>
          <p>
            A clearer case: of the {n(grammar?.genDual.total)} genitive duals
            (the dual is the form for pairs), {grammar?.genDual.certain === 0
              ? <>not one is certain</>
              : <>only {n(grammar?.genDual.certain)} are certain</>}. In the
            dual, genitive and dative share one ending. The search cannot tell
            them apart because Greek does not, and it says so.
          </p>
        </section>

        <section id="combo">
          <h2><span class="gh-n" aria-hidden="true">{num('combo')}</span>Proximity</h2>
          <p class="guide-q">Use this to find where two ideas are discussed together.</p>
          <p>
            Proximity finds passages where two or more terms stand close
            together. Press <em>Proximity</em>, beside Search, to open the
            editor. Search either word alone and you get every passage that
            holds it; ask for both together and you get the passages where
            Aristotle is doing something with the pair.
            <a href={tryNear}><span lang="grc">ψυχή</span> near
            <span lang="grc">ἀρετή</span> in the <em>Nicomachean Ethics</em></a>
            is one such question.
          </p>
          <h3>The editor</h3>
          <ul>
            <li>
              <em>Kind</em>: what a term is. <em>any form</em> is a dictionary
              word in every form, picked from the list (see
              <a href="#lemma">Lemma</a>); <em>as typed</em> is one spelling;
              <em>exact phrase</em> is several words in a row; <em>by
              grammar</em> is a description (see
              <a href="#grammatical">Search by grammar</a>).
            </li>
            <li>
              <em>Distance</em>, on Term 1's row: how close is close. Within 5
              words at first; you can set it as high as 50, or choose <em>the
              same line</em> of Greek
              (<a href={tryLine}>the same pair, in one line</a>).
            </li>
            <li>
              <em>Relation</em>, on every term after the first:
              <em>near</em>, <em>before</em>, <em>after</em>, or <em>not
              near</em>, and the term it is measured from. Usually that is Term
              1, but it can be any earlier term.
            </li>
            <li>
              <em>and</em> or <em>or</em>, before each term after the first.
              A term joined by <em>or</em> stands in for the one before it, and
              either will do: <a href={tryOr}>either <span lang="grc">ἡδονή</span>
              or <span lang="grc">λύπη</span> near
              <span lang="grc">ἀρετή</span></a>. It takes that term's relation,
              and its row says so.
            </li>
            <li>
              <em>Add term</em> and <em>Remove</em>. A search holds up to four
              terms.
            </li>
            <li>
              <em>In this order</em>: every term must appear in the order you
              gave. Once any term says before or after, those settle the order,
              and the line reads <em>Order set by before or after</em>.
            </li>
            <li>
              <em>Keep hits that cross a chapter</em>: on at first, since an
              argument often runs through a chapter break. Untick it to keep
              each match inside one chapter.
            </li>
          </ul>
          <p>
            Each term must fall within the distance of the term it is measured
            from. The distance is counted between those two words alone, not
            across the whole group, so three terms within 10 words can span
            more than 10 words in all. <em>Not near</em> turns that round: the
            passage must have no such word within the distance of its term.
            <a href={tryNot}><span lang="grc">ἡδονή</span> before
            <span lang="grc">ἀρετή</span>, with <span lang="grc">λύπη</span> not
            near</a> asks for pleasure without pain.
          </p>
          <p>
            Once a proximity search has run, it reads as one sentence above the
            editor, with <em>Turn off</em>, <em>Close</em>, and <em>Guide</em>
            under it (<em>Change</em> in place of Close when the editor is
            shut). A change in the editor is not searched until you press its
            <em>Search</em>. Until then the sentence is marked <em>Last
            search</em>, and <em>Not searched yet</em> beside the button shows
            the search you are building.
          </p>
          <p class="guide-note">
            A match never crosses from one book into the next, however wide the
            distance: the last words of one book and the first of the next are
            not near each other in any useful sense.
          </p>
        </section>

        <section id="results">
          <h2><span class="gh-n" aria-hidden="true">{num('results')}</span>Reading the results</h2>
          <p class="guide-q">Use this to make a long list of hits answer your question.</p>
          <p>
            The count is of instances: each place the search matched. Each
            instance shows its Bekker number, the Greek with the match marked,
            and the English under it. Click a Greek word in a hit to see its
            dictionary entry: the headword, its meaning, how the form parses,
            <em>Show LSJ definition</em> for the full entry, and how often it
            appears across Aristotle.
          </p>
          <ul>
            <li>
              <em>Group by</em>: by work, with a heading for each; by form, each
              spelling apart; or by grammar.
            </li>
            <li>
              <em>Sort</em>: <em>Bekker order</em>, <em>Works A–Z</em>,
              <em>Forms A–Z</em>, or <em>Commonest form first</em>. A sort
              orders the page you are on; it never moves a hit to another page.
            </li>
            <li>
              <em>Context</em>: <em>1 line</em>, <em>3 lines</em>, or the
              <em>Whole section</em> each hit stands in.
            </li>
            <li>
              <em>Per page</em>: 20, 40, or 100 hits, or <em>Citations
              only</em>, the places without the text.
            </li>
          </ul>
          <p>
            A page never splits a chapter. Each chapter's hits sit under a line
            that names it, "Chapter 13" and its title where the text has one,
            so a page that ends short ends at a chapter.
          </p>
          <p>
            Beside the results, <em>Works with hits</em> counts the hits in each work,
            most first. Choose one to see only its hits, and choose it again to
            see them all. <em>Forms</em> lists every spelling the search found,
            with its count: untick the ones you do not want and press
            <em>Apply</em>. <em>Export results as CSV</em> gives you the whole
            list as a spreadsheet, and <em>Save search</em> keeps the search in this
            browser.
          </p>
          <p class="guide-note">
            A search is written into the address bar as you run it, so you can
            bookmark it, send it to someone, or step back through your searches
            with the browser's back button.
          </p>
        </section>

        <section id="phrases">
          <h2><span class="gh-n" aria-hidden="true">{num('phrases')}</span>The phrase index</h2>
          <p class="guide-q">Use this when you do not yet know what to look for.</p>
          <p>
            Search answers "where does this occur?" The
            <a href={`${base}/phrases`}>phrase index</a> answers a different
            question: <em>what does Aristotle repeat?</em> It lists every phrase
            of two to five words that appears at least twice anywhere in the
            works: {n(corpus.formPhrases)} of them as written,
            {n(corpus.lemmaPhrases)} when forms of the same word count
            together, and {n(corpus.englishPhrases)} in the English. (If you
            have met the term, these are what linguists call n-grams.)
          </p>
          <p>
            Much of Aristotle's technical vocabulary is set phrases rather than
            single words, and no word search will show them to you:
            <span lang="grc">τὸ τί ἦν εἶναι</span> ("essence") occurs
            {n(essence?.count)} times across {n(essence?.works)} works;
            <span lang="grc">ὡς ἐπὶ τὸ πολύ</span> ("for the most part")
            {n(mostly?.count)} times; <span lang="grc">κατὰ συμβεβηκός</span>
            ("accidentally") {n(accidentally?.count)} times in
            {n(accidentally?.works)}. Not one of those is a word. Each is an
            idea, and browsing is the only way to meet them.
          </p>
          <h3>Reading a row</h3>
          <p>Every row is one phrase and four numbers. This is the row for <span lang="grc">τὸ τί ἦν εἶναι</span>:</p>
          <figure class="anatomy">
            <div class="anatomy-row">
              <span class="anatomy-phrase">
                <span lang="grc">τὸ τί ἦν εἶναι</span>
                <small>to ti hn einai</small>
              </span>
              <span class="anatomy-cell"><b>{n(essence?.words)}</b><small>Words</small></span>
              <span class="anatomy-cell"><b>{n(essence?.count)}</b><small>Count</small></span>
              <span class="anatomy-cell"><b>{n(essence?.works)}</b><small>Works</small></span>
              <span class="anatomy-cell score"><b>{score(essence?.score)}</b><small>Score</small></span>
            </div>
            <dl class="anatomy-key">
              <dt>Words</dt>
              <dd>How many words long. Two to five.</dd>
              <dt>Count</dt>
              <dd>How often it occurs in all the works.</dd>
              <dt>Works</dt>
              <dd>How many of the {n(corpus.works)} works it appears in.</dd>
              <dt>Score</dt>
              <dd>
                Distinctiveness: how much more often the phrase occurs than the
                commonness of its words would lead you to expect. It orders the
                list and removes nothing.
              </dd>
            </dl>
          </figure>

          <h3>The same phrase, counted two ways</h3>
          <p>
            <em>Count phrases by</em> reads the same works three ways.
            <em>Word as written</em> counts the letters on the page: change one
            ending and it is a different row. <em>Word in any of its forms</em>
            counts the words behind the letters, so every form of a phrase
            gathers into one row. Either takes the phrase as it stands on the
            page: type <span lang="grc">τὸ τί ἦν εἶναι</span> and the second
            finds it under <span lang="grc">ὁ τίς εἰμί εἰμί</span>, where it is
            stored, and tells you it read the words that way.
            <em>English translation</em> does the same for the English.
          </p>
          <figure class="anatomy">
            <div class="anatomy-row">
              <span class="anatomy-phrase">
                <span lang="grc">τὸ τί ἦν εἶναι</span>
                <small>as written</small>
              </span>
              <span class="anatomy-cell"><b>{n(essence?.words)}</b><small>Words</small></span>
              <span class="anatomy-cell"><b>{n(essence?.count)}</b><small>Count</small></span>
              <span class="anatomy-cell"><b>{n(essence?.works)}</b><small>Works</small></span>
              <span class="anatomy-cell score"><b>{score(essence?.score)}</b><small>Score</small></span>
            </div>
            <div class="anatomy-row">
              <span class="anatomy-phrase">
                <span lang="grc">ὁ τίς εἰμί εἰμί</span>
                <small>any of its forms</small>
              </span>
              <span class="anatomy-cell"><b>{n(essenceLemma?.words)}</b><small>Words</small></span>
              <span class="anatomy-cell"><b>{n(essenceLemma?.count)}</b><small>Count</small></span>
              <span class="anatomy-cell"><b>{n(essenceLemma?.works)}</b><small>Works</small></span>
              <span class="anatomy-cell score"><b>{score(essenceLemma?.score)}</b><small>Score</small></span>
            </div>
          </figure>
          <p>
            The second row is never the smaller: it gathers the phrase's other
            endings in with it. It also asks more of you. The same dictionary
            words can make phrases that are not the one you wanted, and the
            index cannot tell the difference: <span lang="grc">εἰμί</span>
            covers <span lang="grc">ἦν</span>, <span lang="grc">ἐστιν</span>,
            and <span lang="grc">ἔστω</span> alike. Use it to find what you
            would otherwise miss, then read as written to see what you have.
          </p>
          <p class="guide-note">
            The score changes between the two rows for what is, in the main,
            the same expression. Nothing has weakened. Distinctiveness measures
            surprise against the words a phrase is made of, and the two rows
            are made of different words: <span lang="grc">ὁ</span> and
            <span lang="grc">εἰμί</span> are commoner than the exact shapes
            <span lang="grc">τό</span> and <span lang="grc">ἦν</span>, so a
            phrase built from them surprises less.
          </p>

          <h3>Using the list</h3>
          <ul>
            <li>
              <em>Sort</em> starts at <em>Distinctiveness</em>, which asks
              whether a phrase occurs more often than its words would lead you
              to expect. Sort by <em>Frequency</em> instead and you see the
              grammar of Greek rather than the thought of Aristotle.
            </li>
            <li>
              <em>Length</em>, <em>Minimum count</em>, and <em>Work</em> narrow
              the list, and <em>Phrase starts with</em> finds a phrase by its
              first words. Sorting never removes anything.
            </li>
            <li>
              An English phrase that recurs across several works may be one
              translator's habit rather than Aristotle's, so read its Works
              column. An English phrase is a place to look, not evidence about
              the Greek.
            </li>
          </ul>
          <p>
            Click any phrase to see every place it occurs, grouped by work, each
            linked to that passage in the reader. A way to use it: pick the work
            you are reading and a length of four or five, then sort by
            distinctiveness. You get that work's set expressions, often the
            working vocabulary of its argument, including phrases no glossary
            would have sent you to.
          </p>
        </section>

        <section id="honesty">
          <h2><span class="gh-n" aria-hidden="true">{num('honesty')}</span>What these tools cannot tell you</h2>
          <p>
            All of this rests on a word-by-word grammatical description of the
            Greek, and that description is often uncertain. Where it is, these
            tools say so rather than choose an answer and present it as fact.
            The limits worth knowing:
          </p>
          <ul>
            <li>
              A hit marked with more than one reading comes from a form the
              description cannot settle. Of the {n(grammar?.optative.total)}
              possible optatives, {n(grammar?.optative.certain)} are settled and
              the rest are not.
            </li>
            <li>
              Searches ignore accents unless you turn on <em>Accents</em>.
              And of the {n(corpus.surfaceForms)} spellings in the works,
              {n(corpus.ambiguousForms)} could belong to more than one
              dictionary word, so a search for one word in all its forms can
              bring back another word that shares a spelling.
            </li>
            <li>
              The phrase index shows Greek without accents, because it does not
              record them. We do not guess them.
            </li>
            <li>
              Later editors made the chapter divisions, not Aristotle, and in
              {n(roughChapters.length)} of the {n(corpus.works)} works we know
              where a chapter begins only to the Bekker line, not to the word.
              A search that keeps matches inside a chapter says so when one of
              those works is involved.
            </li>
            <li>
              None of these tools reads Greek. They match forms and count them.
              What a passage means remains your work.
            </li>
          </ul>
          <p class="guide-note">
            The grammatical descriptions come from Morpheus, by way of
            Diogenes; the dictionary is Liddell–Scott–Jones.
          </p>
        </section>

        <p class="guide-back">
          <a href={`${base}/search`}>Back to search</a>
          <a href={`${base}/phrases`}>Browse phrases</a>
        </p>
      </article>
    </main>

    <BFoot />
  </div>
</body>
</html>
