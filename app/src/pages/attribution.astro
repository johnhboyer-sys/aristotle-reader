---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import { WORKS } from '../lib/works';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// True only in the local/full build, where copyright-encumbered overlays are
// carried; the public deploy (PUBLIC_HIDE_PRIVATE=1) drops them entirely, so the
// "local only" legend below is suppressed there.
const hasPrivate = WORKS.some((w) => w.translations.some((t) => t.private));
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>Texts &amp; Licences — Aristotle</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  <style>
    .attr-body {
      max-width: 680px;
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
      font-family: var(--font-english);
      font-size: 0.95rem;
      line-height: 1.75;
      color: var(--text);
    }
    h2 {
      font-family: var(--font-ui);
      font-size: 1rem;
      font-weight: 600;
      color: var(--accent);
      margin: 2rem 0 0.4rem;
      letter-spacing: .02em;
    }
    h2:first-of-type { margin-top: 1rem; }
    p { margin: 0 0 0.6rem; }
    ul { margin: 0 0 0.6rem; padding-left: 1.3rem; }
    li { margin: 0 0 0.35rem; }
    a { color: var(--accent); }
    .licence-badge {
      display: inline-block;
      font-family: var(--font-ui);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: .06em;
      background: var(--border);
      border-radius: 3px;
      padding: 0.1em 0.5em;
      margin-left: 0.4em;
      vertical-align: middle;
      color: var(--text-mid);
    }
    .licence-badge.cc { background: #e8f4e8; color: #2a6a2a; }
    .licence-badge.pd { background: #e8eef4; color: #2a4a6a; }
    .licence-badge.mit { background: #f4f0e8; color: #6a4a2a; }
    .licence-badge.local {
      font-size: 0.65rem;
      letter-spacing: .04em;
      text-transform: uppercase;
      background: #f4e8e8; color: #8a3a3a;
    }
    :global(html[data-theme="dark"]) .licence-badge.cc { background: #1f3320; color: #9ed3a0; }
    :global(html[data-theme="dark"]) .licence-badge.pd { background: #1c2a3a; color: #9cc2e6; }
    :global(html[data-theme="dark"]) .licence-badge.mit { background: #33291c; color: #e0b483; }
    :global(html[data-theme="dark"]) .licence-badge.local { background: #3a1c1c; color: #e69c9c; }
    .trans-list { list-style: none; padding-left: 0; margin: 0.75rem 0 1rem; }
    .trans-list > li { margin: 0 0 0.9rem; }
    .trans-list > li > strong {
      font-family: var(--font-ui);
      font-size: 0.9rem;
      color: var(--text);
    }
    .trans-list ul {
      list-style: none;
      padding-left: 0.9rem;
      margin: 0.15rem 0 0;
      border-left: 1px solid var(--border);
    }
    .trans-list ul li {
      margin: 0.1rem 0;
      color: var(--text-mid);
      font-size: 0.9rem;
    }
    blockquote {
      border-left: 3px solid var(--border);
      margin: 0.75rem 0 0.75rem 1rem;
      padding: 0.25rem 0 0.25rem 1rem;
      color: var(--text-mid);
      font-size: 0.9rem;
    }
    .greek { font-family: var(--font-greek); }
  </style>
</head>
<body>
  <header class="simple-header">
    <div class="header-title">
      <a class="home-link" href={`${base}/`} title="All works">Aristotle</a>
      <span class="title-sep">›</span>
      <span class="header-static">Texts &amp; Licences</span>
    </div>
    <nav class="header-actions" aria-label="Navigation">
      <a href={`${base}/`} class="search-link">All works</a>
      <a href={`${base}/search`} class="search-link">Search</a>
      <ThemeToggle />
    </nav>
  </header>

  <div class="attr-body">
    <h2>Texts &amp; Licences</h2>
    <p>
      This reader presents Greek texts, English translations, and reference
      works compiled from public-domain editions and openly licensed sources.
      Their sources and licence terms are listed below.
    </p>

    <h2>
      Greek Lexicon (LSJ)
      <span class="licence-badge cc">CC BY-SA 3.0</span>
    </h2>
    <p>
      The word popups and lemma entries are drawn from the
      <em>Greek–English Lexicon</em> of Henry George Liddell and Robert Scott,
      revised by Sir Henry Stuart Jones with the assistance of Roderick McKenzie
      (Oxford: Clarendon Press, 9th ed. 1940; supplement 1996).
    </p>
    <p>
      The machine-readable edition used here is the XML transcription prepared
      by the <a href="https://www.perseus.tufts.edu/">Perseus Digital Library</a>
      at Tufts University and is made available under a
      <a href="https://creativecommons.org/licenses/by-sa/3.0/us/">
        Creative Commons Attribution-ShareAlike 3.0 United States</a> licence.
    </p>
    <blockquote>
      Liddell, Henry George, and Robert Scott.
      <em>A Greek-English Lexicon.</em>
      Revised and augmented by Henry Stuart Jones.
      Oxford: Clarendon Press, 1940.
      Machine-readable version: Perseus Digital Library,
      Trustees of Tufts University.
      <a href="https://creativecommons.org/licenses/by-sa/3.0/us/">CC BY-SA 3.0 US</a>.
    </blockquote>
    <p>
      The CC BY-SA licence requires that any derivative work be distributed
      under the same terms. This application's lexical data is a subset and
      derivative of that work; users who redistribute it must carry this
      attribution notice and the same CC BY-SA licence.
    </p>

    <h2>
      English Translations
      <span class="licence-badge pd">Public Domain &amp; archival</span>
    </h2>
    <p>
      Each work carries one or more freely available scholarly translations,
      listed below in the order they appear in the reader's translation picker.
      This list is generated directly from the corpus registry, so it always
      matches what the reader actually carries.
    </p>
    <ul class="trans-list">
      {WORKS.filter((w) => w.translations.length > 0).map((w) => (
        <li>
          <strong>{w.title}</strong>
          <ul>
            {w.translations.map((t) => (
              <li>
                {t.name}
                {t.private && <span class="licence-badge local">local only</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="note">
      Translations are reproduced from public-domain editions and freely
      available scholarly archives; machine-readable texts derive from the
      <a href="https://www.perseus.tufts.edu/">Perseus Digital Library</a> and the
      <a href="http://classics.mit.edu/">Internet Classics Archive</a>.
      {hasPrivate && (
        <span> Entries marked <span class="licence-badge local">local only</span> are
        copyright-encumbered and are excluded from the public edition of this site.</span>
      )}
      If you hold rights to any text shown here and wish it removed, please get in
      touch.
    </p>

    <h2>Bekker Line Numbers</h2>
    <p>
      Bekker numbers (e.g.&nbsp;<em>1094a1</em>) are the standard way to cite
      Aristotle, keyed to Immanuel Bekker's 1831 Berlin edition. The Greek text
      here is lineated to that edition, so <strong>its line numbers are exact and
      fixed</strong>.
    </p>
    <p>
      The English translations do not themselves carry Bekker line numbers, and a
      translation rarely matches the Greek line for line. The numbers shown beside
      a translation are therefore aligned by this project, in two kinds:
    </p>
    <ul>
      <li>
        <strong>Fixed</strong> (shown upright) — anchored to a definite point in
        the translation, whether a Bekker column boundary or a hand-keyed
        sentence; the number marks that exact place.
      </li>
      <li>
        <strong>Approximate</strong> (shown in <em>italic grey</em>) — interpolated
        estimates that space the remaining line numbers proportionally between the
        fixed anchors. Treat them as a guide to the neighbourhood, not an exact
        citation.
      </li>
    </ul>
    <p>
      For a precise citation, use the Greek line number (always exact) or a fixed
      (upright) number beside the translation.
    </p>

    <h2>
      Greek Text
      <span class="licence-badge pd">Public Domain</span>
    </h2>
    <p>
      The Greek text of each work is lineated to Bekker. The scholarly print
      edition it follows is listed below.
    </p>
    <ul>
      {WORKS.map((w) => (
        <li><strong>{w.title}</strong> — {w.greekSource.full}</li>
      ))}
    </ul>
    <p>
      Chapter divisions for <em>De Anima</em> follow the TEI markup of the
      <a href="https://opengreekandlatin.github.io/First1KGreek/">Open Greek and
      Latin First1KGreek</a> edition, aligned onto the Bekker-lineated Greek.
    </p>

    <h2>
      Morphological Data
      <span class="licence-badge pd">Open</span>
    </h2>
    <p>
      Morphological analyses (lemma, gloss, grammatical parse) are produced
      by the Morpheus morphological analyser as distributed with
      <a href="https://d.iogen.es/">Diogenes</a>.
      See the Diogenes and Perseus project pages for applicable terms.
    </p>

    <h2>
      Application Code
      <span class="licence-badge mit">MIT</span>
    </h2>
    <p>
      The pipeline and web application source code (Python and TypeScript/Svelte)
      are released under the
      <a href="https://opensource.org/licenses/MIT">MIT Licence</a>.
      Data files derived from CC BY-SA sources are excluded from this grant
      and remain subject to CC BY-SA.
    </p>
    <p>
      Site by <a href="https://x.com/johnhboyer" target="_blank" rel="noopener">John H. Boyer</a>.
    </p>
  </div>
</body>
</html>
