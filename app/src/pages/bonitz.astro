---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Segment =
  | { kind: 'text';       content: string }
  | { kind: 'cit';        content: string }
  | { kind: 'unclear';    content: string }
  | { kind: 'wref';       abbr: string; book: string; chap: string;
                          latin: string; english: string; _raw: string }
  | { kind: 'latin_abbr'; abbr: string; english: string }
  | { kind: 'lat';        latin: string; english: string };

type Sense = { n: string; segments: Segment[]; children?: Sense[] };

type RawEntry =
  | { type: 'section_head'; content: string }
  | { type: 'header_gloss'; segments?: Segment[]; senses?: Sense[] }
  | { type: 'continuation'; segments?: Segment[]; senses?: Sense[] }
  | { type: 'entry'; lemma: string; segments?: Segment[]; senses?: Sense[]; continues?: boolean };

type Column = { page: string; col: string; section: string; entries: RawEntry[] };

type Block =
  | { kind: 'segments'; segments: Segment[] }
  | { kind: 'senses';   senses: Sense[] };

type FlatEntry =
  | { type: 'section_head'; content: string; section: string }
  | { type: 'header_gloss'; blocks: Block[]; section: string }
  | { type: 'orphan_cont';  blocks: Block[]; section: string }
  | { type: 'entry'; lemma: string; blocks: Block[]; section: string };

// ── Load every column JSON (pages 15–60, L+R) in reading order ──
const modules = import.meta.glob<{ default: Column }>('../data/bonitz/page-*.json', { eager: true });
const columns: Column[] = Object.keys(modules).sort().map(k => modules[k].default);

function toBlocks(e: RawEntry): Block[] {
  if ('senses' in e && e.senses && e.senses.length) return [{ kind: 'senses', senses: e.senses }];
  if ('segments' in e && e.segments && e.segments.length) return [{ kind: 'segments', segments: e.segments }];
  return [];
}

// ── Flatten + stitch cross-column continuations ──
// A column that opens with a lemma-less `continuation` fragment is the tail of
// the previous article — merge its blocks onto the last real entry. (The
// `continues="next"` end-flag is unreliable across independently-OCR'd columns,
// so we drive stitching off the reliable leading-fragment signal instead.)
const GREEK_CAPS = 'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ';
const seenSection = new Set<string>();

const flat: FlatEntry[] = [];
for (const col of columns) {
  const section = col.section || 'Α';
  for (const e of col.entries) {
    if (e.type === 'section_head') {
      // Opus sometimes mis-tags running-head guide words (e.g. Ἀγαπήνωρ) or stray
      // marks as <section_head>. Accept only a single Greek capital seen for the
      // first time; the real article (if any) appears as its own entry below.
      const c = (e.content || '').trim();
      if (c.length === 1 && GREEK_CAPS.includes(c) && !seenSection.has(c)) {
        seenSection.add(c);
        flat.push({ type: 'section_head', content: c, section });
      }
    } else if (e.type === 'continuation') {
      let target: FlatEntry | undefined;
      for (let i = flat.length - 1; i >= 0; i--) {
        if (flat[i].type === 'entry') { target = flat[i]; break; }
      }
      if (target && 'blocks' in target) target.blocks.push(...toBlocks(e));
      else flat.push({ type: 'orphan_cont', blocks: toBlocks(e), section });
    } else if (e.type === 'header_gloss') {
      flat.push({ type: 'header_gloss', blocks: toBlocks(e), section });
    } else {
      flat.push({ type: 'entry', lemma: e.lemma || '', blocks: toBlocks(e), section });
    }
  }
}

// ── Alphabetical quick-nav by the lemma's leading letters ──
// Everything here is section α, so a single-letter nav is useless; instead we
// bucket by the first two *base* Greek letters (αα, αβ, αγ …) and drop an anchor
// on the first entry of each new bucket. Generalises to deeper sections later.
function baseLetters(lemma: string): string {
  const out: string[] = [];
  for (const ch of (lemma || '').normalize('NFD')) {
    const lo = ch.toLowerCase();
    if (lo >= 'α' && lo <= 'ω') out.push(lo === 'ς' ? 'σ' : lo);
  }
  return out.join('');
}

const sectionLetter = (columns[0]?.section || 'Α').toLowerCase();
const bucketSeen = new Set<string>();
const buckets: string[] = [];
const anchorFor: (string | null)[] = flat.map(f => {
  if (f.type === 'section_head') return `sec-${f.section}`;
  if (f.type !== 'entry') return null;
  const bl = baseLetters(f.lemma);
  // Only seed a bucket for a genuine two-letter headword in this section
  // (skips article-led lemmata like "τὸ …" and stray single-letter entries).
  if (bl.length < 2 || bl[0] !== sectionLetter) return null;
  const b = bl.slice(0, 2);
  if (bucketSeen.has(b)) return null;
  bucketSeen.add(b);
  buckets.push(b);
  return `b-${b}`;
});

const entryCount = flat.filter(f => f.type === 'entry').length;
const pageFirst = '15';
const pageLast  = '60';
const lastEntry = [...flat].reverse().find(f => f.type === 'entry') as { lemma: string } | undefined;
const lastLemma = lastEntry?.lemma ?? '';
const navBuckets = [...buckets].sort();

// ── Bekker citation normalisation helpers ──

// Error 3: remove space between Bekker page number and sub-page letter
function normCit(raw: string): string {
  return raw.replace(/(\d)\s+([ab])/g, '$1$2');
}

// Error 2: expand comma-separated line numbers into independent citations
// "1094a3,20" → "1094a3, 1094a20"
function expandCit(raw: string): string {
  const s = normCit(raw);
  if (!s.includes(',')) return s;
  const parts = s.split(',').map(p => p.trim());
  const first = parts[0];
  const m = first.match(/^(\d+[ab])/);
  if (!m) return s;
  const prefix = m[1];
  return parts.map(p => /^\d+[ab]/.test(p) ? p : prefix + p).join(', ');
}

// ── Stateful segment renderer ──
//
// State tracked:
//   currentBook      — book letter from the most recent wref (for error-5 semicolons)
//   afterCit         — true immediately after a cit (so continuation refs are detected)
//   pendingCitPrefix — Bekker PAGE number awaiting the next cit's sub-page suffix.
//                      Arises when Opus split a citation across tokens:
//                        wref.chap="1350" + cit="a26"  →  cit should be "1350a26"
//                        text=", 1347 " + cit="a34"    →  cit should be "1347a34"
//
// Uses index-based iteration for one-step lookahead.
function renderSegments(segs: Segment[]): string {
  const parts: string[] = [];
  let currentBook = '';
  let afterCit = false;
  let pendingCitPrefix = '';

  for (let i = 0; i < segs.length; i++) {
    const s = segs[i];
    const next = i + 1 < segs.length ? segs[i + 1] : null;

    // ── citation ──────────────────────────────────────────────────────────────
    if (s.kind === 'cit') {
      const full = pendingCitPrefix + s.content;
      pendingCitPrefix = '';
      parts.push(`<span class="cit">${expandCit(full)}</span>`);
      afterCit = true;
      continue;
    }

    // ── work reference ────────────────────────────────────────────────────────
    if (s.kind === 'wref') {
      currentBook = s.book;
      afterCit = false;
      const bookUp = s.book ? s.book.toUpperCase() : '';
      const titleSuffix = bookUp ? ` ${bookUp}:` : ':';

      // Detect split citation: chap is a bare Bekker page (3-4 digits) and the
      // sub-page portion (e.g. "a26") appears in the very next segment.
      // Pattern A: wref → cit(sub)
      // Pattern B: wref → text(whitespace/period only) → cit(sub)
      const nextIsSplitCit = next?.kind === 'cit' && /^[ab]\d+/.test(next.content);
      const nextNext = i + 2 < segs.length ? segs[i + 2] : null;
      const splitViaSep =
        next?.kind === 'text' && /^[\s.]*$/.test(next.content) &&
        nextNext?.kind === 'cit' && /^[ab]\d+/.test((nextNext as { content: string }).content);
      const chapIsBekkPage = /^\d{3,4}$/.test(s.chap);

      if (chapIsBekkPage && (nextIsSplitCit || splitViaSep)) {
        pendingCitPrefix = s.chap;
        parts.push(
          `<span class="wref">`
          + `<span class="wref-orig">${s.abbr}</span>`
          + `<span class="wref-lat"><em>${s.latin}</em>${titleSuffix}</span>`
          + `<span class="wref-eng"><em>${s.english}</em>${titleSuffix}</span>`
          + `</span>`
        );
      } else {
        pendingCitPrefix = '';
        parts.push(
          `<span class="wref">`
          + `<span class="wref-orig">${s.abbr}${s.chap}</span>`
          + `<span class="wref-lat"><em>${s.latin}</em>${titleSuffix} ${s.chap}</span>`
          + `<span class="wref-eng"><em>${s.english}</em>${titleSuffix} ${s.chap}</span>`
          + `</span>`
        );
      }
      continue;
    }

    // ── text ──────────────────────────────────────────────────────────────────
    if (s.kind === 'text') {
      // Error 5: chapter-continuation refs directly after a citation.
      // Pattern: ". [bookLetter]chapter." e.g. ". 5." or ". ε7."
      if (afterCit) {
        const mc = s.content.match(/^\.\s*([α-ω]?)(\d+)\.\s*$/);
        if (mc) {
          const book = mc[1];
          const chap = mc[2];
          const bookChanged = !!book && book !== currentBook;
          if (book) currentBook = book;
          const sep = bookChanged ? '; ' : '. ';
          parts.push(`${sep}${book}${book ? ' ' : ''}${chap}.`);
          afterCit = false;
          continue;
        }
      }

      // Detect split citation: text ends with a bare Bekker page number and the
      // immediately following segment is only the sub-page portion.
      const nextIsSplitCit = next?.kind === 'cit' && /^[ab]\d+/.test(next.content);
      if (nextIsSplitCit) {
        const mt = s.content.match(/^(.*?)(\d{3,4})\s*$/);
        if (mt) {
          pendingCitPrefix = mt[2];
          parts.push(mt[1]);
          afterCit = false;
          continue;
        }
      }

      afterCit = false;
      parts.push(s.content);
      continue;
    }

    // ── other segment kinds ───────────────────────────────────────────────────
    afterCit = false;
    pendingCitPrefix = '';

    if (s.kind === 'unclear') {
      parts.push(`<span class="unclear">${s.content}</span>`);
    } else if (s.kind === 'latin_abbr') {
      parts.push(
        `<span class="labbr">`
        + `<span class="labbr-lat">${s.abbr}</span>`
        + `<span class="labbr-eng">${s.english}</span>`
        + `</span>`
      );
    } else if (s.kind === 'lat') {
      parts.push(
        `<span class="lat-prose">`
        + `<span class="lat-prose-lat">${s.latin}</span>`
        + `<span class="lat-prose-eng">${s.english}</span>`
        + `</span>`
      );
    }
  }

  return parts.join('');
}

function renderSenses(senses: Sense[]): string {
  return `<ol class="senses">${senses.map(s =>
    `<li class="sense"><span class="sense-n">${s.n}.</span> `
    + renderSegments(s.segments)
    + (s.children ? renderSenses(s.children) : '')
    + `</li>`
  ).join('')}</ol>`;
}

function renderBlocks(blocks: Block[], lemma?: string): string {
  // Single plain-text block → inline lemma + text
  if (blocks.length === 1 && blocks[0].kind === 'segments') {
    const inner = renderSegments(blocks[0].segments);
    return lemma
      ? `<p class="entry-text"><strong class="entry-lemma">${lemma}</strong> <span>${inner}</span></p>`
      : `<p class="entry-text">${inner}</p>`;
  }
  // Multiple blocks (merged across columns) or a senses block → lemma head + blocks
  let html = lemma ? `<p class="entry-lemma-head"><strong>${lemma}</strong></p>` : '';
  for (const b of blocks) {
    html += b.kind === 'senses'
      ? renderSenses(b.senses)
      : `<p class="entry-text">${renderSegments(b.segments)}</p>`;
  }
  return html;
}
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>Bonitz Index Aristotelicus — α</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="theme-btn"><ThemeToggle /></div>

  <main class="page">
    <header class="masthead">
      <p class="eyebrow">Aristotle</p>
      <h1>Index Aristotelicus</h1>
      <p class="subtitle">Hermann Bonitz, 1870</p>
      <p class="wip-note">
        <strong>Work in progress.</strong> Section α, pages {pageFirst}–{pageLast} —
        {entryCount} entries through <span class="greek-inline">{lastLemma}</span>.
        Transcribed by Claude Opus 4.8.
      </p>
    </header>

    <div class="toolbar">
      <nav class="breadcrumb">
        <a href={`${base}/`}>← Works</a>
      </nav>
      <div class="toolbar-right">
        <div class="bulk" id="bulk" role="group" aria-label="Expand or collapse all">
          <button class="bulk-btn" data-act="expand" title="Expand all entries">Expand all</button>
          <button class="bulk-btn" data-act="collapse" title="Collapse all entries">Collapse all</button>
        </div>
        <div class="lang-toggle" id="lang-toggle" role="group" aria-label="Display language">
          <button class="lang-btn active" data-mode="latin" title="Show Latin titles">Latin</button>
          <button class="lang-btn" data-mode="english" title="Show English titles">English</button>
        </div>
      </div>
    </div>

    {navBuckets.length > 1 && (
      <nav class="letter-nav" aria-label="Jump to entries by initial letters">
        {navBuckets.map(b => <a class="letter-chip" href={`#b-${b}`}>{b}</a>)}
      </nav>
    )}

    <div class="search-bar">
      <input
        id="lemma-search"
        type="search"
        placeholder="ἀβέβαιος or abebaioc…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
      <p class="search-hint" id="search-hint" aria-live="polite"></p>
    </div>

    <div class="index-col" id="index-col" data-mode="latin">
      {flat.map((f, i) => {
        const anchorId = anchorFor[i] ?? undefined;
        if (f.type === 'section_head') {
          return <h2 class="section-head" id={anchorId}>{f.content}</h2>;
        }
        if (f.type === 'header_gloss') {
          return <div class="intro-gloss" id={anchorId} set:html={renderBlocks(f.blocks)} />;
        }
        if (f.type === 'orphan_cont') {
          return (
            <div class="card continuation" id={anchorId}>
              <p class="cont-label">↳ continued from previous page</p>
              <div class="card-body" set:html={renderBlocks(f.blocks)} />
            </div>
          );
        }
        return (
          <details class="card" data-lemma={f.lemma} id={anchorId}>
            <summary class="lemma">
              {f.lemma}
              <span class="chev" aria-hidden="true" />
            </summary>
            <div class="card-body" set:html={renderBlocks(f.blocks, f.lemma)} />
          </details>
        );
      })}
    </div>

    <footer class="page-foot">
      <p>Source: Bonitz, <em>Index Aristotelicus</em>, Berlin 1870, pp. {pageFirst}–{pageLast}. OCR: Claude Opus 4.8.</p>
    </footer>
  </main>

  <script>
    const col = document.getElementById('index-col')!;

    // Lang toggle
    const langBtns = document.querySelectorAll<HTMLButtonElement>('.lang-btn');
    langBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode!;
        col.dataset.mode = mode;
        langBtns.forEach(b => b.classList.toggle('active', b.dataset.mode === mode));
      });
    });

    // Expand / collapse all
    const allCards = () => Array.from(col.querySelectorAll<HTMLDetailsElement>('details.card'));
    document.querySelectorAll<HTMLButtonElement>('.bulk-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const open = btn.dataset.act === 'expand';
        allCards().forEach(d => { if (!d.hidden) d.open = open; });
      });
    });

    // Beta Code fold — mirrors search.ts greekFold()
    const GREEK_BETA: Record<string, string> = {
      α:'a',β:'b',γ:'g',δ:'d',ε:'e',ζ:'z',η:'h',θ:'q',ι:'i',κ:'k',
      λ:'l',μ:'m',ν:'n',ξ:'c',ο:'o',π:'p',ρ:'r',σ:'s',ς:'s',τ:'t',
      υ:'u',φ:'f',χ:'x',ψ:'y',ω:'w',
    };
    function fold(input: string): string {
      const out: string[] = [];
      for (const ch of input.normalize('NFD')) {
        const lo = ch.toLowerCase();
        if (GREEK_BETA[lo]) out.push(GREEK_BETA[lo]);
        else if (lo >= 'a' && lo <= 'z') out.push(lo);
      }
      return out.join('');
    }

    // Lemma search
    const input = document.getElementById('lemma-search') as HTMLInputElement;
    const hint  = document.getElementById('search-hint')!;
    const cards = Array.from(col.querySelectorAll<HTMLElement>('.card[data-lemma]'));
    const folded = cards.map(c => fold(c.dataset.lemma ?? ''));

    input.addEventListener('input', () => {
      const q = fold(input.value.trim());
      let visible = 0;
      cards.forEach((card, i) => {
        const show = !q || folded[i].includes(q);
        card.hidden = !show;
        if (show) visible++;
      });
      hint.textContent = q ? `${visible} entr${visible === 1 ? 'y' : 'ies'} found` : '';
    });
  </script>

  <style>
    body { background: var(--page-bg); color: var(--text); min-height: 100vh; }
    .theme-btn { position: fixed; top: 1rem; right: 1rem; z-index: 10; }

    .page {
      max-width: 52rem;
      margin: 0 auto;
      padding: clamp(2rem, 7vh, 5rem) 1.5rem 4rem;
    }

    /* ── Header ── */
    .masthead { text-align: center; margin-bottom: 1.5rem; }
    .eyebrow {
      font-family: var(--font-ui);
      text-transform: uppercase;
      letter-spacing: .28em;
      font-size: .72rem;
      color: var(--accent-light);
      margin-bottom: .5rem;
    }
    .masthead h1 {
      font-family: var(--font-greek);
      font-weight: 400;
      font-size: clamp(1.8rem, 5vw, 2.6rem);
      color: var(--text);
    }
    .subtitle {
      font-family: var(--font-english);
      font-style: italic;
      color: var(--text-light);
      font-size: .95rem;
      margin-top: .3rem;
    }
    .wip-note {
      margin: .9rem auto 0;
      max-width: 38rem;
      font-family: var(--font-ui);
      font-size: .82rem;
      color: var(--text-mid);
      line-height: 1.5;
    }
    .greek-inline { font-family: var(--font-greek); font-style: normal; }

    /* ── Toolbar ── */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .toolbar-right { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
    .breadcrumb {
      font-family: var(--font-ui);
      font-size: .85rem;
    }
    .breadcrumb a { color: var(--accent); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .bulk { display: flex; gap: 2px; }
    .bulk-btn {
      font-family: var(--font-ui);
      font-size: .76rem;
      padding: .3rem .6rem;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: transparent;
      color: var(--text-mid);
      cursor: pointer;
      transition: background .12s, color .12s, border-color .12s;
    }
    .bulk-btn:hover { color: var(--accent); border-color: var(--accent-light); }

    .lang-toggle {
      display: flex;
      gap: 2px;
      background: var(--border);
      border-radius: 6px;
      padding: 2px;
    }
    .lang-btn {
      font-family: var(--font-ui);
      font-size: .8rem;
      padding: .3rem .75rem;
      border: none;
      border-radius: 4px;
      background: transparent;
      color: var(--text-mid);
      cursor: pointer;
      transition: background .12s, color .12s;
    }
    .lang-btn.active {
      background: var(--col-bg);
      color: var(--accent);
      font-weight: 600;
    }

    /* ── Letter navigator ── */
    .letter-nav {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      flex-wrap: wrap;
      gap: .35rem;
      padding: .55rem 0;
      margin-bottom: .5rem;
      background: var(--page-bg);
      border-bottom: 1px solid var(--border);
    }
    .letter-chip {
      font-family: var(--font-greek);
      font-size: 1rem;
      line-height: 1;
      padding: .3rem .55rem;
      border: 1px solid var(--border);
      border-radius: 5px;
      color: var(--accent);
      text-decoration: none;
      transition: background .12s, border-color .12s;
    }
    .letter-chip:hover { background: var(--col-bg); border-color: var(--accent-light); }

    /* ── Search bar ── */
    .search-bar { margin-bottom: .75rem; }
    #lemma-search {
      width: 100%;
      font-family: var(--font-greek);
      font-size: 1rem;
      padding: .55rem .85rem;
      border: 1px solid var(--border);
      border-radius: 7px;
      background: var(--col-bg);
      color: var(--text);
      outline: none;
      transition: border-color .15s;
    }
    #lemma-search:focus { border-color: var(--accent-light); }
    #lemma-search::placeholder { color: var(--text-light); }
    .search-hint {
      font-family: var(--font-ui);
      font-size: .78rem;
      color: var(--text-light);
      margin-top: .3rem;
      min-height: 1em;
    }

    /* ── Index column ── */
    .index-col {
      display: flex;
      flex-direction: column;
      gap: .6rem;
    }

    .section-head {
      font-family: var(--font-greek);
      font-size: 2rem;
      font-weight: 400;
      color: var(--accent);
      padding: .5rem 0;
      border-bottom: 1px solid var(--border);
      margin-bottom: .2rem;
      scroll-margin-top: 3.5rem;
    }

    .intro-gloss {
      font-family: var(--font-greek);
      font-size: var(--fs-greek);
      line-height: var(--lh-greek);
      color: var(--text-mid);
      padding: .2rem .2rem .6rem;
      border-bottom: 1px dashed var(--border);
      scroll-margin-top: 3.5rem;
    }

    .card {
      background: var(--col-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      transition: border-color .12s;
      scroll-margin-top: 3.5rem;
    }
    .card:hover { border-color: var(--accent-light); }
    .card[open] { border-color: var(--accent-light); }

    .lemma {
      font-family: var(--font-greek);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--accent);
      padding: .7rem 1.1rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .5rem;
      user-select: none;
    }
    .lemma::-webkit-details-marker { display: none; }

    .chev {
      flex-shrink: 0;
      width: .45rem; height: .45rem;
      border-right: 1.5px solid var(--accent-light);
      border-bottom: 1.5px solid var(--accent-light);
      transform: rotate(45deg) translateY(-2px);
      transition: transform .15s;
    }
    .card[open] .chev { transform: rotate(225deg); }

    .card-body {
      padding: .75rem 1.1rem .9rem;
      border-top: 1px solid var(--border);
    }
    .entry-lemma {
      font-family: var(--font-greek);
      font-weight: 700;
      color: var(--text);
    }
    .entry-text {
      font-family: var(--font-greek);
      font-size: var(--fs-greek);
      line-height: var(--lh-greek);
    }
    .entry-text + .entry-text { margin-top: .5rem; }

    /* ── Bekker citations ── */
    :global(.cit) {
      font-family: var(--font-ui);
      font-size: .78rem;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
      border-radius: 3px;
      padding: .05em .3em;
      letter-spacing: .02em;
      white-space: nowrap;
    }

    /* ── Work references ── */
    :global(.wref) { display: inline; }
    :global(.wref-orig),
    :global(.wref-lat),
    :global(.wref-eng) { font-family: var(--font-ui); font-size: .88rem; }

    :global(#index-col[data-mode="latin"] .wref-orig),
    :global(#index-col[data-mode="latin"] .wref-eng) { display: none; }
    :global(#index-col[data-mode="latin"] .wref-lat)  { display: inline; }

    :global(#index-col[data-mode="english"] .wref-orig),
    :global(#index-col[data-mode="english"] .wref-lat) { display: none; }
    :global(#index-col[data-mode="english"] .wref-eng) { display: inline; }

    /* ── Latin scholarly abbreviations ── */
    :global(.labbr) { display: inline; }
    :global(.labbr-lat),
    :global(.labbr-eng) { font-style: italic; color: var(--text-mid); }

    :global(#index-col[data-mode="latin"] .labbr-eng)   { display: none; }
    :global(#index-col[data-mode="latin"] .labbr-lat)   { display: inline; }
    :global(#index-col[data-mode="english"] .labbr-lat) { display: none; }
    :global(#index-col[data-mode="english"] .labbr-eng) { display: inline; }

    /* ── Latin prose phrases (tagged by Opus) ── */
    :global(.lat-prose) { display: inline; }
    :global(.lat-prose-lat) { font-style: italic; }
    :global(.lat-prose-eng) { font-style: italic; color: var(--text-mid); }

    :global(#index-col[data-mode="latin"] .lat-prose-eng)   { display: none; }
    :global(#index-col[data-mode="latin"] .lat-prose-lat)   { display: inline; }
    :global(#index-col[data-mode="english"] .lat-prose-lat) { display: none; }
    :global(#index-col[data-mode="english"] .lat-prose-eng) { display: inline; }

    :global(.unclear) { color: var(--text-light); font-style: italic; }

    /* ── Sense divisions ── */
    :global(.senses) {
      list-style: none;
      margin: .5rem 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: .45rem;
    }
    :global(.sense) {
      padding-left: 1.5rem;
      position: relative;
      font-family: var(--font-greek);
      font-size: var(--fs-greek);
      line-height: var(--lh-greek);
    }
    :global(.sense-n) {
      position: absolute;
      left: 0;
      font-family: var(--font-ui);
      font-size: .78rem;
      color: var(--accent-light);
      font-weight: 600;
      top: .15em;
    }
    :global(.senses .senses) { margin-top: .3rem; padding-left: .5rem; }
    :global(.senses .senses .sense) { padding-left: 1.75rem; }

    .entry-lemma-head {
      font-family: var(--font-greek);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: .4rem;
    }

    /* ── Continuation cards ── */
    .continuation {
      border-style: dashed;
      opacity: .85;
    }
    .cont-label {
      font-family: var(--font-ui);
      font-size: .74rem;
      color: var(--text-light);
      padding: .35rem 1.1rem .1rem;
      font-style: italic;
    }

    /* ── Footer ── */
    .page-foot {
      margin-top: 2rem;
      font-family: var(--font-ui);
      font-size: .78rem;
      color: var(--text-light);
      text-align: center;
    }

    @media (max-width: 600px) {
      .index-col { padding: 1.25rem 0; }
    }
  </style>
</body>
</html>
