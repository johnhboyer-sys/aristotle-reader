---
import { readFileSync } from 'node:fs';
import Reader from '../../components/Reader.svelte';
import BekkerJump from '../../components/BekkerJump.svelte';
import '../../styles/global.css';

export function getStaticPaths() {
  return Array.from({ length: 10 }, (_, i) => ({ params: { n: String(i + 1) } }));
}

const n = Number(Astro.params.n);
const romanNumerals = ['I','II','III','IV','V','VI','VII','VIII','IX','X'];
const bookLabel = romanNumerals[n - 1] ?? String(n);

interface ChapterRef { chapter: string; column: string; line: string; }
const allChapters: Record<string, ChapterRef[]> = JSON.parse(
  readFileSync('public/data/chapters.json', 'utf-8'),
);
const chapters = allChapters[String(n)] ?? [];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nicomachean Ethics · Book {bookLabel}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="page-header">
    <h1><a href="/" style="text-decoration:none;color:inherit">Nicomachean Ethics</a></h1>
    <BekkerJump client:load />
    <nav class="book-nav" aria-label="Navigation">
      {Array.from({ length: 10 }, (_, i) => (
        <a
          href={`/book/${i + 1}`}
          class={i + 1 === n ? 'current' : ''}
          aria-current={i + 1 === n ? 'page' : undefined}
        >
          {['I','II','III','IV','V','VI','VII','VIII','IX','X'][i]}
        </a>
      ))}
      <a href="/search" class="search-link">Search</a>
      <a href="/attribution" class="search-link">Texts &amp; Licences</a>
    </nav>
    {chapters.length > 0 && (
      <nav class="chapter-nav" aria-label={`Book ${bookLabel} chapters`}>
        <span class="chapter-nav-label">Book {bookLabel} · Chapters</span>
        {chapters.map((c) => (
          <a href={`#ch-${n}-${c.chapter}`} title={`Chapter ${c.chapter} · ${c.bekker}`}>{c.chapter}</a>
        ))}
      </nav>
    )}
  </header>

  <Reader bookNum={n} client:load />
</body>
</html>
