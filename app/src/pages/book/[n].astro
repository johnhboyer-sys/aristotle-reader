---
import Reader from '../../components/Reader.svelte';
import '../../styles/global.css';

export function getStaticPaths() {
  return Array.from({ length: 10 }, (_, i) => ({ params: { n: String(i + 1) } }));
}

const n = Number(Astro.params.n);
const romanNumerals = ['I','II','III','IV','V','VI','VII','VIII','IX','X'];
const bookLabel = romanNumerals[n - 1] ?? String(n);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nicomachean Ethics · Book {bookLabel}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="page-header">
    <h1>Nicomachean Ethics</h1>
    <nav class="book-nav" aria-label="Books">
      {Array.from({ length: 10 }, (_, i) => (
        <a
          href={`/book/${i + 1}`}
          class={i + 1 === n ? 'current' : ''}
          aria-current={i + 1 === n ? 'page' : undefined}
        >
          {['I','II','III','IV','V','VI','VII','VIII','IX','X'][i]}
        </a>
      ))}
    </nav>
  </header>

  <Reader bookNum={n} client:load />
</body>
</html>
