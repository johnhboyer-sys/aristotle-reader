---
import { WORKS, workPath } from '../lib/works';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (work: string, q = '') => `${base}${workPath(work)}${q}`;
// Where "report an error / suggest" points — John's x.com.
const FEEDBACK_URL = 'https://x.com/johnhboyer';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>The Aristotle Reader</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body class="home">
  <div class="home-theme"><ThemeToggle /></div>
  <main class="corpus">
    <header class="masthead">
      <p class="eyebrow">Aristotle</p>
      <h1>The Aristotle Reader</h1>
      <p class="lede">A parallel-text reader with morphology, dictionary, and Bekker citation. Choose a work to begin.</p>
      <p class="wip-note">
        <strong>Work in progress.</strong> The corpus is expanding and the
        translation alignment is still being refined. Spotted an error or have a
        suggestion? <a href={FEEDBACK_URL}>Let me know</a>.
      </p>
    </header>

    <a class="search-card" href={`${base}/search`}>
      <span class="search-card-name">Search the Corpus</span>
      <span class="search-card-meta">Greek &amp; English · all works</span>
      <span class="chev-right" aria-hidden="true">›</span>
    </a>

    <hr class="home-rule" />
    <h2 class="works-heading">Open a Work</h2>

    <ul class="works">
      {WORKS.map((w) => (
        <li>
          <details class="work">
            <summary>
              <span class="work-name">{w.title}</span>
              <span class="work-meta">{w.abbr} · {w.books} book{w.books > 1 ? 's' : ''}</span>
              <span class="chev" aria-hidden="true"></span>
            </summary>
            <div class="panel">
              <p class="blurb">{w.blurb}</p>
              <ul class="editions">
                {w.translations.map((t) => (
                  <li>
                    <a href={href(w.id, `?trans=${t.id}`)}>
                      <span class="ed-name">{t.short}</span>
                      <span class="ed-kind">Greek &amp; English · {t.name}</span>
                    </a>
                  </li>
                ))}
                {w.translations.length > 1 && (
                  <li>
                    <a href={href(w.id, '?trans=compare')}>
                      <span class="ed-name">Compare</span>
                      <span class="ed-kind">Both translations side by side</span>
                    </a>
                  </li>
                )}
                <li>
                  <a href={href(w.id, '?view=greek')}>
                    <span class="ed-name">Greek only</span>
                    <span class="ed-kind">{w.greekEdition}</span>
                  </a>
                </li>
              </ul>
            </div>
          </details>
        </li>
      ))}
    </ul>

    <nav class="home-foot">
      <a href={`${base}/search`}>Search the corpus</a>
      <span aria-hidden="true">·</span>
      <a href={`${base}/attribution`}>Texts &amp; Licences</a>
      <span aria-hidden="true">·</span>
      <a href={FEEDBACK_URL}>Suggest / report an error</a>
    </nav>
  </main>
  <style>
    .wip-note {
      margin: 1rem auto 0;
      max-width: 40rem;
      font-size: 0.85rem;
      line-height: 1.5;
      opacity: 0.8;
    }
    .wip-note a { text-decoration: underline; }
  </style>

  <style>
    body.home { background: var(--page-bg); color: var(--text); }
    .home-theme { position: fixed; top: 1rem; right: 1rem; z-index: 10; }
    .corpus {
      max-width: 40rem;
      margin: 0 auto;
      padding: clamp(2.5rem, 8vh, 6rem) 1.5rem 4rem;
    }
    .masthead { text-align: center; margin-bottom: 2.75rem; }
    .eyebrow {
      font-family: var(--font-ui);
      text-transform: uppercase;
      letter-spacing: .28em;
      font-size: .72rem;
      color: var(--accent-light);
      margin-bottom: .6rem;
    }
    .masthead h1 {
      font-family: var(--font-greek);
      font-weight: 400;
      font-size: clamp(2.1rem, 6vw, 2.9rem);
      letter-spacing: .01em;
      color: var(--text);
    }
    .lede {
      font-family: var(--font-english);
      color: var(--text-mid);
      font-size: 1.02rem;
      max-width: 28rem;
      margin: .9rem auto 0;
      line-height: 1.5;
    }

    .search-card {
      display: flex;
      align-items: baseline;
      gap: .75rem;
      background: var(--col-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.05rem 1.3rem;
      text-decoration: none;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .search-card:hover { border-color: var(--accent-light); box-shadow: 0 6px 22px rgba(0,0,0,.05); }
    .search-card-name {
      font-family: var(--font-english);
      font-weight: 600;
      font-size: 1.2rem;
      color: var(--accent);
    }
    .search-card-meta {
      font-family: var(--font-ui);
      font-size: .76rem;
      letter-spacing: .04em;
      color: var(--text-light);
      text-transform: uppercase;
    }
    .search-card .chev-right {
      margin-left: auto;
      align-self: center;
      color: var(--text-light);
      font-size: 1.5rem;
      line-height: 1;
    }
    .search-card:hover .chev-right { color: var(--accent-light); }

    .home-rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 1.6rem 0 1.3rem;
    }
    .works-heading {
      font-family: var(--font-ui);
      font-size: .78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--text-light);
      margin-bottom: 1rem;
    }

    .works { list-style: none; display: flex; flex-direction: column; gap: .9rem; }

    .work {
      background: var(--col-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .work[open] { box-shadow: 0 6px 22px rgba(0,0,0,.05); border-color: var(--accent-light); }
    .work:hover { border-color: var(--accent-light); }

    summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: baseline;
      gap: .75rem;
      padding: 1.05rem 1.3rem;
      user-select: none;
    }
    summary::-webkit-details-marker { display: none; }
    .work-name {
      font-family: var(--font-greek);
      font-size: 1.4rem;
      color: var(--text);
    }
    .work-meta {
      font-family: var(--font-ui);
      font-size: .76rem;
      letter-spacing: .04em;
      color: var(--text-light);
      text-transform: uppercase;
    }
    .chev {
      margin-left: auto;
      width: .5rem; height: .5rem;
      border-right: 1.5px solid var(--text-light);
      border-bottom: 1.5px solid var(--text-light);
      transform: rotate(45deg) translateY(-2px);
      transition: transform .18s ease;
      align-self: center;
    }
    .work[open] .chev { transform: rotate(225deg); }

    .panel { padding: 0 1.3rem 1.1rem; }
    .blurb {
      font-family: var(--font-english);
      color: var(--text-mid);
      font-size: .98rem;
      margin: 0 0 .85rem;
      padding-top: .25rem;
      border-top: 1px solid var(--border);
    }
    .editions { list-style: none; display: flex; flex-direction: column; gap: .35rem; }
    .editions a {
      display: flex;
      flex-direction: column;
      gap: .1rem;
      padding: .55rem .7rem;
      border-radius: 6px;
      text-decoration: none;
      color: var(--text);
      transition: background .12s ease;
    }
    .editions a:hover { background: var(--page-bg); }
    .ed-name {
      font-family: var(--font-english);
      font-weight: 600;
      font-size: 1rem;
      color: var(--accent);
    }
    .ed-kind {
      font-family: var(--font-ui);
      font-size: .78rem;
      color: var(--text-light);
    }

    .home-foot {
      margin-top: 2.5rem;
      text-align: center;
      font-family: var(--font-ui);
      font-size: .85rem;
      color: var(--text-light);
      display: flex; justify-content: center; gap: .7rem;
    }
    .home-foot a { color: var(--text-mid); text-decoration: none; }
    .home-foot a:hover { color: var(--accent); }
  </style>
</body>
</html>
