---
import { AUTHENTICITY_LABEL, CATEGORIES, DIVISION_NAMES, workLanding, type Work } from '@shared/lib/works';
import { builtWorkCards, buildDivisions } from '../lib/corpus';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { publicDir } from 'astro:config/server';
import plates from '../data/plates.json';
import BFonts from '../components/BFonts.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
import { shareCard } from '../lib/og';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read the complete works of Aristotle with the original Greek and a facing' +
  ' English translation, side by side — with click-to-parse morphology,' +
  ' dictionary lookup, Bekker citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/${shareCard()}`, Astro.site).href : undefined;
// Resolve the corpus taxonomy into per-division view models (../lib/corpus).
// Each card row becomes a single tappable card; the editions/translations live
// on the work's landing page (/<work>).
const divisions = buildDivisions(CATEGORIES);
const hangs = (text = '') => /^[\u1F08-\u1F0F\u1F18-\u1F1D\u1F28-\u1F2F\u1F38-\u1F3F\u1F48-\u1F4D\u1F59-\u1F5F\u1F68-\u1F6F\u1FEC]/.test(text);
const subjectRanges = ['1–184', '184–980', '980–1093', '1094–1353', '1354–1462'];
// The bust is cut to its ink box in the desk plate (scripts/measure-plate-ink.mjs).
const ink = plates.home.ink;
const extent = (w: Work) => {
  const chapters: Record<string, {chapter: string; column: string; line: string}[]> = JSON.parse(readFileSync(fileURLToPath(new URL(`data/${w.id}/chapters.json`, publicDir)), 'utf8'));
  const n = Object.values(chapters).reduce((sum, book) => sum + book.length, 0);
  return `${w.books > 1 ? `${w.books} books, ` : ''}${n} chapter${n === 1 ? '' : 's'}`;
};

// Structured data: identify the site (WebSite) and enumerate every built work as
// an ItemList of CreativeWorks linking to its landing page. This tells Google the
// home page is the hub for the whole corpus, reinforcing the per-work pages that
// carry the long-tail "<work> greek & english" queries. Absolute URLs need
// Astro.site (set in config); emitted only when present.
const builtWorks = builtWorkCards(divisions);
const extents = Object.fromEntries(builtWorks.map(c => [c.work.id, extent(c.work)]));
const structuredData = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'The Aristotle Reader',
        alternateName: 'Aristotle in Greek & English',
        url: new URL(`${base}/`, Astro.site).href,
        description: homeDescription,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'The Works of Aristotle',
        numberOfItems: builtWorks.length,
        itemListElement: builtWorks.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.work.title,
          url: new URL(`${base}${workLanding(c.work.id)}/`, Astro.site).href,
        })),
      },
    ]
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Google Search Console ownership verification (URL-prefix property). -->
  <meta name="google-site-verification" content="tlPYj47QxxAGIB0RGMjr2fycUYsaqZK-yeOj9SmIjE4" />
  <script is:inline>
    document.documentElement.classList.add('poster-fitting');
    setTimeout(() => document.documentElement.classList.remove('poster-fitting'), 3000);
  </script>
  <ThemeInit />
  <Pwa />
  <title>The Aristotle Reader — Complete Works in Greek &amp; English</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Aristotle Reader — Complete Works in Greek & English" />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="The Aristotle Reader — Complete Works in Greek & English" />
  <meta name="twitter:description" content={homeDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {structuredData && structuredData.map((sd) => (
    <script type="application/ld+json" set:html={jsonLdSafe(sd)} />
  ))}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <BFonts />
</head>
<body class="home">
  <CommandPalette client:load />
  <div class="frame dir-b pg-home">
    <div class="b-page">
      <BNav />
      <main>
        <div class="b-top">
        <section class="b-po hero pl dp-paper tp-side pl-l hp-p-side" data-tp="side" data-ts="1" aria-label="The complete works of Aristotle" style={`--ix:${ink[0]};--iy:${ink[1]};--iw:${ink[2] - ink[0]};--ih:${ink[3] - ink[1]}`}>
          <picture class="th-light"><source media="(max-width: 960px)" srcset={`${base}/plates/phone/home.jpg`} width="640" height="558"/><img src={`${base}/plates/desk/home.jpg`} width="1280" height="914" alt={plates.home.alt} loading="lazy" decoding="async"/></picture><picture class="th-dark"><source media="(max-width: 960px)" srcset={`${base}/plates/dark/phone/home.webp`} width="640" height="558"/><img src={`${base}/plates/dark/desk/home.webp`} width="1280" height="914" alt={plates.home.alt} loading="lazy" decoding="async"/></picture>
          <h1 class="b-po-t" data-fit="poster" data-title="The complete works of Aristotle">The complete works of Aristotle</h1>
          <p class="b-gt b-greek-hang" lang="grc" data-fit="line" data-fill>Ἀριστοτέλους ἅπαντα τὰ σῳζόμενα</p>
        </section>
        <section class="b-intro">
          <p class="b-lead">Read and search every work of Aristotle in Greek and English. <span id="touch-verb">Click</span> any Greek word to parse and define it.</p>
          <div class="b-intro-r">
            <div id="resume-slot" data-works={JSON.stringify(Object.fromEntries(builtWorks.map(c => [c.work.id,{title:c.work.title,books:c.work.books,bookLabels:c.work.bookLabels}])))}></div>
            <form class="b-search" action={`${base}/search`} method="get" role="search">
              <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.8" cy="6.8" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.4"/></svg>
              <input name="q" autocomplete="off" spellcheck="false" placeholder="φύσις, justice, ἀρετή …" aria-label="Search the corpus"/><button type="submit">Search</button>
            </form>
          </div>
          <div class="b-resume-work" hidden>
            <a class="b-resume-title"></a><p class="b-resume-location"></p><a class="b-btn pri">Continue reading</a>
          </div>
          <a class="b-resume-passage" hidden><p lang="grc"></p><p lang="en"></p></a>
        </section>
        </div>
        <nav class="b-subjects" aria-label="Subjects">{divisions.map((d,i) => <a href={`#division-${d.numeral}`}><span>{DIVISION_NAMES[d.title]}</span><span class="b-subject-range">{subjectRanges[i]}</span></a>)}</nav>
        {divisions.map(d => <section id={`division-${d.numeral}`} class="b-div" data-division={d.numeral}>
          <h2 class="b-dh">{DIVISION_NAMES[d.title]}</h2>
          <div class="b-dw">{d.groups.map(g => <>
            {g.label && <h3 class="b-sub sub-label">{g.label}</h3>}
            <ul class="b-works">{g.cards.filter(c => c.kind === 'work' && c.work.id !== 'Isa').map(c => c.kind === 'work' && <li><a href={`${base}${workLanding(c.work.id)}`} data-work={c.work.id}>
              <span class="b-wt">{c.work.listTitle ?? c.work.title}{c.work.authenticity && c.work.authenticity !== 'genuine' && <span class="b-tag">{AUTHENTICITY_LABEL[c.work.authenticity]}</span>}</span>
              <span class:list={["b-wg", {"b-greek-hang": hangs(c.work.greekTitle)}]} lang="grc">{c.work.greekTitle}</span><span class="b-we">{extents[c.work.id]}</span>
            </a></li>)}</ul>
          </>)}</div>
        </section>)}
      </main>
      <BFoot />
    </div>
  </div>
  <script is:inline>
    if (matchMedia('(hover: none) and (pointer: coarse)').matches) document.getElementById('touch-verb').textContent = 'Tap';
  </script>
  <script>
    import { fitPoster, initPosters } from '../lib/poster-fit';
    import { lastRead, resumeFor } from '@shared/lib/resume';
    import { fetchBook, fetchChapters, fetchColumns } from '@shared/lib/data';
    import { initReturningLayout, updateTouchVerb, resolveHomePlace } from '../lib/home-resume';

    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const slot = document.getElementById('resume-slot');
    const phoneBand = matchMedia('(max-width: 960px)');
    const touchVerb = () => updateTouchVerb(document, phoneBand.matches);
    touchVerb();
    phoneBand.addEventListener('change', touchVerb);
    async function resume() {
      if (!slot) return;
      const works = JSON.parse(slot.dataset.works || '{}');
      const last = lastRead(w => Object.hasOwn(works,w)) ?? (matchMedia('(min-width: 961px)').matches ? Object.keys(works).map(work => {
        const pos = resumeFor(work); return pos ? { work, ...pos } : null;
      }).find(Boolean) : null);
      if (!last) return;
      const w = works[last.work];
      let book = Math.min(Math.max(1,last.book),w.books);
      let cite = last.cite;
      let chapter: string | undefined;
      if (cite) {
        try {
          const [chapters, columns] = await Promise.all([fetchChapters(last.work), fetchColumns(last.work)]);
          const place = resolveHomePlace(book, cite, chapters, columns);
          ({ book, cite, chapter } = place);
        } catch { cite = null; }
      }
      {
        const top = document.querySelector<HTMLElement>('.b-top')!;
        initReturningLayout(top, phoneBand, () => fitPoster(top.querySelector<HTMLElement>('h1')!));
        const resume = top.querySelector<HTMLElement>('.b-resume-work')!;
        const href = `${base}/${last.work}/book/${book}${cite ? `#${cite}` : ''}`;
        const title = resume.querySelector<HTMLAnchorElement>('.b-resume-title')!;
        title.href = href; title.textContent = w.title;
        const location = resume.querySelector('.b-resume-location')!;
        const showLocation = (chapter?: string) => {
          location.textContent = [
            w.books > 1 ? `Book ${w.bookLabels[book-1]}${chapter ? `, chapter ${chapter}` : ''}` : chapter ? `Chapter ${chapter}` : '', cite,
          ].filter(Boolean).join(' · ');
        };
        showLocation(chapter);
        const button = resume.querySelector<HTMLAnchorElement>('.b-btn')!;
        button.href = href; button.setAttribute('aria-label', `Continue reading ${w.title}`);
        resume.hidden = false;
        if (cite) try {
          const [data, { resumePassage }, { getWork }] = await Promise.all([
            fetchBook(last.work, book),
            import('@shared/lib/resume-passage'),
            import('@shared/lib/works'),
          ]);
          const work = getWork(last.work);
          const passage = work && resumePassage(data, work, cite);
          if (passage) {
            const link = top.querySelector<HTMLAnchorElement>('.b-resume-passage')!;
            link.href = href; link.querySelector('[lang="grc"]')!.textContent = passage.greek;
            const english = link.querySelector<HTMLElement>('[lang="en"]')!;
            english.textContent = passage.english; english.hidden = !passage.english;
            link.hidden = false;
          }
        } catch { /* Keep the card alone when the book cannot load. */ }
        return;
      }
    }
    void resume();
    initPosters();
  </script>
</body>
</html>
