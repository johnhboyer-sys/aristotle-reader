---
import { AUTHENTICITY_LABEL, CATEGORIES, DIVISION_NAMES, workLanding, type Work } from '@shared/lib/works';
import { builtWorkCards, buildDivisions } from '../lib/corpus';
import { readFileSync } from 'node:fs';
import plates from '../data/plates.json';
import BFonts from '../components/BFonts.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '@shared/styles/b.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read the complete works of Aristotle with the original Greek and a facing' +
  ' English translation, side by side — with click-to-parse morphology,' +
  ' dictionary lookup, Bekker citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
// Resolve the corpus taxonomy into per-division view models (../lib/corpus).
// Each card row becomes a single tappable card; the editions/translations live
// on the work's landing page (/<work>).
// Dubious and spurious works follows the numbered divisions.
const divisions = buildDivisions(CATEGORIES);
const extent = (w: Work) => {
  const chapters: Record<string, unknown[]> = JSON.parse(readFileSync(`public/data/${w.id}/chapters.json`, 'utf8'));
  const n = Object.values(chapters).reduce((sum, book) => sum + book.length, 0);
  return `${w.books > 1 ? `${w.books} books, ` : ''}${n} chapter${n === 1 ? '' : 's'}`;
};
const navLinks = [['/', 'Works'], ['/search', 'Search'], ['/lemma/', 'Lexicon'], ['/phrases', 'Phrases'], ['/support', 'Support']];

// Structured data: identify the site (WebSite) and enumerate every built work as
// an ItemList of CreativeWorks linking to its landing page. This tells Google the
// home page is the hub for the whole corpus, reinforcing the per-work pages that
// carry the long-tail "<work> greek & english" queries. Absolute URLs need
// Astro.site (set in config); emitted only when present.
const builtWorks = builtWorkCards(divisions);
const structuredData = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'The Aristotle Reader',
        alternateName: 'Aristotle in Greek & English',
        url: new URL(`${base}/`, Astro.site).href,
        description: homeDescription,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'The Works of Aristotle',
        numberOfItems: builtWorks.length,
        itemListElement: builtWorks.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.work.title,
          url: new URL(`${base}${workLanding(c.work.id)}/`, Astro.site).href,
        })),
      },
    ]
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Google Search Console ownership verification (URL-prefix property). -->
  <meta name="google-site-verification" content="tlPYj47QxxAGIB0RGMjr2fycUYsaqZK-yeOj9SmIjE4" />
  <ThemeInit />
  <Pwa />
  <title>The Aristotle Reader — Complete Works in Greek &amp; English</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Aristotle Reader — Complete Works in Greek & English" />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="The Aristotle Reader — Complete Works in Greek & English" />
  <meta name="twitter:description" content={homeDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {structuredData && structuredData.map((sd) => (
    <script type="application/ld+json" set:html={jsonLdSafe(sd)} />
  ))}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <BFonts />
</head>
<body class="home">
  <CommandPalette client:load />
  <div class="frame dir-b">
    <div class="b-page">
      <header class="b-nav">
        <a class="b-brand" href={`${base}/`}>Aristotle Reader</a>
        <nav class="b-links" aria-label="Site">
          {navLinks.map(([href, label]) => <a href={`${base}${href}`} class={href === '/' ? 'on' : ''}>{label}</a>)}
          <ThemeToggle bMoon />
          <a class="b-ib b-only-s" href={`${base}/search`} aria-label="Search"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.8" cy="6.8" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.4"/></svg></a>
          <details class="b-sm b-only-s"><summary aria-label="Menu"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.4"/></svg></summary><div class="b-sm-p">{navLinks.map(([href,label]) => <a href={`${base}${href}`} aria-current={href === '/' ? 'page' : undefined}>{label}</a>)}</div></details>
        </nav>
      </header>
      <main>
        <section class="b-po hero pl dp-paper tp-side pl-l hp-p-side" data-tp="side" data-ts="1" aria-label="The complete works of Aristotle">
          <picture><source media="(max-width: 960px)" srcset={`${base}/plates/phone/home.jpg`} width="640" height="558"/><img src={`${base}/plates/desk/home.jpg`} width="1280" height="914" alt={plates.home.alt} decoding="async"/></picture>
          <h1 class="b-po-t" data-fit="poster" data-title="The complete works of Aristotle">The complete works of Aristotle</h1>
        </section>
        <section class="b-intro">
          <p class="b-lead">Parallel Greek–English editions of every work of Aristotle. <span id="touch-verb">Click</span> any Greek word to parse it and see its definition. Search the corpus in Greek and English.</p>
          <div class="b-intro-r">
            <form class="b-search" action={`${base}/search`} method="get" role="search">
              <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.8" cy="6.8" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.4"/></svg>
              <input name="q" autocomplete="off" spellcheck="false" placeholder="φύσις, justice, ἀρετή …" aria-label="Search the corpus"/><button type="submit">Search</button>
            </form>
            <p class="b-cont" id="resume-card" hidden data-works={JSON.stringify(Object.fromEntries(builtWorks.map(c => [c.work.id,{title:c.work.title,books:c.work.books}])))}><a id="resume-link" href={`${base}/EN/book/1`}>Continue reading <span id="resume-meta"></span></a></p>
          </div>
        </section>
        {divisions.map(d => <section class="b-div" data-division={d.numeral || 'appendix'}>
          <h2 class="b-dh">{DIVISION_NAMES[d.title]}</h2>
          <div class="b-dw">{d.groups.map(g => <>
            {g.label && <h3 class="b-sub sub-label">{g.label}</h3>}
            <ul class="b-works">{g.cards.filter(c => c.kind === 'work' && c.work.id !== 'Isa').map(c => c.kind === 'work' && <li><a href={`${base}${workLanding(c.work.id)}`} data-work={c.work.id}>
              <span class="b-wt">{c.work.title}{c.work.authenticity && c.work.authenticity !== 'genuine' && <span class="b-tag">{AUTHENTICITY_LABEL[c.work.authenticity]}</span>}</span>
              <span class="b-wg" lang="grc">{c.work.greekTitle}</span><span class="b-we">{extent(c.work)}</span>
            </a></li>)}</ul>
          </>)}</div>
        </section>)}
      </main>
      <footer class="b-foot">
        <p>Also <a href="https://plato.johnhboyer.com/">The Plato Reader</a><a href="https://homer.johnhboyer.com/">The Homer Reader</a><a href="https://greekdrama.johnhboyer.com/">The Greek Drama Reader</a><a href="https://grammata.pages.dev/">Grammata</a></p>
        <p><a href={`${base}/attribution`}>Texts &amp; licences</a><a href={`${base}/picture-credits/`}>Picture credits</a><a href={`${base}/support`}>Support</a><a href={`${base}/desktop`}>Desktop app</a><a href={`${base}/game/`}>Play a game</a><span>Site by John H. Boyer</span></p>
      </footer>
    </div>
  </div>
  <script is:inline>
    if (matchMedia('(hover: none) and (pointer: coarse)').matches) document.getElementById('touch-verb').textContent = 'Tap';
  </script>
  <script>
    import { initPosters } from '../lib/poster-fit';
    import { citeShown, lastRead } from '@shared/lib/resume';
    initPosters();
    const card = document.getElementById('resume-card');
    if (card) {
      const works = JSON.parse(card.dataset.works || '{}');
      const last = lastRead(w => Object.hasOwn(works,w));
      if (last) {
        const w = works[last.work];
        const book = Math.min(Math.max(1,last.book),w.books);
        const bookBit = w.books > 1 ? ` · Book ${book}` : '';
        const citeBit = last.cite ? ` · ${citeShown(last.work,last.cite)}` : '';
        document.getElementById('resume-meta')!.textContent = `${w.title}${bookBit}${citeBit}`;
        const base = import.meta.env.BASE_URL.replace(/\/$/, '');
        (document.getElementById('resume-link') as HTMLAnchorElement).href = `${base}/${last.work}/book/${book}${last.cite ? `#${last.cite}` : ''}`;
        card.hidden = false;
      }
    }
  </script>
</body>
</html>
