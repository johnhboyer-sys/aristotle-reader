---
import { CATEGORIES, getWork, workPath, visibleTranslations, type Work } from '../lib/works';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (work: string, q = '') => `${base}${workPath(work)}${q}`;

// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read the complete works of Aristotle with the original Greek and a facing' +
  ' English translation, side by side — with click-to-parse morphology,' +
  ' dictionary lookup, Bekker citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
// Flatten the corpus taxonomy into a single render sequence: category and
// sub-category headings interleaved with work cards (existing works) and
// "coming soon" placeholders (works not yet added). Nesting is visual (headings
// + indentation), so all styling stays in this one file.
type Row =
  | { kind: 'cat'; numeral: string; title: string }
  | { kind: 'sub'; ref: string; label: string }
  | { kind: 'work'; work: Work }
  | { kind: 'soon'; title: string };

const rows: Row[] = [];
for (const cat of CATEGORIES) {
  rows.push({ kind: 'cat', numeral: cat.numeral, title: cat.title });
  const add = (ws: { id?: string; title?: string }[]) => {
    for (const cw of ws) {
      const w = cw.id ? getWork(cw.id) : undefined;
      if (w) rows.push({ kind: 'work', work: w });
      else if (cw.title) rows.push({ kind: 'soon', title: cw.title });
    }
  };
  if (cat.works) add(cat.works);
  for (const sub of cat.subcategories ?? []) {
    rows.push({ kind: 'sub', ref: sub.ref, label: sub.label });
    add(sub.works);
  }
}
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Google Search Console ownership verification (URL-prefix property). -->
  <meta name="google-site-verification" content="tlPYj47QxxAGIB0RGMjr2fycUYsaqZK-yeOj9SmIjE4" />
  <ThemeInit />
  <title>The Aristotle Reader — Complete Works in Greek &amp; English</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Aristotle Reader — Complete Works in Greek & English" />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body class="home">
  <div class="home-theme"><ThemeToggle /></div>
  <main class="corpus">
    <header class="masthead">
      <p class="eyebrow">Aristotle</p>
      <h1>The Aristotle Reader</h1>
      <p class="lede">A parallel-text reader with morphology, dictionary, and Bekker citation. Choose a work to begin.</p>
      <p class="wip-note">
        <strong>Work in progress.</strong> The translation alignment is still
        being refined. Spotted an error or have a suggestion?
        <button id="feedback-btn-wip" style="background:none;border:none;padding:0;cursor:pointer;font:inherit;color:var(--accent);text-decoration:underline;">Let me know</button>.
      </p>
    </header>

    <a class="search-card" href={`${base}/search`}>
      <span class="search-card-name">Search the Corpus</span>
      <span class="search-card-meta">Greek &amp; English · all works</span>
      <span class="chev-right" aria-hidden="true">›</span>
    </a>

    <hr class="home-rule" />
    <h2 class="works-heading">Open a Work</h2>

    <div class="toc">
      {rows.map((r) => (
        r.kind === 'cat' ? (
          <h3 class="cat-head"><span class="cat-num">{r.numeral}.</span> {r.title}</h3>
        ) : r.kind === 'sub' ? (
          <h4 class="subcat-head"><span class="subcat-ref">{r.ref}</span> {r.label}</h4>
        ) : r.kind === 'work' ? (
          <details class="work">
            <summary>
              <div class="work-text">
                <span class="work-name">{r.work.title}</span>
                <span class="work-blurb">{r.work.blurb}</span>
              </div>
              <div class="work-right">
                <span class="work-meta">{r.work.abbr} · {r.work.books} book{r.work.books > 1 ? 's' : ''}</span>
                <span class="chev" aria-hidden="true"></span>
              </div>
            </summary>
            <div class="panel">
              <ul class="editions">
                {visibleTranslations(r.work).map((t) => (
                  <>
                    <li>
                      <a href={href(r.work.id, `?trans=${t.id}`)}>
                        <span class="ed-name">{t.short}</span>
                        <span class="ed-kind">Greek &amp; English · {t.name}</span>
                      </a>
                    </li>
                    {/* Ostwald's edition (EN only) carries a glossary of technical
                        terms — a standalone reference page, shown under its entry. */}
                    {t.id === 'ostwald' && (
                      <li>
                        <a href={`${base}/EN/glossary`}>
                          <span class="ed-name">Glossary of Technical Terms</span>
                          <span class="ed-kind">Ostwald’s Greek–English term glossary</span>
                        </a>
                      </li>
                    )}
                  </>
                ))}
                {visibleTranslations(r.work).length > 1 && (
                  <li>
                    <a href={href(r.work.id, '?trans=compare')}>
                      <span class="ed-name">Compare</span>
                      <span class="ed-kind">Both translations side by side</span>
                    </a>
                  </li>
                )}
                <li>
                  <a href={href(r.work.id, '?view=greek')}>
                    <span class="ed-name">Greek only</span>
                    <span class="ed-kind">{r.work.greekEdition}</span>
                  </a>
                </li>
              </ul>
            </div>
          </details>
        ) : (
          <div class="work soon" aria-disabled="true">
            <span class="work-name">{r.title}</span>
            <span class="soon-tag">Coming soon</span>
          </div>
        )
      ))}
    </div>

    <nav class="home-foot">
      <a href={`${base}/search`}>Search the corpus</a>
      <span aria-hidden="true">·</span>
      <a href={`${base}/attribution`}>Texts &amp; Licences</a>
      <span aria-hidden="true">·</span>
      <button id="feedback-btn">Request a Feature / Report an Error</button>
      <span aria-hidden="true">·</span>
      <a href="https://x.com/johnhboyer" target="_blank" rel="noopener">Site by John H. Boyer</a>
    </nav>
  </main>
  <style>
    .wip-note {
      margin: 1rem auto 0;
      max-width: 40rem;
      font-size: 0.85rem;
      line-height: 1.5;
      opacity: 0.8;
      text-wrap: pretty;
    }
    .wip-note a { text-decoration: underline; }
  </style>

  <style>
    body.home { background: var(--page-bg); color: var(--text); }
    .home-theme { position: fixed; top: 1rem; right: 1rem; z-index: 10; }
    .corpus {
      max-width: 40rem;
      margin: 0 auto;
      padding: clamp(2.5rem, 8vh, 6rem) 1.5rem 4rem;
    }
    .masthead { text-align: center; margin-bottom: 2.75rem; }
    .eyebrow {
      font-family: var(--font-ui);
      text-transform: uppercase;
      letter-spacing: .28em;
      font-size: .72rem;
      color: var(--accent-light);
      margin-bottom: .6rem;
    }
    .masthead h1 {
      font-family: var(--font-greek);
      font-weight: 400;
      font-size: clamp(2.1rem, 6vw, 2.9rem);
      letter-spacing: .01em;
      color: var(--text);
      text-wrap: balance;
    }
    .lede {
      font-family: var(--font-english);
      color: var(--text-mid);
      font-size: 1.02rem;
      max-width: 28rem;
      margin: .9rem auto 0;
      line-height: 1.5;
      text-wrap: pretty;
    }

    .search-card {
      display: flex;
      align-items: baseline;
      gap: .75rem;
      background: var(--col-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.05rem 1.3rem;
      text-decoration: none;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .search-card:hover { border-color: var(--accent-light); box-shadow: 0 6px 22px rgba(0,0,0,.05); }
    .search-card-name {
      font-family: var(--font-english);
      font-weight: 600;
      font-size: 1.2rem;
      color: var(--accent);
    }
    .search-card-meta {
      font-family: var(--font-ui);
      font-size: .76rem;
      letter-spacing: .04em;
      color: var(--text-light);
      text-transform: uppercase;
    }
    .search-card .chev-right {
      margin-left: auto;
      align-self: center;
      color: var(--text-light);
      font-size: 1.5rem;
      line-height: 1;
    }
    .search-card:hover .chev-right { color: var(--accent-light); }

    .home-rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 1.6rem 0 1.3rem;
    }
    .works-heading {
      font-family: var(--font-ui);
      font-size: .78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--text-light);
      margin-bottom: 1rem;
    }

    .toc { display: flex; flex-direction: column; gap: .55rem; }

    .cat-head {
      font-family: var(--font-greek);
      font-weight: 400;
      font-size: 1.5rem;
      color: var(--text);
      margin: 1.9rem 0 .55rem;
      padding-bottom: .35rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: baseline;
      gap: .55rem;
    }
    .toc > .cat-head:first-child { margin-top: 0; }
    .cat-num {
      font-family: var(--font-ui);
      font-size: .95rem;
      font-weight: 600;
      letter-spacing: .04em;
      color: var(--accent-light);
    }
    .subcat-head {
      font-family: var(--font-ui);
      font-size: .76rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--text-light);
      margin: 1rem 0 .15rem .15rem;
      display: flex;
      align-items: baseline;
      gap: .5rem;
    }
    .subcat-ref { color: var(--accent-light); letter-spacing: .04em; }

    .work {
      background: var(--col-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .work[open] { box-shadow: 0 6px 22px rgba(0,0,0,.05); border-color: var(--accent-light); }
    .work:not(.soon):hover { border-color: var(--accent-light); }

    /* Not-yet-added works: a quiet, non-interactive placeholder. */
    .work.soon {
      display: flex;
      align-items: baseline;
      gap: .75rem;
      padding: .8rem 1.3rem;
      background: transparent;
      border-style: dashed;
      border-color: var(--border);
      cursor: default;
    }
    .work.soon .work-name {
      font-size: 1.15rem;
      color: var(--text-light);
    }
    .work.soon .soon-tag {
      margin-left: auto;
      align-self: center;
      font-family: var(--font-ui);
      font-size: .66rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--text-light);
      opacity: .8;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: .12rem .5rem;
      white-space: nowrap;
    }

    summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .9rem 1.3rem;
      user-select: none;
    }
    summary::-webkit-details-marker { display: none; }
    .work-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .18rem; }
    .work-name {
      font-family: var(--font-greek);
      font-size: 1.3rem;
      color: var(--text);
      line-height: 1.25;
    }
    .work-blurb {
      font-family: var(--font-english);
      font-size: .8rem;
      color: var(--text-light);
      line-height: 1.4;
      text-wrap: pretty;
    }
    .work-right {
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-shrink: 0;
    }
    .work-meta {
      font-family: var(--font-ui);
      font-size: .72rem;
      letter-spacing: .04em;
      color: var(--text-light);
      text-transform: uppercase;
      white-space: nowrap;
    }
    .chev {
      width: .5rem; height: .5rem;
      border-right: 1.5px solid var(--text-light);
      border-bottom: 1.5px solid var(--text-light);
      transform: rotate(45deg) translateY(-2px);
      transition: transform .18s ease;
      flex-shrink: 0;
    }
    .work[open] .chev { transform: rotate(225deg); }

    .panel { padding: 0 1.3rem 1.1rem; border-top: 1px solid var(--border); }
    .editions { list-style: none; display: flex; flex-direction: column; gap: .35rem; margin: 0; padding-top: .65rem; }
    .editions a {
      display: flex;
      flex-direction: column;
      gap: .1rem;
      padding: .55rem .7rem;
      border-radius: 6px;
      text-decoration: none;
      color: var(--text);
      transition: background .12s ease;
    }
    .editions a:hover { background: var(--page-bg); }
    .ed-name {
      font-family: var(--font-english);
      font-weight: 600;
      font-size: 1rem;
      color: var(--accent);
    }
    .ed-kind {
      font-family: var(--font-ui);
      font-size: .78rem;
      color: var(--text-light);
    }

    .home-foot {
      margin-top: 2.5rem;
      text-align: center;
      font-family: var(--font-ui);
      font-size: .85rem;
      color: var(--text-light);
      display: flex; justify-content: center; gap: .7rem;
    }
    .home-foot a { color: var(--text-mid); text-decoration: none; }
    .home-foot a:hover { color: var(--accent); }
    .home-foot button {
      background: none; border: none; padding: 0; cursor: pointer;
      font: inherit; font-size: .85rem; color: var(--text-mid);
    }
    .home-foot button:hover { color: var(--accent); }

    /* Feedback modal */
    #feedback-modal {
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,.45); align-items: center; justify-content: center;
    }
    #feedback-modal.open { display: flex; }
    .fb-box {
      background: var(--page-bg); border: 1px solid var(--rule);
      border-radius: 8px; padding: 1.75rem 2rem; width: min(440px, 90vw);
      font-family: var(--font-ui); box-shadow: 0 8px 32px rgba(0,0,0,.18);
    }
    .fb-box h2 {
      margin: 0 0 1.1rem; font-size: 1rem; font-weight: 600; color: var(--text);
    }
    .fb-type { display: flex; gap: 1.25rem; margin-bottom: 1rem; }
    .fb-type label { display: flex; align-items: center; gap: .4rem; cursor: pointer;
      font-size: .875rem; color: var(--text); }
    .fb-box textarea {
      width: 100%; box-sizing: border-box; min-height: 110px; resize: vertical;
      border: 1px solid var(--rule); border-radius: 4px; padding: .6rem .75rem;
      font-family: var(--font-ui); font-size: .875rem;
      background: var(--page-bg); color: var(--text);
    }
    .fb-box textarea:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .fb-actions { display: flex; justify-content: flex-end; gap: .6rem; margin-top: .9rem; }
    .fb-cancel {
      background: none; border: 1px solid var(--rule); border-radius: 4px;
      padding: .4rem .9rem; cursor: pointer; font: inherit; font-size: .85rem;
      color: var(--text-mid);
    }
    .fb-cancel:hover { border-color: var(--text-mid); }
    .fb-submit {
      background: var(--accent); color: #fff; border: none; border-radius: 4px;
      padding: .4rem 1rem; cursor: pointer; font: inherit; font-size: .85rem;
      font-weight: 600;
    }
    .fb-submit:hover { opacity: .88; }
    .fb-submit:disabled { opacity: .45; cursor: default; }
  </style>

  <!-- Feedback modal -->
  <div id="feedback-modal" role="dialog" aria-modal="true" aria-labelledby="fb-title">
    <div class="fb-box">
      <h2 id="fb-title">Request a Feature / Report an Error</h2>
      <div class="fb-type">
        <label><input type="radio" name="fb-type" value="feature" checked /> Feature request</label>
        <label><input type="radio" name="fb-type" value="bug" /> Bug / error report</label>
      </div>
      <textarea id="fb-message" placeholder="Describe the feature or error…"></textarea>
      <div class="fb-actions">
        <button class="fb-cancel" id="fb-cancel">Cancel</button>
        <button class="fb-submit" id="fb-submit">Send</button>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('feedback-modal')!;
    const openBtn = document.getElementById('feedback-btn')!;
    const cancelBtn = document.getElementById('fb-cancel')!;
    const submitBtn = document.getElementById('fb-submit')!;
    const textarea = document.getElementById('fb-message') as HTMLTextAreaElement;

    const open = () => { modal.classList.add('open'); textarea.value = ''; textarea.focus(); };
    const close = () => modal.classList.remove('open');

    openBtn.addEventListener('click', open);
    document.getElementById('feedback-btn-wip')?.addEventListener('click', open);
    cancelBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    submitBtn.addEventListener('click', () => {
      const msg = textarea.value.trim();
      if (!msg) return;
      const type = (document.querySelector('input[name="fb-type"]:checked') as HTMLInputElement).value;
      const subject = type === 'feature'
        ? 'Aristotle Reader: Feature Request'
        : 'Aristotle Reader: Bug Report';
      window.location.href =
        `mailto:jhboyer@loyno.edu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(msg)}`;
      close();
    });
  </script>
</body>
</html>
