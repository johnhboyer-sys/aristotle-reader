---
// The Greek Lexicon index at /lemma — a crawlable directory of every built lemma
// page, sorted alphabetically by transliteration. Doubles as the DefinedTermSet
// landing and an internal-link hub so the per-lemma pages get discovered.
// A toggle re-sorts the list by occurrence count on the client (?sort=freq);
// the built HTML stays alphabetical.
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import Pwa from '../../components/Pwa.astro';
import BFonts from '../../components/BFonts.astro';
import BNav from '../../components/BNav.astro';
import BFoot from '../../components/BFoot.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import { greekFold } from '@shared/lib/search';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
import { shareCard } from '../../lib/og';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Read the popup manifest (lsjKey -> {slug, head, count}) for the full built set.
const manifest: Record<string, { slug: string; head: string; count: number }> = JSON.parse(
  readFileSync('public/data/lemmata.json', 'utf-8'),
);
// `fold` folds the polytonic head to Beta-Code letters (accent-stripped) so the
// client filter can match it against either Greek or Beta Code input with the
// same greekFold — see the inline script below.
const entries = Object.values(manifest)
  .map((e) => ({ ...e, fold: greekFold(e.head) }))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const pageTitle = "Lexicon of Aristotle’s Greek — Word Frequency & Concordance";
const metaDescription =
  `A growing lexicon of Aristotle's Greek vocabulary: ${entries.length} key terms with` +
  ` LSJ definitions, corpus-wide frequency counts, and every occurrence linked to the` +
  ` parallel Greek–English text with Bekker citation.`;
const canonical = Astro.site ? new URL(`${base}/lemma/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/${shareCard()}`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: "Lexicon of Aristotle’s Greek",
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  hasDefinedTerm: entries.slice(0, 100).map((e) => ({
    '@type': 'DefinedTerm', name: e.head, inLanguage: 'grc',
    ...(canonical ? { url: new URL(`${base}/lemma/${e.slug}/`, Astro.site!).href } : {}),
  })),
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Aristotle Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-lexicon">
  <BNav active="/lemma/" />
  <main class="lxi-body">
    <h1 class="b-h2 lxi-h1">Lexicon of Aristotle’s Greek</h1>
    <div class="lxi-filter">
      <input
        type="search"
        id="lxi-input"
        placeholder="Greek or Beta Code"
        autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
        aria-label="Filter the lexicon by Greek or Beta Code"
      />
      <span class="b-seg" role="group" aria-label="Sort the lexicon">
        <button type="button" data-sort="alpha" aria-pressed="true">A–Ω</button>
        <button type="button" data-sort="freq" aria-pressed="false">Most frequent</button>
      </span>
      <span class="lxi-count" id="lxi-count" aria-live="polite"></span>
    </div>
    <ul class="lxi-grid" id="lxi-grid">
      {entries.map((e) => (
        <li data-fold={e.fold} data-count={e.count}>
          <a href={`${base}/lemma/${e.slug}/`}>
            <span class="lxi-gk" lang="grc">{e.head}</span>
            <span class="lxi-n">{e.count.toLocaleString()}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <BFoot />
  </div>

  <script>
    // Client filter: fold both the built-in `data-fold` (already Beta-folded from
    // the polytonic head at build) and the user's query with the SAME greekFold,
    // so typing polytonic Greek OR Beta Code both match. Prefix match, like a
    // dictionary lookup.
    const GREEK_BETA: Record<string, string> = {
      α:'a',β:'b',γ:'g',δ:'d',ε:'e',ζ:'z',η:'h',θ:'q',ι:'i',κ:'k',
      λ:'l',μ:'m',ν:'n',ξ:'c',ο:'o',π:'p',ρ:'r',σ:'s',ς:'s',τ:'t',
      υ:'u',φ:'f',χ:'x',ψ:'y',ω:'w',ϝ:'v',
    };
    const fold = (s: string) => {
      let out = '';
      for (const ch of s.normalize('NFD')) {
        const lower = ch.toLowerCase();
        if (GREEK_BETA[lower]) out += GREEK_BETA[lower];
        else if (lower >= 'a' && lower <= 'z') out += lower;
      }
      return out;
    };
    const input = document.getElementById('lxi-input') as HTMLInputElement | null;
    const grid = document.getElementById('lxi-grid');
    const countEl = document.getElementById('lxi-count');
    if (input && grid) {
      const items = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
      const total = items.length;
      const apply = () => {
        const q = fold(input.value.trim());
        let shown = 0;
        for (const li of items) {
          const hit = !q || (li.dataset.fold ?? '').startsWith(q);
          li.hidden = !hit;
          if (hit) shown++;
        }
        if (countEl) countEl.textContent = q ? `${shown} of ${total}` : '';
      };
      input.addEventListener('input', apply);
    }

    // Sort toggle. `items` in built order is the alphabetical order; the
    // frequency order breaks ties alphabetically (Array.prototype.sort is stable).
    if (grid) {
      const alpha = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
      const freq = alpha
        .slice()
        .sort((a, b) => Number(b.dataset.count ?? 0) - Number(a.dataset.count ?? 0));
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-sort]'));
      const setSort = (mode: string, push: boolean) => {
        const order = mode === 'freq' ? freq : alpha;
        grid.append(...order);
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.sort === mode));
        if (push) {
          const url = new URL(location.href);
          if (mode === 'freq') url.searchParams.set('sort', 'freq');
          else url.searchParams.delete('sort');
          history.replaceState(null, '', url);
        }
      };
      for (const b of buttons) b.addEventListener('click', () => setSort(b.dataset.sort ?? 'alpha', true));
      if (new URLSearchParams(location.search).get('sort') === 'freq') setSort('freq', false);
    }
  </script>
</body>
</html>
