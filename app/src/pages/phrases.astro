---
import Phrases from '@shared/components/Phrases.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import BFonts from '../components/BFonts.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
import { shareCard } from '../lib/og';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phraseDescription =
  'Browse recurrent two- to five-word Greek phrases across the complete Aristotle' +
  ' corpus, sortable by distinctiveness, frequency, length, or alphabetically,' +
  ' with every occurrence linked by Bekker citation.';
const canonical = Astro.site ? new URL(`${base}/phrases/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/${shareCard()}`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Phrases in Aristotle',
  description: phraseDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Aristotle Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>Phrases in Aristotle</title>
  <meta name="description" content={phraseDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Phrases in Aristotle" />
  <meta property="og:description" content={phraseDescription} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Phrases in Aristotle" />
  <meta name="twitter:description" content={phraseDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-phrases"><div class="b-page">
  <BNav active="/phrases" />

  <Phrases client:load />
  <BFoot />
  </div></div>
</body>
</html>
