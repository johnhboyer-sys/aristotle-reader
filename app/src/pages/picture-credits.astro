---
import { CATEGORIES, getWork, workLanding } from '@shared/lib/works';
import { buildDivisions } from '../lib/corpus';
import plates from '../data/plates.json';
import BFonts from '../components/BFonts.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const works = buildDivisions(CATEGORIES).flatMap(d => [
  ...d.groups.flatMap(g => g.cards.flatMap(c => c.kind === 'work' ? [c.work] : [])),
  ...(d.numeral === 'I' ? [getWork('Isa')!] : []),
]);
const sections = [
  {heading:'The home page', rows:[{id:'home',title:'Aristotle'}]},
  {heading:'The works', rows:works},
];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><ThemeInit/><Pwa/><title>Picture credits — Aristotle Reader</title><link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml"/><BFonts/></head>
<body><CommandPalette client:load/><div class="frame dir-b pg-credits"><div class="b-page"><BNav active=""/><main class="b-pc">
<h1 class="b-pc-h">Picture credits</h1>
{sections.map(({heading,rows}) => <section><h2 class="b-h2">{heading}</h2><ul class="b-pc-l">{rows.map(w => {
 const p = plates[w.id as keyof typeof plates];
 return <li data-plate={w.id}><a href={w.id === 'home' ? `${base}/` : `${base}${workLanding(w.id)}`}><i>{w.title}</i></a><span><span data-credit-part="who">{p.who}</span>, <i data-credit-part="what">{p.what}</i>, <span data-credit-part="when">{p.when}</span>. <span data-credit-part="how">{p.how}</span>. <span data-credit-part="where">{p.where}</span>{p.credit !== null && <>. <span data-holder-credit>{p.credit}</span></>}. <span data-licence>{p.lic}</span>. <a data-record href={p.url}>Record</a></span></li>;
})}</ul></section>)}
</main><BFoot/></div></div></body></html>
