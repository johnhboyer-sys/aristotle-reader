---
// The searches kept in this browser by Save search on the results (ported
// from Plato's saved.astro, in this site's frame). The list itself is
// SavedSearches.svelte; its styles are the block below, under .saved.
import SavedSearches from '@shared/components/SavedSearches.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import BFonts from '../components/BFonts.astro';
import '@shared/styles/global.css';
import '@shared/styles/b.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>Saved searches · Aristotle Reader</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-saved">
    <BNav active="/search" />
    <main class="saved">
      <h1>Saved searches</h1>
      <SavedSearches client:load />
    </main>
    <BFoot />
  </div>
</body>
</html>

<style is:global>
  /* The page: the guide's measure and title (b-guide.css), the search
     rail's links (b-search.css). Site tokens only. */
  /* A short list still fills the window: the foot at its bottom. */
  .frame.dir-b.pg-saved { display: flex; flex-direction: column; min-height: 100vh; }
  .dir-b .saved {
    flex: 1 0 auto;
    width: 100%;
    box-sizing: border-box;
    max-width: 1152px;
    margin: 0 auto;
    padding: 50px 72px 72px;
    font-family: var(--sans);
    color: var(--ink);
  }
  .dir-b .saved h1 {
    margin: 0 0 18px;
    font: 700 64px/.92 var(--tface);
    text-transform: uppercase;
    color: var(--ink);
  }
  .dir-b .saved .saved-page { max-width: 760px; }
  .dir-b .saved .sv-label { margin: 0; font: 500 16px/1.4 var(--sans); color: var(--mid); }
  .dir-b .saved .sv-tools { display: flex; gap: 28px; margin-top: 10px; }
  .dir-b .saved .sv-status { margin: 6px 0 0; font: 500 16px/1.4 var(--sans); color: var(--ink); }
  .dir-b .saved .sv-status:empty { margin: 0; }
  .dir-b .saved .sv-empty { margin: 18px 0 0; padding-top: 18px; border-top: 2px solid var(--ink); font: 400 18px/1.5 var(--read); color: var(--mid); }
  /* Every action reads as the rail's links do: ink, a red rule under it. */
  .dir-b .saved .sv-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: 600 15px/1.2 var(--sans);
    color: var(--ink);
    text-decoration: underline 2px var(--red-ink);
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .dir-b .saved .sv-btn:hover:not(:disabled) { color: var(--red-ink); }
  .dir-b .saved .sv-btn:disabled { color: var(--mid); text-decoration-color: var(--line); cursor: default; }
  .dir-b .saved .sv-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .dir-b .saved .sv-list { margin: 18px 0 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); }
  .dir-b .saved .sv-item { padding: 20px 0 10px; border-bottom: 1px solid var(--line); }
  .dir-b .saved .sv-name { margin: 0; font: 400 24px/1.3 var(--read); color: var(--ink); overflow-wrap: anywhere; }
  .dir-b .saved .sv-date { margin: 6px 0 0; font: 500 14px/1.3 var(--sans); color: var(--mid); }
  .dir-b .saved .sv-note { margin: 10px 0 0; font: 400 18px/1.55 var(--read); color: var(--ink); white-space: pre-wrap; }
  .dir-b .saved .sv-actions { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 6px; }
  .dir-b .saved .sv-edit { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 4px; }
  .dir-b .saved .sv-input {
    flex: 1 1 100%;
    min-height: 44px;
    padding: 8px 10px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    font: 400 18px/1.4 var(--read);
    color: var(--ink);
  }
  .dir-b .saved .sv-input:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .dir-b .saved .sv-item > .sv-input { margin-top: 10px; }
  @media (max-width: 960px) {
    .dir-b .saved { padding: 28px 18px 48px; }
    .dir-b .saved h1 { font-size: 44px; }
  }
</style>
