---
import Search from '../components/Search.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const searchDescription =
  'Search the complete works of Aristotle across the original Greek and English' +
  ' translation — by word or phrase, in Greek script or Beta Code, with results' +
  ' cited by Bekker number.';
const canonical = Astro.site ? new URL(`${base}/search/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>Search Aristotle in Greek and English</title>
  <meta name="description" content={searchDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Search Aristotle in Greek and English" />
  <meta property="og:description" content={searchDescription} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="simple-header">
    <div class="header-title">
      <a class="home-link" href={`${base}/`} title="All works">Home</a>
      <span class="title-sep">›</span>
      <span class="header-static">Search</span>
    </div>
    <nav class="header-actions" aria-label="Navigation">
      <a href={`${base}/`} class="search-link">All works</a>
      <a href={`${base}/lemma/`} class="search-link">Lexicon</a>
      <ThemeToggle />
    </nav>
  </header>
  <Search client:load />
</body>
</html>
