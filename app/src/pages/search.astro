---
import Search from '@shared/components/Search.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import BFonts from '../components/BFonts.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '@shared/styles/b.css';
import '@shared/styles/b-search.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const searchDescription =
  'Search the complete works of Aristotle across the original Greek and every' +
  ' English translation — by word or phrase, in Greek script or Beta Code, with' +
  ' results cited by Bekker number.';
const canonical = Astro.site ? new URL(`${base}/search/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Search Aristotle in Greek and English',
  description: searchDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Aristotle Reader' },
  potentialAction: {
    '@type': 'SearchAction',
    target: canonical ? `${canonical}?q={search_term_string}` : undefined,
    'query-input': 'required name=search_term_string',
  },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>Search Aristotle in Greek and English</title>
  <meta name="description" content={searchDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Search Aristotle in Greek and English" />
  <meta property="og:description" content={searchDescription} />
  <meta property="og:site_name" content="The Aristotle Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Search Aristotle in Greek and English" />
  <meta name="twitter:description" content={searchDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-search">
    <BNav active="/search" />
    <Search client:load />
    <BFoot />
  </div>
</body>
</html>
