---
import Search from '../components/Search.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>Search — Aristotle</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="page-header">
    <div class="header-title">
      <a class="home-link" href={`${base}/`} title="All works">Aristotle</a>
      <span class="title-sep">›</span>
      <span class="header-static">Search</span>
    </div>
    <ThemeToggle />
    <nav class="book-nav" aria-label="Navigation">
      <a href={`${base}/`} class="search-link">All works</a>
      <a href={`${base}/attribution`} class="search-link">Texts &amp; Licences</a>
    </nav>
  </header>
  <Search client:load />
</body>
</html>
