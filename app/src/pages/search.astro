---
import Search from '../components/Search.svelte';
import '../styles/global.css';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Search — Nicomachean Ethics</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="page-header">
    <h1><a href="/" style="text-decoration:none;color:inherit">Nicomachean Ethics</a></h1>
    <nav class="book-nav" aria-label="Books">
      {Array.from({ length: 10 }, (_, i) => (
        <a href={`/book/${i + 1}`}>
          {['I','II','III','IV','V','VI','VII','VIII','IX','X'][i]}
        </a>
      ))}
      <a href="/search" class="current search-link" aria-current="page">Search</a>
      <a href="/attribution" class="search-link">Texts &amp; Licences</a>
    </nav>
  </header>
  <Search client:load />
</body>
</html>
