---
// A shareable on-site support/donation page. Giving itself goes through the
// Stripe Payment Link (SUPPORT_URL); this page gives that appeal a real URL on
// our own domain with a branded Open Graph card (public/og-support.png).
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import BFonts from '../components/BFonts.astro';
import BNav from '../components/BNav.astro';
import BFoot from '../components/BFoot.astro';
import { SUPPORT_URL } from '../lib/support';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
import '@shared/styles/b.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Support the Aristotle Reader';
const metaDescription =
  'Help keep the Aristotle Reader free and open — an ad-free parallel ' +
  'Greek–English edition of Aristotle’s complete works, with click-to-parse ' +
  'morphology, dictionary entries, and exact Bekker citation.';
const canonical = Astro.site
  ? new URL(`${base}/support/`, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-support.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Aristotle Reader' },
  potentialAction: {
    '@type': 'DonateAction',
    target: SUPPORT_URL,
  },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <Pwa />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Aristotle Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <BFonts />
</head>
<body>
  <div class="frame dir-b pg-support"><div class="b-page">
  <BNav active="/support" />


  <main class="b-info sp-body">
    <p class="sp-eyebrow">Support <span class="gk">χάρις</span></p>
    <h1 class="b-pc-h">Support the Aristotle Reader</h1>
    <p class="sp-lede">
      The Aristotle Reader is an ad-free parallel Greek–English edition of
      Aristotle’s complete works — with click-to-parse morphology, dictionary
      entries, and exact Bekker citation. It is free to read and always will be.
    </p>
    <p>
      It is built and maintained by one person, and runs on no advertising and no
      paywall. A contribution helps defray development costs and keeps the reader
      free and open for students, teachers, and readers everywhere.
    </p>
    <ul class="sp-list">
      <li>Hosting and the tools that keep the site fast and ad-free.</li>
      <li>Aligning more public-domain translations to the Greek, line by line.</li>
      <li>Adding works, glossaries, and reading aids across the corpus.</li>
    </ul>
    <div class="b-ctas sp-cta">
      <a class="b-btn pri" href={SUPPORT_URL} target="_blank" rel="noopener">Make a gift</a>
    </div>
    <p class="sp-note">
      Gifts are processed securely by Stripe — you choose the amount. Thank you
      for keeping the reader free. <span class="gk">χάρις</span>.
    </p>
  </main>
  <BFoot />
  </div></div>
</body>
</html>
