[{"t": "ἄλλα", "o": 0, "k": "a)/lla"}, {"t": "ἀποστήματα", "o": 5, "k": "a)posth/mata"}, {"t": "ὑγιεινόν", "o": 16, "k": "u(gieino/n"}, {"t": "ὅτι", "o": 26, "k": "o(/ti"}, {"t": "ἔχουσι", "o": 30, "k": "e)/xousi"}, {"t": "κοιλίας", "o": 37, "k": "koili/as"}, {"t": "εἰς", "o": 45, "k": "ei)s"}, {"t": "ἃς", "o": 49, "k": "a(/s"}, {"t": "ἀποδέχονται", "o": 52, "k": "a)pode/xontai"}]}, {"n": 32, "text": "τὰ πνεύματα. ἐκτεταμένου μὲν οὖν οὐ γίνεται κοιλία", "joined": true, "tokens": [{"t": "τὰ", "o": 0, "k": "ta/"}, {"t": "πνεύματα", "o": 3, "k": "pneu/mata"}, {"t": "ἐκτεταμένου", "o": 13, "k": "e)ktetame/nou"}, {"t": "μὲν", "o": 25, "k": "me/n"}, {"t": "οὖν", "o": 29, "k": "ou)=n"}, {"t": "οὐ", "o": 33, "k": "ou)"}, {"t": "γίνεται", "o": 36, "k": "gi/netai"}, {"t": "κοιλία", "o": 44, "k": "koili/a"}]}, {"n": 33, "text": "(ἅπαντα γὰρ τὸν τόπον τὰ σπλάγχνα κατέχει),", "tokens": [{"t": "ἅπαντα", "o": 0, "k": "a(/panta"}, {"t": "γὰρ", "o": 8, "k": "ga/r"}, {"t": "τὸν", "o": 12, "k": "to/n"}, {"t": "τόπον", "o": 16, "k": "to/pon"}, {"t": "τὰ", "o": 22, "k": "ta/"}, {"t": "σπλάγχνα", "o": 25, "k": "spla/gxna"}, {"t": "κατέχει", "o": 34, "k": "kate/xei"}]}, {"n": 34, "text": "συγκαμφθέντος δὲ γίνεται.", "tokens": [{"t": "συγκαμφθέντος", "o": 0, "k": "sugkamfqe/ntos"}, {"t": "δὲ", "o": 14, "k": "de/"}, {"t": "γίνεται", "o": 17, "k": "gi/netai"}]}, {"n": 35, "text": "Διὰ τί ἀνισταμένοις ἴλιγγος μᾶλλον γίνεται ἢ καθίζουσιν;", "joined": true, "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ἀνισταμένοις", "o": 7, "k": "a)nistame/nois"}, {"t": "ἴλιγγος", "o": 20, "k": "i)/liggos"}, {"t": "μᾶλλον", "o": 28, "k": "ma=llon"}, {"t": "γίνεται", "o": 35, "k": "gi/netai"}, {"t": "ἢ", "o": 43, "k": "h)/"}, {"t": "καθίζουσιν", "o": 45, "k": "kaqi/zousin"}]}, {"n": 36, "text": "ἢ διότι ἠρεμοῦσι τὸ ὑγρὸν εἰς ἓν μόριον ἀθρόον ἀποκλίνει;", "joined": true, "tokens": [{"t": "ἢ", "o": 0, "k": "h)/"}, {"t": "διότι", "o": 2, "k": "dio/ti"}, {"t": "ἠρεμοῦσι", "o": 8, "k": "h)remou=si"}, {"t": "τὸ", "o": 17, "k": "to/"}, {"t": "ὑγρὸν", "o": 20, "k": "u(gro/n"}, {"t": "εἰς", "o": 26, "k": "ei)s"}, {"t": "ἓν", "o": 30, "k": "e(/n"}, {"t": "μόριον", "o": 33, "k": "mo/rion"}, {"t": "ἀθρόον", "o": 40, "k": "a)qro/on"}, {"t": "ἀποκλίνει", "o": 47, "k": "a)pokli/nei"}]}, {"n": 37, "text": "διὸ καὶ τὰ ὠμὰ ᾠὰ οὐ δύναται δινεῖσθαι, ἀλλὰ καταπίπτει.", "joined": true, "tokens": [{"t": "διὸ", "o": 0, "k": "dio/"}, {"t": "καὶ", "o": 4, "k": "kai/"}, {"t": "τὰ", "o": 8, "k": "ta/"}, {"t": "ὠμὰ", "o": 11, "k": "w)ma/"}, {"t": "ᾠὰ", "o": 15, "k": "w)|a/"}, {"t": "οὐ", "o": 18, "k": "ou)"}, {"t": "δύναται", "o": 21, "k": "du/natai"}, {"t": "δινεῖσθαι", "o": 29, "k": "dinei=sqai"}, {"t": "ἀλλὰ", "o": 40, "k": "a)lla/"}, {"t": "καταπίπτει", "o": 45, "k": "katapi/ptei"}]}, {"n": 38, "text": "κινούμενον δὲ τὸ ὑγρὸν ὁμοίως ἔχει. ἀνίστανται μὲν", "tokens": [{"t": "κινούμενον", "o": 0, "k": "kinou/menon"}, {"t": "δὲ", "o": 11, "k": "de/"}, {"t": "τὸ", "o": 14, "k": "to/"}, {"t": "ὑγρὸν", "o": 17, "k": "u(gro/n"}, {"t": "ὁμοίως", "o": 23, "k": "o(moi/ws"}, {"t": "ἔχει", "o": 30, "k": "e)/xei"}, {"t": "ἀνίστανται", "o": 36, "k": "a)ni/stantai"}, {"t": "μὲν", "o": 47, "k": "me/n"}]}], "english": {"text": "Why is it that sitting down makes some persons fat and others lean? Is it because bodily conditions differ, some men being hot, others cold? Those therefore who are hot grow fat (for the body owing to its heat prevails over the nourishment); but those who are cold, owing to the fact that their body requires heat introduced from without and derives it chiefly from movement, cannot concoct their food while they are at rest. Or is it because the hot are full of superfluities and require movement to expend them, while the cold are not so? Why is it necessary that the parts of the body should be distended, as happens when a man takes athletic exercise? Is it because the ducts must be purged by their own breath? Why is it better to lie in a curved position and why do many physicians prescribe this? Is it because the stomach concocts food more quickly when it is kept warm, and it keeps warmer in this position? Furthermore it is necessary to give the vapours a place where they can settle; for then there is less likely to be pain from flatulence. (It is on this account that swollen veins and abscesses of all kinds help to restore a healthy condition, because they form hollows in which they receive the vapours.) When the body then is extended no hollow is formed (for the internal organs occupy all the space); but a hollow is formed when the body is curved. Why is dizziness more likely to occur in those who are standing than in those who are sitting? Is it because, when one is still, the moisture all inclines to one part of the body? This is why raw eggs cannot be spun round and round but fall over. The same thing occurs when the moisture in the body is put in motion. So one stands up", "notes": [], "markers": [{"kind": "section", "n": "1", "offset": 0}, {"kind": "section", "n": "2", "offset": 541}, {"kind": "section", "n": "3", "offset": 716}, {"kind": "section", "n": "4", "offset": 1369}], "bekker": [{"n": 15, "offset": 0, "real": true}, {"n": 20, "offset": 342, "real": true}, {"n": 25, "offset": 656, "real": true}, {"n": 30, "offset": 1005, "real": true}, {"n": 35, "offset": 1369, "real": true}]}}, {"id": "6:886a", "column": "886a", "chapterStarts": [{"chapter": "5", "beforeLine": 3, "wordIndex": 0, "engOffset": 159, "bekker": "886a3–9"}, {"chapter": "6", "beforeLine": 10, "wordIndex": 0, "engOffset": 731, "bekker": "886a10–14"}, {"chapter": "7", "beforeLine": 15, "wordIndex": 0, "engOffset": 1050, "bekker": "886a15–21"}], "greek": [{"n": 1, "text": "οὖν ἠρεμήσαντες, ὅτε οὕτως διάκεινται· καθιζάνουσι δὲ ἐν κινήσει", "joined": true, "tokens": [{"t": "οὖν", "o": 0, "k": "ou)=n"}, {"t": "ἠρεμήσαντες", "o": 4, "k": "h)remh/santes"}, {"t": "ὅτε", "o": 17, "k": "o(/te"}, {"t": "οὕτως", "o": 21, "k": "ou(/tws"}, {"t": "διάκεινται", "o": 27, "k": "dia/keintai"}, {"t": "καθιζάνουσι", "o": 39, "k": "kaqiza/nousi"}, {"t": "δὲ", "o": 51, "k": "de/"}, {"t": "ἐν", "o": 54, "k": "e)n"}, {"t": "κινήσει", "o": 57, "k": "kinh/sei"}]}, {"n": 2, "text": "γενόμενοι, ὅτε ὁμαλῶς ἔχει τὸ ὑγρὸν καὶ ἐσκέδασται.", "tokens": [{"t": "γενόμενοι", "o": 0, "k": "geno/menoi"}, {"t": "ὅτε", "o": 11, "k": "o(/te"}, {"t": "ὁμαλῶς", "o": 15, "k": "o(malw=s"}, {"t": "ἔχει", "o": 22, "k": "e)/xei"}, {"t": "τὸ", "o": 27, "k": "to/"}, {"t": "ὑγρὸν", "o": 30, "k": "u(gro/n"}, {"t": "καὶ", "o": 36, "k": "kai/"}, {"t": "ἐσκέδασται", "o": 40, "k": "e)ske/dastai"}]}, {"n": 3, "text": "Διὰ τί ἐπὶ τὰ δεξιὰ κατακειμένοις μᾶλλον ἐπέρχεται", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ἐπὶ", "o": 7, "k": "e)pi/"}, {"t": "τὰ", "o": 11, "k": "ta/"}, {"t": "δεξιὰ", "o": 14, "k": "decia/"}, {"t": "κατακειμένοις", "o": 20, "k": "katakeime/nois"}, {"t": "μᾶλλον", "o": 34, "k": "ma=llon"}, {"t": "ἐπέρχεται", "o": 41, "k": "e)pe/rxetai"}]}, {"n": 4, "text": "ὕπνος; πότερον ὅτι ἐναντίως ἔχοντες ἐγρηγόρασι καὶ καθεύδουσιν;", "joined": true, "tokens": [{"t": "ὕπνος", "o": 0, "k": "u(/pnos"}, {"t": "πότερον", "o": 7, "k": "po/teron"}, {"t": "ὅτι", "o": 15, "k": "o(/ti"}, {"t": "ἐναντίως", "o": 19, "k": "e)nanti/ws"}, {"t": "ἔχοντες", "o": 28, "k": "e)/xontes"}, {"t": "ἐγρηγόρασι", "o": 36, "k": "e)grhgo/rasi"}, {"t": "καὶ", "o": 47, "k": "kai/"}, {"t": "καθεύδουσιν", "o": 51, "k": "kaqeu/dousin"}]}, {"n": 5, "text": "ἐπεὶ οὖν ἐγρηγορότες ἐπὶ τὰ ἀριστερὰ κατάκεινται,", "tokens": [{"t": "ἐπεὶ", "o": 0, "k": "e)pei/"}, {"t": "οὖν", "o": 5, "k": "ou)=n"}, {"t": "ἐγρηγορότες", "o": 9, "k": "e)grhgoro/tes"}, {"t": "ἐπὶ", "o": 21, "k": "e)pi/"}, {"t": "τὰ", "o": 25, "k": "ta/"}, {"t": "ἀριστερὰ", "o": 28, "k": "a)ristera/"}, {"t": "κατάκεινται", "o": 37, "k": "kata/keintai"}]}, {"n": 6, "text": "τοὐναντίον ἔσται ἐπ' ἄλλης ἀρχῆς καὶ τῆς ἐναντίας. ἢ ὅτι", "tokens": [{"t": "τοὐναντίον", "o": 0, "k": "tou)nanti/on"}, {"t": "ἔσται", "o": 11, "k": "e)/stai"}, {"t": "ἐπ'", "o": 17, "k": "e)p'"}, {"t": "ἄλλης", "o": 21, "k": "a)/llhs"}, {"t": "ἀρχῆς", "o": 27, "k": "a)rxh=s"}, {"t": "καὶ", "o": 33, "k": "kai/"}, {"t": "τῆς", "o": 37, "k": "th=s"}, {"t": "ἐναντίας", "o": 41, "k": "e)nanti/as"}, {"t": "ἢ", "o": 51, "k": "h)/"}, {"t": "ὅτι", "o": 53, "k": "o(/ti"}]}, {"n": 7, "text": "ἀκινησία ὁ ὕπνος; τὰ οὖν κινητικὰ μέρη δεῖ ἠρεμεῖν, τὰ δὲ", "tokens": [{"t": "ἀκινησία", "o": 0, "k": "a)kinhsi/a"}, {"t": "ὁ", "o": 9, "k": "o("}, {"t": "ὕπνος", "o": 11, "k": "u(/pnos"}, {"t": "τὰ", "o": 18, "k": "ta/"}, {"t": "οὖν", "o": 21, "k": "ou)=n"}, {"t": "κινητικὰ", "o": 25, "k": "kinhtika/"}, {"t": "μέρη", "o": 34, "k": "me/rh"}, {"t": "δεῖ", "o": 39, "k": "dei="}, {"t": "ἠρεμεῖν", "o": 43, "k": "h)remei=n"}, {"t": "τὰ", "o": 52, "k": "ta/"}, {"t": "δὲ", "o": 55, "k": "de/"}]}, {"n": 8, "text": "δεξιὰ κινητικά. οὕτω δὲ κατακειμένων οἷον δέδεται ἀρχή", "tokens": [{"t": "δεξιὰ", "o": 0, "k": "decia/"}, {"t": "κινητικά", "o": 6, "k": "kinhtika/"}, {"t": "οὕτω", "o": 16, "k": "ou(/tw"}, {"t": "δὲ", "o": 21, "k": "de/"}, {"t": "κατακειμένων", "o": 24, "k": "katakeime/nwn"}, {"t": "οἷον", "o": 37, "k": "oi(=on"}, {"t": "δέδεται", "o": 42, "k": "de/detai"}, {"t": "ἀρχή", "o": 50, "k": "a)rxh/"}]}, {"n": 9, "text": "τις ἐπεγερτική.", "tokens": [{"t": "τις", "o": 0, "k": "tis"}, {"t": "ἐπεγερτική", "o": 4, "k": "e)pegertikh/"}]}, {"n": 10, "text": "Διὰ τί ναρκῶσιν; καὶ διὰ τί χεῖρας καὶ πόδας μᾶλλον;", "joined": true, "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ναρκῶσιν", "o": 7, "k": "narkw=sin"}, {"t": "καὶ", "o": 17, "k": "kai/"}, {"t": "διὰ", "o": 21, "k": "dia/"}, {"t": "τί", "o": 25, "k": "ti/"}, {"t": "χεῖρας", "o": 28, "k": "xei=ras"}, {"t": "καὶ", "o": 35, "k": "kai/"}, {"t": "πόδας", "o": 39, "k": "po/das"}, {"t": "μᾶλλον", "o": 45, "k": "ma=llon"}]}, {"n": 11, "text": "ἢ ὅτι κατάψυξίς ἐστιν ἡ νάρκη; διὰ στέρησιν γὰρ αἵματος", "joined": true, "tokens": [{"t": "ἢ", "o": 0, "k": "h)/"}, {"t": "ὅτι", "o": 2, "k": "o(/ti"}, {"t": "κατάψυξίς", "o": 6, "k": "kata/yucis"}, {"t": "ἐστιν", "o": 16, "k": "e)stin"}, {"t": "ἡ", "o": 22, "k": "h("}, {"t": "νάρκη", "o": 24, "k": "na/rkh"}, {"t": "διὰ", "o": 31, "k": "dia/"}, {"t": "στέρησιν", "o": 35, "k": "ste/rhsin"}, {"t": "γὰρ", "o": 44, "k": "ga/r"}, {"t": "αἵματος", "o": 48, "k": "ai(/matos"}]}, {"n": 12, "text": "γίνεται καὶ μετάστασιν. ἀσαρκότατα δὲ ταῦτα καὶ νευρωδέστατα,", "joined": true, "tokens": [{"t": "γίνεται", "o": 0, "k": "gi/netai"}, {"t": "καὶ", "o": 8, "k": "kai/"}, {"t": "μετάστασιν", "o": 12, "k": "meta/stasin"}, {"t": "ἀσαρκότατα", "o": 24, "k": "a)sarko/tata"}, {"t": "δὲ", "o": 35, "k": "de/"}, {"t": "ταῦτα", "o": 38, "k": "tau=ta"}, {"t": "καὶ", "o": 44, "k": "kai/"}, {"t": "νευρωδέστατα", "o": 48, "k": "neurwde/stata"}]}, {"n": 13, "text": "μάλιστα δὲ οἱ πόδες. ὥστε προοδοποιεῖται ὑπὸ", "tokens": [{"t": "μάλιστα", "o": 0, "k": "ma/lista"}, {"t": "δὲ", "o": 8, "k": "de/"}, {"t": "οἱ", "o": 11, "k": "oi("}, {"t": "πόδες", "o": 14, "k": "po/des"}, {"t": "ὥστε", "o": 21, "k": "w(/ste"}, {"t": "προοδοποιεῖται", "o": 26, "k": "proodopoiei=tai"}, {"t": "ὑπὸ", "o": 41, "k": "u(po/"}]}, {"n": 14, "text": "τῆς φύσεως πρὸς τὸ καταψύχεσθαι ταχέως.", "tokens": [{"t": "τῆς", "o": 0, "k": "th=s"}, {"t": "φύσεως", "o": 4, "k": "fu/sews"}, {"t": "πρὸς", "o": 11, "k": "pro/s"}, {"t": "τὸ", "o": 16, "k": "to/"}, {"t": "καταψύχεσθαι", "o": 19, "k": "katayu/xesqai"}, {"t": "ταχέως", "o": 32, "k": "taxe/ws"}]}, {"n": 15, "text": "Διὰ τί κατακείμεθα μὲν ἐπὶ τὰ ἀριστερὰ ἡδέως, καθεύδομεν", "joined": true, "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "κατακείμεθα", "o": 7, "k": "katakei/meqa"}, {"t": "μὲν", "o": 19, "k": "me/n"}, {"t": "ἐπὶ", "o": 23, "k": "e)pi/"}, {"t": "τὰ", "o": 27, "k": "ta/"}, {"t": "ἀριστερὰ", "o": 30, "k": "a)ristera/"}, {"t": "ἡδέως", "o": 39, "k": "h(de/ws"}, {"t": "καθεύδομεν", "o": 46, "k": "kaqeu/domen"}]}, {"n": 16, "text": "δὲ ἐπὶ τὰ δεξιὰ μᾶλλον; πότερον ὅτι ἀποστραφέντες", "joined": true, "tokens": [{"t": "δὲ", "o": 0, "k": "de/"}, {"t": "ἐπὶ", "o": 3, "k": "e)pi/"}, {"t": "τὰ", "o": 7, "k": "ta/"}, {"t": "δεξιὰ", "o": 10, "k": "decia/"}, {"t": "μᾶλλον", "o": 16, "k": "ma=llon"}, {"t": "πότερον", "o": 24, "k": "po/teron"}, {"t": "ὅτι", "o": 32, "k": "o(/ti"}, {"t": "ἀποστραφέντες", "o": 36, "k": "a)postrafe/ntes"}]}, {"n": 17, "text": "πρὸς τὸ φῶς οὐ βλέπομεν; ἐν γὰρ τῷ σκότει θᾶττον", "tokens": [{"t": "πρὸς", "o": 0, "k": "pro/s"}, {"t": "τὸ", "o": 5, "k": "to/"}, {"t": "φῶς", "o": 8, "k": "fw=s"}, {"t": "οὐ", "o": 12, "k": "ou)"}, {"t": "βλέπομεν", "o": 15, "k": "ble/pomen"}, {"t": "ἐν", "o": 25, "k": "e)n"}, {"t": "γὰρ", "o": 28, "k": "ga/r"}, {"t": "τῷ", "o": 32, "k": "tw=|"}, {"t": "σκότει", "o": 35, "k": "sko/tei"}, {"t": "θᾶττον", "o": 42, "k": "qa=tton"}]}, {"n": 18, "text": "ὕπνος λαμβάνει. ἢ διότι ἐγρηγόραμεν κατακείμενοι ἐπὶ τοῖς", "tokens": [{"t": "ὕπνος", "o": 0, "k": "u(/pnos"}, {"t": "λαμβάνει", "o": 6, "k": "lamba/nei"}, {"t": "ἢ", "o": 16, "k": "h)/"}, {"t": "διότι", "o": 18, "k": "dio/ti"}, {"t": "ἐγρηγόραμεν", "o": 24, "k": "e)grhgo/ramen"}, {"t": "κατακείμενοι", "o": 36, "k": "katakei/menoi"}, {"t": "ἐπὶ", "o": 49, "k": "e)pi/"}, {"t": "τοῖς", "o": 53, "k": "toi=s"}]}, {"n": 19, "text": "ἀριστεροῖς, καὶ αἱ χρήσεις ἡμῖν οὕτω πρόχειροι, ὥστε πρὸς τὸ", "tokens": [{"t": "ἀριστεροῖς", "o": 0, "k": "a)risteroi=s"}, {"t": "καὶ", "o": 12, "k": "kai/"}, {"t": "αἱ", "o": 16, "k": "ai("}, {"t": "χρήσεις", "o": 19, "k": "xrh/seis"}, {"t": "ἡμῖν", "o": 27, "k": "h(mi=n"}, {"t": "οὕτω", "o": 32, "k": "ou(/tw"}, {"t": "πρόχειροι", "o": 37, "k": "pro/xeiroi"}, {"t": "ὥστε", "o": 48, "k": "w(/ste"}, {"t": "πρὸς", "o": 53, "k": "pro/s"}, {"t": "τὸ", "o": 58, "k": "to/"}]}, {"n": 20, "text": "ἐναντίον σχῆμα πρὸ ἔργου; παρακαλεῖ δὲ ἕκαστον πρὸς τὸ", "tokens": [{"t": "ἐναντίον", "o": 0, "k": "e)nanti/on"}, {"t": "σχῆμα", "o": 9, "k": "sxh=ma"}, {"t": "πρὸ", "o": 15, "k": "pro/"}, {"t": "ἔργου", "o": 19, "k": "e)/rgou"}, {"t": "παρακαλεῖ", "o": 26, "k": "parakalei="}, {"t": "δὲ", "o": 36, "k": "de/"}, {"t": "ἕκαστον", "o": 39, "k": "e(/kaston"}, {"t": "πρὸς", "o": 47, "k": "pro/s"}, {"t": "τὸ", "o": 52, "k": "to/"}]}, {"n": 21, "text": "ἔργον τὸ σχῆμα μᾶλλον.", "tokens": [{"t": "ἔργον", "o": 0, "k": "e)/rgon"}, {"t": "τὸ", "o": 6, "k": "to/"}, {"t": "σχῆμα", "o": 9, "k": "sxh=ma"}, {"t": "μᾶλλον", "o": 15, "k": "ma=llon"}]}], "english": {"text": "after having been at rest, when one is in this condition; but one sits down after having been in motion, when the moisture is evenly and uniformly distributed Why is it that sleep comes more readily if one lies on the right side? Is it because the conditions when we are awake and when we are asleep are the contrary of one another? Since, therefore, when we are awake we recline on the left side, the contrary will occur when another principle, namely, the contrary, is at work. Or is it because sleep is the absence of movement? The parts then of the body which are most active must be at rest; and the parts of the body on the right are most active. So, if one is lying on this side, a waking principle is as it were enchained. Why does one feel numbness? And why more in the hands and feet than elsewhere? Is it because numbness is a process of cooling, being due to deprivation of blood and its transference elsewhere? Now these parts, especially the feet, are least fleshy and most muscular, and so they are naturally disposed to cool quickly. Why do we find it comfortable to recline on the left side, but sleep better on the right side? Is it because by turning away we avoid looking towards the light, since in the dark sleep comes on more readily? Or is it because we keep awake when reclining on the left side, and in this position we can easily employ ourselves in any particular function; and so for the contrary purpose the contrary position is advantageous; for each position invites to a particular function.", "notes": [], "markers": [{"kind": "section", "n": "5", "offset": 159}, {"kind": "section", "n": "6", "offset": 731}, {"kind": "section", "n": "7", "offset": 1050}], "bekker": [{"n": 1, "offset": 0, "real": true}, {"n": 5, "offset": 324, "real": true}, {"n": 10, "offset": 687, "real": false}, {"n": 15, "offset": 1050, "real": true}, {"n": 20, "offset": 1447, "real": false}]}}]}