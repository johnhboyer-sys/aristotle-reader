 "o": 7, "k": "kai/"}, {"t": "τὴν", "o": 11, "k": "th/n"}, {"t": "γένεσιν", "o": 15, "k": "ge/nesin"}, {"t": "καὶ", "o": 23, "k": "kai/"}, {"t": "τὴν", "o": 27, "k": "th/n"}, {"t": "ἀπώλειαν", "o": 31, "k": "a)pw/leian"}, {"t": "τῶν", "o": 40, "k": "tw=n"}, {"t": "φθαρτῶν", "o": 44, "k": "fqartw=n"}]}, {"n": 27, "text": "τοιαύτην εἶναι, ὥστε πάλιν ταῦτα γίνεσθαι καὶ φθείρεσθαι;", "tokens": [{"t": "τοιαύτην", "o": 0, "k": "toiau/thn"}, {"t": "εἶναι", "o": 9, "k": "ei)=nai"}, {"t": "ὥστε", "o": 16, "k": "w(/ste"}, {"t": "πάλιν", "o": 21, "k": "pa/lin"}, {"t": "ταῦτα", "o": 27, "k": "tau=ta"}, {"t": "γίνεσθαι", "o": 33, "k": "gi/nesqai"}, {"t": "καὶ", "o": 42, "k": "kai/"}, {"t": "φθείρεσθαι", "o": 46, "k": "fqei/resqai"}]}, {"n": 28, "text": "καθάπερ καὶ φασὶ κύκλον εἶναι τὰ ἀνθρώπινα. τὸ μὲν δὴ", "tokens": [{"t": "καθάπερ", "o": 0, "k": "kaqa/per"}, {"t": "καὶ", "o": 8, "k": "kai/"}, {"t": "φασὶ", "o": 12, "k": "fasi/"}, {"t": "κύκλον", "o": 17, "k": "ku/klon"}, {"t": "εἶναι", "o": 24, "k": "ei)=nai"}, {"t": "τὰ", "o": 30, "k": "ta/"}, {"t": "ἀνθρώπινα", "o": 33, "k": "a)nqrw/pina"}, {"t": "τὸ", "o": 44, "k": "to/"}, {"t": "μὲν", "o": 47, "k": "me/n"}, {"t": "δὴ", "o": 51, "k": "dh/"}]}, {"n": 29, "text": "τῷ ἀριθμῷ τοὺς αὐτοὺς ἀξιοῦν εἶναι ἀεὶ τοὺς γινομένους εὔηθες,", "tokens": [{"t": "τῷ", "o": 0, "k": "tw=|"}, {"t": "ἀριθμῷ", "o": 3, "k": "a)riqmw=|"}, {"t": "τοὺς", "o": 10, "k": "tou/s"}, {"t": "αὐτοὺς", "o": 15, "k": "au)tou/s"}, {"t": "ἀξιοῦν", "o": 22, "k": "a)ciou=n"}, {"t": "εἶναι", "o": 29, "k": "ei)=nai"}, {"t": "ἀεὶ", "o": 35, "k": "a)ei/"}, {"t": "τοὺς", "o": 39, "k": "tou/s"}, {"t": "γινομένους", "o": 44, "k": "ginome/nous"}, {"t": "εὔηθες", "o": 55, "k": "eu)/hqes"}]}, {"n": 30, "text": "τὸ δὲ τῷ εἴδει μᾶλλον ἄν τις ἀποδέξαιτο· ὥστε κἂν αὐτοὶ", "tokens": [{"t": "τὸ", "o": 0, "k": "to/"}, {"t": "δὲ", "o": 3, "k": "de/"}, {"t": "τῷ", "o": 6, "k": "tw=|"}, {"t": "εἴδει", "o": 9, "k": "ei)/dei"}, {"t": "μᾶλλον", "o": 15, "k": "ma=llon"}, {"t": "ἄν", "o": 22, "k": "a)/n"}, {"t": "τις", "o": 25, "k": "tis"}, {"t": "ἀποδέξαιτο", "o": 29, "k": "a)pode/caito"}, {"t": "ὥστε", "o": 41, "k": "w(/ste"}, {"t": "κἂν", "o": 46, "k": "ka)/n"}, {"t": "αὐτοὶ", "o": 50, "k": "au)toi/"}]}, {"n": 31, "text": "πρότεροι εἴημεν, καὶ θείη ἄν τις τὴν τοῦ εἱρμοῦ τάξιν τοιαύτην", "joined": true, "tokens": [{"t": "πρότεροι", "o": 0, "k": "pro/teroi"}, {"t": "εἴημεν", "o": 9, "k": "ei)/hmen"}, {"t": "καὶ", "o": 17, "k": "kai/"}, {"t": "θείη", "o": 21, "k": "qei/h"}, {"t": "ἄν", "o": 26, "k": "a)/n"}, {"t": "τις", "o": 29, "k": "tis"}, {"t": "τὴν", "o": 33, "k": "th/n"}, {"t": "τοῦ", "o": 37, "k": "tou="}, {"t": "εἱρμοῦ", "o": 41, "k": "ei(rmou="}, {"t": "τάξιν", "o": 48, "k": "ta/cin"}, {"t": "τοιαύτην", "o": 54, "k": "toiau/thn"}]}, {"n": 32, "text": "εἶναι ὡς πάλιν ἐπανακάμπτειν ἐπὶ τὴν ἀρχὴν καὶ συνεχὲς", "joined": true, "tokens": [{"t": "εἶναι", "o": 0, "k": "ei)=nai"}, {"t": "ὡς", "o": 6, "k": "w(s"}, {"t": "πάλιν", "o": 9, "k": "pa/lin"}, {"t": "ἐπανακάμπτειν", "o": 15, "k": "e)panaka/mptein"}, {"t": "ἐπὶ", "o": 29, "k": "e)pi/"}, {"t": "τὴν", "o": 33, "k": "th/n"}, {"t": "ἀρχὴν", "o": 37, "k": "a)rxh/n"}, {"t": "καὶ", "o": 43, "k": "kai/"}, {"t": "συνεχὲς", "o": 47, "k": "sunexe/s"}]}, {"n": 33, "text": "ποιεῖν καὶ ἀεὶ κατὰ ταὐτὰ ἔχειν. τοὺς γὰρ ἀνθρώπους", "tokens": [{"t": "ποιεῖν", "o": 0, "k": "poiei=n"}, {"t": "καὶ", "o": 7, "k": "kai/"}, {"t": "ἀεὶ", "o": 11, "k": "a)ei/"}, {"t": "κατὰ", "o": 15, "k": "kata/"}, {"t": "ταὐτὰ", "o": 20, "k": "tau)ta/"}, {"t": "ἔχειν", "o": 26, "k": "e)/xein"}, {"t": "τοὺς", "o": 33, "k": "tou/s"}, {"t": "γὰρ", "o": 38, "k": "ga/r"}, {"t": "ἀνθρώπους", "o": 42, "k": "a)nqrw/pous"}]}, {"n": 34, "text": "φησὶν Ἀλκμαίων διὰ τοῦτο ἀπόλλυσθαι, ὅτι οὐ δύνανται τὴν", "tokens": [{"t": "φησὶν", "o": 0, "k": "fhsi/n"}, {"t": "Ἀλκμαίων", "o": 6, "k": "a)lkmai/wn"}, {"t": "διὰ", "o": 15, "k": "dia/"}, {"t": "τοῦτο", "o": 19, "k": "tou=to"}, {"t": "ἀπόλλυσθαι", "o": 25, "k": "a)po/llusqai"}, {"t": "ὅτι", "o": 37, "k": "o(/ti"}, {"t": "οὐ", "o": 41, "k": "ou)"}, {"t": "δύνανται", "o": 44, "k": "du/nantai"}, {"t": "τὴν", "o": 53, "k": "th/n"}]}, {"n": 35, "text": "ἀρχὴν τῷ τέλει προσάψαι, κομψῶς εἰρηκώς, εἴ τις ὡς τύπῳ", "tokens": [{"t": "ἀρχὴν", "o": 0, "k": "a)rxh/n"}, {"t": "τῷ", "o": 6, "k": "tw=|"}, {"t": "τέλει", "o": 9, "k": "te/lei"}, {"t": "προσάψαι", "o": 15, "k": "prosa/yai"}, {"t": "κομψῶς", "o": 25, "k": "komyw=s"}, {"t": "εἰρηκώς", "o": 32, "k": "ei)rhkw/s"}, {"t": "εἴ", "o": 41, "k": "ei)/"}, {"t": "τις", "o": 44, "k": "tis"}, {"t": "ὡς", "o": 48, "k": "w(s"}, {"t": "τύπῳ", "o": 51, "k": "tu/pw|"}]}, {"n": 36, "text": "φράζοντος αὐτοῦ ἀποδέχοιτο καὶ μὴ διακριβοῦν ἐθέλοι τὸ", "tokens": [{"t": "φράζοντος", "o": 0, "k": "fra/zontos"}, {"t": "αὐτοῦ", "o": 10, "k": "au)tou="}, {"t": "ἀποδέχοιτο", "o": 16, "k": "a)pode/xoito"}, {"t": "καὶ", "o": 27, "k": "kai/"}, {"t": "μὴ", "o": 31, "k": "mh/"}, {"t": "διακριβοῦν", "o": 34, "k": "diakribou=n"}, {"t": "ἐθέλοι", "o": 45, "k": "e)qe/loi"}, {"t": "τὸ", "o": 52, "k": "to/"}]}, {"n": 37, "text": "λεχθέν. εἰ δὴ κύκλος ἐστί, τοῦ δὲ κύκλου μήτε ἀρχὴ μήτε", "tokens": [{"t": "λεχθέν", "o": 0, "k": "lexqe/n"}, {"t": "εἰ", "o": 8, "k": "ei)"}, {"t": "δὴ", "o": 11, "k": "dh/"}, {"t": "κύκλος", "o": 14, "k": "ku/klos"}, {"t": "ἐστί", "o": 21, "k": "e)sti/"}, {"t": "τοῦ", "o": 27, "k": "tou="}, {"t": "δὲ", "o": 31, "k": "de/"}, {"t": "κύκλου", "o": 34, "k": "ku/klou"}, {"t": "μήτε", "o": 41, "k": "mh/te"}, {"t": "ἀρχὴ", "o": 46, "k": "a)rxh/"}, {"t": "μήτε", "o": 51, "k": "mh/te"}]}, {"n": 38, "text": "πέρας, οὐδ' ἂν πρότεροι εἶεν τῷ ἐγγυτέρω τῆς ἀρχῆς εἶναι,", "tokens": [{"t": "πέρας", "o": 0, "k": "pe/ras"}, {"t": "οὐδ'", "o": 7, "k": "ou)d'"}, {"t": "ἂν", "o": 12, "k": "a)/n"}, {"t": "πρότεροι", "o": 15, "k": "pro/teroi"}, {"t": "εἶεν", "o": 24, "k": "ei)=en"}, {"t": "τῷ", "o": 29, "k": "tw=|"}, {"t": "ἐγγυτέρω", "o": 32, "k": "e)ggute/rw"}, {"t": "τῆς", "o": 41, "k": "th=s"}, {"t": "ἀρχῆς", "o": 45, "k": "a)rxh=s"}, {"t": "εἶναι", "o": 51, "k": "ei)=nai"}]}, {"n": 39, "text": "οὔθ' ἡμεῖς ἐκείνων οὔτ' ἐκεῖνοι ἡμῶν.", "tokens": [{"t": "οὔθ'", "o": 0, "k": "ou)/q'"}, {"t": "ἡμεῖς", "o": 5, "k": "h(mei=s"}, {"t": "ἐκείνων", "o": 11, "k": "e)kei/nwn"}, {"t": "οὔτ'", "o": 19, "k": "ou)/t'"}, {"t": "ἐκεῖνοι", "o": 24, "k": "e)kei=noi"}, {"t": "ἡμῶν", "o": 32, "k": "h(mw=n"}]}], "english": {"text": "Is it because that which is symmetrical is one, and symmetry more than anything else gives unity to a thing, and that which is one tends to be indivisible, and the indivisible is smaller, whereas asymmetry by causing diversity creates a multiplicity? When things therefore are seen by themselves, their dimensions are less likely to be noticed; but this is not so when they are seen side by side with one another. That then which is indivisible appears to be one, and the impression which it makes on the beholder is one because of its symmetry. But that which is unsymmetrical makes a greater impression, as though it were many, and appears greater because, though in reality only one, it seems to be many; for it partakes of the nature of magnitude, because it is continuous, and of number, because of the inequality of its parts; and so being increased in both these respects, it naturally appears great by the side of that which is simple and one. Why do animals and plants grow more in length than otherwise? Is it because length increases three times over, width twice, and depth once? For length is the first and original dimension, and so it increases both of itself, and secondly in combination with width, and thirdly in combination with depth. But width implies an increase in two dimensions only, in itself and at the same time in depth. In what sense must we understand the terms ‘prior’ and ‘posterior’? As those who lived in the time of Troy are ‘prior’ to us, so are those who lived before them ‘prior’ to them and so on ad infinitum? Or since there is a beginning and a middle and an end of the universe, and when a man, as he becomes old, reaches the limit and turns again towards the beginning, that which is nearer to the beginning is earlier, what prevents our being nearer to the beginning than to the end, in which case we should be ‘prior’? Just as the course of the firmament and of each of the stars is a circle, why should not also the coming into being and the decay of perishable things be of such a kind that the same things again come into being and decay? This agrees with the saying that ‘human life is a circle’. To demand that those who are coming into being should always be numerically identical is foolish, but one would more readily accept the theory of the identity of the species. And so we should ourselves be ‘prior’, and one might suppose the arrangement of the series to be such that it returns back in a circle to the point from which it began and thus secures continuity and identity of composition. For Alcmaeon declares that men perish because they cannot link together the beginning to the end—a clever saying, if one supposes that he uses it metaphorically and the literal meaning is not insisted upon. If then human life is a circle, and a circle has neither beginning nor end, we should not be ‘prior’ to those who lived in the time of Troy nor they ‘prior’ to us by being nearer to the beginning.", "notes": [], "markers": [{"kind": "section", "n": "2", "offset": 952}, {"kind": "section", "n": "3", "offset": 1350}], "bekker": [{"n": 1, "offset": 0, "real": true}, {"n": 5, "offset": 405, "real": true}, {"n": 10, "offset": 804, "real": true}, {"n": 15, "offset": 1120, "real": true}, {"n": 20, "offset": 1522, "real": true}, {"n": 25, "offset": 1870, "real": true}, {"n": 30, "offset": 2245, "real": false}, {"n": 35, "offset": 2619, "real": true}]}}]}