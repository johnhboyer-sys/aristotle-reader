, {"t": "πόματος", "o": 23, "k": "po/matos"}]}, {"n": 10, "text": "Διὰ τί ἐκ τοῦ στόματος καὶ θερμὸν καὶ ψυχρὸν πνέουσιν;", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ἐκ", "o": 7, "k": "e)k"}, {"t": "τοῦ", "o": 10, "k": "tou="}, {"t": "στόματος", "o": 14, "k": "sto/matos"}, {"t": "καὶ", "o": 23, "k": "kai/"}, {"t": "θερμὸν", "o": 27, "k": "qermo/n"}, {"t": "καὶ", "o": 34, "k": "kai/"}, {"t": "ψυχρὸν", "o": 38, "k": "yuxro/n"}, {"t": "πνέουσιν", "o": 45, "k": "pne/ousin"}]}, {"n": 11, "text": "φυσῶσι μὲν γὰρ ψυχρόν, ἀάζουσι δὲ θερμόν. σημεῖον δὲ", "tokens": [{"t": "φυσῶσι", "o": 0, "k": "fusw=si"}, {"t": "μὲν", "o": 7, "k": "me/n"}, {"t": "γὰρ", "o": 11, "k": "ga/r"}, {"t": "ψυχρόν", "o": 15, "k": "yuxro/n"}, {"t": "ἀάζουσι", "o": 23, "k": "a)a/zousi"}, {"t": "δὲ", "o": 31, "k": "de/"}, {"t": "θερμόν", "o": 34, "k": "qermo/n"}, {"t": "σημεῖον", "o": 42, "k": "shmei=on"}, {"t": "δὲ", "o": 50, "k": "de/"}]}, {"n": 12, "text": "ὅτι θερμαίνει, ἐὰν πλησίον προσάγῃ τις τὴν χεῖρα τοῦ στόματος.", "joined": true, "tokens": [{"t": "ὅτι", "o": 0, "k": "o(/ti"}, {"t": "θερμαίνει", "o": 4, "k": "qermai/nei"}, {"t": "ἐὰν", "o": 15, "k": "e)a/n"}, {"t": "πλησίον", "o": 19, "k": "plhsi/on"}, {"t": "προσάγῃ", "o": 27, "k": "prosa/gh|"}, {"t": "τις", "o": 35, "k": "tis"}, {"t": "τὴν", "o": 39, "k": "th/n"}, {"t": "χεῖρα", "o": 43, "k": "xei=ra"}, {"t": "τοῦ", "o": 49, "k": "tou="}, {"t": "στόματος", "o": 53, "k": "sto/matos"}]}, {"n": 13, "text": "ἢ ἀμφοτέρως ὁ ἀὴρ κινούμενος ψυχρός· ὁ δὲ φυσῶν", "joined": true, "tokens": [{"t": "ἢ", "o": 0, "k": "h)/"}, {"t": "ἀμφοτέρως", "o": 2, "k": "a)mfote/rws"}, {"t": "ὁ", "o": 12, "k": "o("}, {"t": "ἀὴρ", "o": 14, "k": "a)h/r"}, {"t": "κινούμενος", "o": 18, "k": "kinou/menos"}, {"t": "ψυχρός", "o": 29, "k": "yuxro/s"}, {"t": "ὁ", "o": 37, "k": "o("}, {"t": "δὲ", "o": 39, "k": "de/"}, {"t": "φυσῶν", "o": 42, "k": "fusw=n"}]}, {"n": 14, "text": "κινεῖ τὸν ἀέρα οὐκ ἀθρόως, ἀλλὰ διὰ στενοῦ τοῦ στόματος·", "tokens": [{"t": "κινεῖ", "o": 0, "k": "kinei="}, {"t": "τὸν", "o": 6, "k": "to/n"}, {"t": "ἀέρα", "o": 10, "k": "a)e/ra"}, {"t": "οὐκ", "o": 15, "k": "ou)k"}, {"t": "ἀθρόως", "o": 19, "k": "a)qro/ws"}, {"t": "ἀλλὰ", "o": 27, "k": "a)lla/"}, {"t": "διὰ", "o": 32, "k": "dia/"}, {"t": "στενοῦ", "o": 36, "k": "stenou="}, {"t": "τοῦ", "o": 43, "k": "tou="}, {"t": "στόματος", "o": 47, "k": "sto/matos"}]}, {"n": 15, "text": "ὀλίγον οὖν ἐκπνέων πολὺν κινεῖ τὸν θύραθεν, ἐν ᾧ τὸ θερμὸν", "tokens": [{"t": "ὀλίγον", "o": 0, "k": "o)li/gon"}, {"t": "οὖν", "o": 7, "k": "ou)=n"}, {"t": "ἐκπνέων", "o": 11, "k": "e)kpne/wn"}, {"t": "πολὺν", "o": 19, "k": "polu/n"}, {"t": "κινεῖ", "o": 25, "k": "kinei="}, {"t": "τὸν", "o": 31, "k": "to/n"}, {"t": "θύραθεν", "o": 35, "k": "qu/raqen"}, {"t": "ἐν", "o": 44, "k": "e)n"}, {"t": "ᾧ", "o": 47, "k": "w(=|"}, {"t": "τὸ", "o": 49, "k": "to/"}, {"t": "θερμὸν", "o": 52, "k": "qermo/n"}]}, {"n": 16, "text": "ὂν τὸ ἐκ τοῦ στόματος οὐ φαίνεται δι' ὀλιγότητα. ὁ δὲ ἀάζων", "tokens": [{"t": "ὂν", "o": 0, "k": "o)/n"}, {"t": "τὸ", "o": 3, "k": "to/"}, {"t": "ἐκ", "o": 6, "k": "e)k"}, {"t": "τοῦ", "o": 9, "k": "tou="}, {"t": "στόματος", "o": 13, "k": "sto/matos"}, {"t": "οὐ", "o": 22, "k": "ou)"}, {"t": "φαίνεται", "o": 25, "k": "fai/netai"}, {"t": "δι'", "o": 34, "k": "di'"}, {"t": "ὀλιγότητα", "o": 38, "k": "o)ligo/thta"}, {"t": "ὁ", "o": 49, "k": "o("}, {"t": "δὲ", "o": 51, "k": "de/"}, {"t": "ἀάζων", "o": 54, "k": "a)a/zwn"}]}, {"n": 17, "text": "ἀθρόον ἐκπνεῖ· διὸ θερμόν. ἔστι γὰρ φυσασμοῦ τῷ διαφέρειν", "joined": true, "tokens": [{"t": "ἀθρόον", "o": 0, "k": "a)qro/on"}, {"t": "ἐκπνεῖ", "o": 7, "k": "e)kpnei="}, {"t": "διὸ", "o": 15, "k": "dio/"}, {"t": "θερμόν", "o": 19, "k": "qermo/n"}, {"t": "ἔστι", "o": 27, "k": "e)/sti"}, {"t": "γὰρ", "o": 32, "k": "ga/r"}, {"t": "φυσασμοῦ", "o": 36, "k": "fusasmou="}, {"t": "τῷ", "o": 45, "k": "tw=|"}, {"t": "διαφέρειν", "o": 48, "k": "diafe/rein"}]}, {"n": 18, "text": "τῇ συστροφῇ· ὁ δ' ἀασμὸς ἀθρόου ἔκπνευσις.", "tokens": [{"t": "τῇ", "o": 0, "k": "th=|"}, {"t": "συστροφῇ", "o": 3, "k": "sustrofh=|"}, {"t": "ὁ", "o": 13, "k": "o("}, {"t": "δ'", "o": 15, "k": "d'"}, {"t": "ἀασμὸς", "o": 18, "k": "a)asmo/s"}, {"t": "ἀθρόου", "o": 25, "k": "a)qro/ou"}, {"t": "ἔκπνευσις", "o": 32, "k": "e)/kpneusis"}]}, {"n": 19, "text": "Διὰ τί, ἐὰν σφόδρα καὶ ἀθρόον ἐκπνεύσωσιν, ἀδυνατοῦσι", "joined": true, "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ἐὰν", "o": 8, "k": "e)a/n"}, {"t": "σφόδρα", "o": 12, "k": "sfo/dra"}, {"t": "καὶ", "o": 19, "k": "kai/"}, {"t": "ἀθρόον", "o": 23, "k": "a)qro/on"}, {"t": "ἐκπνεύσωσιν", "o": 30, "k": "e)kpneu/swsin"}, {"t": "ἀδυνατοῦσι", "o": 43, "k": "a)dunatou=si"}]}, {"n": 20, "text": "πάλιν ἐκπνεῦσαι; ὁμοίως δὲ ἔχει καὶ ἐπὶ τοῦ ἀναπνεῦσαι·", "joined": true, "tokens": [{"t": "πάλιν", "o": 0, "k": "pa/lin"}, {"t": "ἐκπνεῦσαι", "o": 6, "k": "e)kpneu=sai"}, {"t": "ὁμοίως", "o": 17, "k": "o(moi/ws"}, {"t": "δὲ", "o": 24, "k": "de/"}, {"t": "ἔχει", "o": 27, "k": "e)/xei"}, {"t": "καὶ", "o": 32, "k": "kai/"}, {"t": "ἐπὶ", "o": 36, "k": "e)pi/"}, {"t": "τοῦ", "o": 40, "k": "tou="}, {"t": "ἀναπνεῦσαι", "o": 44, "k": "a)napneu=sai"}]}, {"n": 21, "text": "ἀδυνατοῦσι γὰρ δὶς ἐφεξῆς ποιεῖν αὐτό. ἢ ὅτι τὸ μὲν", "tokens": [{"t": "ἀδυνατοῦσι", "o": 0, "k": "a)dunatou=si"}, {"t": "γὰρ", "o": 11, "k": "ga/r"}, {"t": "δὶς", "o": 15, "k": "di/s"}, {"t": "ἐφεξῆς", "o": 19, "k": "e)fech=s"}, {"t": "ποιεῖν", "o": 26, "k": "poiei=n"}, {"t": "αὐτό", "o": 33, "k": "au)to/"}, {"t": "ἢ", "o": 39, "k": "h)/"}, {"t": "ὅτι", "o": 41, "k": "o(/ti"}, {"t": "τὸ", "o": 45, "k": "to/"}, {"t": "μὲν", "o": 48, "k": "me/n"}]}, {"n": 22, "text": "δίωσίς τίς ἐστι, τὸ δὲ συναγωγὴ τόπου· ἃ ἄχρι τινός ἐστι", "tokens": [{"t": "δίωσίς", "o": 0, "k": "di/wsis"}, {"t": "τίς", "o": 7, "k": "ti/s"}, {"t": "ἐστι", "o": 11, "k": "e)sti"}, {"t": "τὸ", "o": 17, "k": "to/"}, {"t": "δὲ", "o": 20, "k": "de/"}, {"t": "συναγωγὴ", "o": 23, "k": "sunagwgh/"}, {"t": "τ