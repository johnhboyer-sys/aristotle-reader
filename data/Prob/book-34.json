{"book": 34, "segments": [{"id": "34:963b", "column": "963b", "chapterStarts": [{"chapter": "1", "beforeLine": 18, "wordIndex": 0, "engOffset": 0, "bekker": "963b18–21"}, {"chapter": "2", "beforeLine": 22, "wordIndex": 0, "engOffset": 269, "bekker": "963b22–25"}, {"chapter": "3", "beforeLine": 26, "wordIndex": 0, "engOffset": 514, "bekker": "963b26–32"}, {"chapter": "4", "beforeLine": 33, "wordIndex": 0, "engOffset": 1024, "bekker": "963b33–40"}], "greek": [{"n": 17, "text": "ΛΔ. ΟΣΑ ΠΕΡΙ ΤΟ ΣΤΟΜΑ ΚΑΙ ΤΑ ΕΝ ΑΥΤῼ.", "tokens": [{"t": "ΛΔ", "o": 0, "k": "ld"}, {"t": "ΟΣΑ", "o": 4, "k": "osa"}, {"t": "ΠΕΡΙ", "o": 8, "k": "peri"}, {"t": "ΤΟ", "o": 13, "k": "to"}, {"t": "ΣΤΟΜΑ", "o": 16, "k": "stoma"}, {"t": "ΚΑΙ", "o": 22, "k": "kai"}, {"t": "ΤΑ", "o": 26, "k": "ta"}, {"t": "ΕΝ", "o": 29, "k": "en"}, {"t": "ΑΥΤῼ", "o": 32, "k": "autw|"}]}, {"n": 18, "text": "Διὰ τί οἱ μανοὺς ἔχοντες τοὺς ὀδόντας οὐ μακρόβιοι; ἢ", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "οἱ", "o": 7, "k": "oi("}, {"t": "μανοὺς", "o": 10, "k": "manou/s"}, {"t": "ἔχοντες", "o": 17, "k": "e)/xontes"}, {"t": "τοὺς", "o": 25, "k": "tou/s"}, {"t": "ὀδόντας", "o": 30, "k": "o)do/ntas"}, {"t": "οὐ", "o": 38, "k": "ou)"}, {"t": "μακρόβιοι", "o": 41, "k": "makro/bioi"}, {"t": "ἢ", "o": 52, "k": "h)/"}]}, {"n": 19, "text": "ὅτι τὰ μακρόβια πλείους ἔχουσιν, οἷον τὰ ἄρσενα τῶν θηλειῶν,", "tokens": [{"t": "ὅτι", "o": 0, "k": "o(/ti"}, {"t": "τὰ", "o": 4, "k": "ta/"}, {"t": "μακρόβια", "o": 7, "k": "makro/bia"}, {"t": "πλείους", "o": 16, "k": "plei/ous"}, {"t": "ἔχουσιν", "o": 24, "k": "e)/xousin"}, {"t": "οἷον", "o": 33, "k": "oi(=on"}, {"t": "τὰ", "o": 38, "k": "ta/"}, {"t": "ἄρσενα", "o": 41, "k": "a)/rsena"}, {"t": "τῶν", "o": 48, "k": "tw=n"}, {"t": "θηλειῶν", "o": 52, "k": "qhleiw=n"}]}, {"n": 20, "text": "ἄνδρες γυναικῶν, πρόβατα προβάτων. οἱ οὖν ἀραιώδοντες", "tokens": [{"t": "ἄνδρες", "o": 0, "k": "a)/ndres"}, {"t": "γυναικῶν", "o": 7, "k": "gunaikw=n"}, {"t": "πρόβατα", "o": 17, "k": "pro/bata"}, {"t": "προβάτων", "o": 25, "k": "proba/twn"}, {"t": "οἱ", "o": 35, "k": "oi("}, {"t": "οὖν", "o": 38, "k": "ou)=n"}, {"t": "ἀραιώδοντες", "o": 42, "k": "a)raiw/dontes"}]}, {"n": 21, "text": "ὥσπερ ἂν ἐλάττονας ἔχουσιν ὀδόντας ἐοίκασιν.", "tokens": [{"t": "ὥσπερ", "o": 0, "k": "w(/sper"}, {"t": "ἂν", "o": 6, "k": "a)/n"}, {"t": "ἐλάττονας", "o": 9, "k": "e)la/ttonas"}, {"t": "ἔχουσιν", "o": 19, "k": "e)/xousin"}, {"t": "ὀδόντας", "o": 27, "k": "o)do/ntas"}, {"t": "ἐοίκασιν", "o": 35, "k": "e)oi/kasin"}]}, {"n": 22, "text": "Διὰ τί οἱ ὀδόντες ἰσχυρότεροι τῶν σαρκῶν ὄντες ὅμως", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "οἱ", "o": 7, "k": "oi("}, {"t": "ὀδόντες", "o": 10, "k": "o)do/ntes"}, {"t": "ἰσχυρότεροι", "o": 18, "k": "i)sxuro/teroi"}, {"t": "τῶν", "o": 30, "k": "tw=n"}, {"t": "σαρκῶν", "o": 34, "k": "sarkw=n"}, {"t": "ὄντες", "o": 41, "k": "o)/ntes"}, {"t": "ὅμως", "o": 47, "k": "o(/mws"}]}, {"n": 23, "text": "τοῦ ψυχροῦ αἰσθάνονται μᾶλλον; ἢ ὅτι ἐπὶ τοὺς πόρους προςπεφύκασιν,", "joined": true, "tokens": [{"t": "τοῦ", "o": 0, "k": "tou="}, {"t": "ψυχροῦ", "o": 4, "k": "yuxrou="}, {"t": "αἰσθάνονται", "o": 11, "k": "ai)sqa/nontai"}, {"t": "μᾶλλον", "o": 23, "k": "ma=llon"}, {"t": "ἢ", "o": 31, "k": "h)/"}, {"t": "ὅτι", "o": 33, "k": "o(/ti"}, {"t": "ἐπὶ", "o": 37, "k": "e)pi/"}, {"t": "τοὺς", "o": 41, "k": "tou/s"}, {"t": "πόρους", "o": 46, "k": "po/rous"}, {"t": "προςπεφύκασιν", "o": 53, "k": "prospefu/kasin"}]}, {"n": 24, "text": "ἐν οἷς ὀλίγον ὂν τὸ θερμὸν ταχὺ ὑπὸ τοῦ ψυχροῦ", "tokens": [{"t": "ἐν", "o": 0, "k": "e)n"}, {"t": "οἷς", "o": 3, "k": "oi(=s"}, {"t": "ὀλίγον", "o": 7, "k": "o)li/gon"}, {"t": "ὂν", "o": 14, "k": "o)/n"}, {"t": "τὸ", "o": 17, "k": "to/"}, {"t": "θερμὸν", "o": 20, "k": "qermo/n"}, {"t": "ταχὺ", "o": 27, "k": "taxu/"}, {"t": "ὑπὸ", "o": 32, "k": "u(po/"}, {"t": "τοῦ", "o": 36, "k": "tou="}, {"t": "ψυχροῦ", "o": 40, "k": "yuxrou="}]}, {"n": 25, "text": "κρατούμενον ποιεῖ τὴν ἀλγηδόνα;", "tokens": [{"t": "κρατούμενον", "o": 0, "k": "kratou/menon"}, {"t": "ποιεῖ", "o": 12, "k": "poiei="}, {"t": "τὴν", "o": 18, "k": "th/n"}, {"t": "ἀλγηδόνα", "o": 22, "k": "a)lghdo/na"}]}, {"n": 26, "text": "Διὰ τί τοῦ ψυχροῦ μᾶλλον αἰσθάνονται οἱ ὀδόντες ἢ", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "τοῦ", "o": 7, "k": "tou="}, {"t": "ψυχροῦ", "o": 11, "k": "yuxrou="}, {"t": "μᾶλλον", "o": 18, "k": "ma=llon"}, {"t": "αἰσθάνονται", "o": 25, "k": "ai)sqa/nontai"}, {"t": "οἱ", "o": 37, "k": "oi("}, {"t": "ὀδόντες", "o": 40, "k": "o)do/ntes"}, {"t": "ἢ", "o": 48, "k": "h)/"}]}, {"n": 27, "text": "τοῦ θερμοῦ, ἡ δὲ σὰρξ τοὐναντίον; πότερον ὅτι ἡ μὲν σὰρξ τοῦ", "tokens": [{"t": "τοῦ", "o": 0, "k": "tou="}, {"t": "θερμοῦ", "o": 4, "k": "qermou="}, {"t": "ἡ", "o": 12, "k": "h("}, {"t": "δὲ", "o": 14, "k": "de/"}, {"t": "σὰρξ", "o": 17, "k": "sa/rc"}, {"t": "τοὐναντίον", "o": 22, "k": "tou)nanti/on"}, {"t": "πότερον", "o": 34, "k": "po/teron"}, {"t": "ὅτι", "o": 42, "k": "o(/ti"}, {"t": "ἡ", "o": 46, "k": "h("}, {"t": "μὲν", "o": 48, "k": "me/n"}, {"t": "σὰρξ", "o": 52, "k": "sa/rc"}, {"t": "τοῦ", "o": 57, "k": "tou="}]}, {"n": 28, "text": "μέσου καὶ εὔκρατος, οἱ δὲ ὀδόντες ψυχροί, ὥστε τοῦ ἐναντίου", "tokens": [{"t": "μέσου", "o": 0, "k": "me/sou"}, {"t": "καὶ", "o": 6, "k": "kai/"}, {"t": "εὔκρατος", "o": 10, "k": "eu)/kratos"}, {"t": "οἱ", "o": 20, "k": "oi("}, {"t": "δὲ", "o": 23, "k": "de/"}, {"t": "ὀδόντες", "o": 26, "k": "o)do/ntes"}, {"t": "ψυχροί", "o": 34, "k": "yuxroi/"}, {"t": "ὥστε", "o": 42, "k": "w(/ste"}, {"t": "τοῦ", "o": 47, "k": "tou="}, {"t": "ἐναντίου", "o": 51, "k": "e)nanti/ou"}]}, {"n": 29, "text": "μᾶλλον αἰσθητικοί; ἢ διότι λεπτῶν πόρων εἰσίν, ἐν οἷς μικρὸν", "joined": true, "tokens": [{"t": "μᾶλλον", "o": 0, "k": "ma=llon"}, {"t": "αἰσθητικοί", "o": 7, "k": "ai)sqhtikoi/"}, {"t": "ἢ", "o": 19, "k": "h)/"}, {"t": "διότι", "o": 21, "k": "dio/ti"}, {"t": "λεπτῶν", "o": 27, "k": "leptw=n"}, {"t": "πόρων", "o": 34, "k": "po/rwn"}, {"t": "εἰσίν", "o": 40, "k": "ei)si/n"}, {"t": "ἐν", "o": 47, "k": "e)n"}, {"t": "οἷς", "o": 50, "k": "oi(=s"}, {"t": "μικρὸν", "o": 54, "k": "mikro/n"}]}, {"n": 30, "text": "τὸ θερμόν, ὥστε ταχὺ πάσχουσιν ὑπὸ τοῦ ἐναντίου; ἡ δὲ", "tokens": [{"t": "τὸ", "o": 0, "k": "to/"}, {"t": "θερμόν", "o": 3, "k": "qermo/n"}, {"t": "ὥστε", "o": 11, "k": "w(/ste"}, {"t": "ταχὺ", "o": 16, "k": "taxu/"}, {"t": "πάσχουσιν", "o": 21, "k": "pa/sxousin"}, {"t": "ὑπὸ", "o": 31, "k": "u(po/"}, {"t": "τοῦ", "o": 35, "k": "tou="}, {"t": "ἐναντίου", "o": 39, "k": "e)nanti/ou"}, {"t": "ἡ", "o": 49, "k": "h("}, {"t": "δὲ", "o": 51, "k": "de/"}]}, {"n": 31, "text": "σὰρξ θερμόν, ὥστε οὐδὲν πάσχει ὑπὸ τοῦ ψυχροῦ, τοῦ δὲ θερμοῦ", "joined": true, "tokens": [{"t": "σὰρξ", "o": 0, "k": "sa/rc"}, {"t": "θερμόν", "o": 5, "k": "qermo/n"}, {"t": "ὥστε", "o": 13, "k": "w(/ste"}, {"t": "οὐδὲν", "o": 18, "k": "ou)de/n"}, {"t": "πάσχει", "o": 24, "k": "pa/sxei"}, {"t": "ὑπὸ", "o": 31, "k": "u(po/"}, {"t": "τοῦ", "o": 35, "k": "tou="}, {"t": "ψυχροῦ", "o": 39, "k": "yuxrou="}, {"t": "τοῦ", "o": 47, "k": "tou="}, {"t": "δὲ", "o": 51, "k": "de/"}, {"t": "θερμοῦ", "o": 54, "k": "qermou="}]}, {"n": 32, "text": "ταχὺ αἰσθάνεται· ὥσπερ γὰρ πῦρ ἐπὶ πυρὶ γίνεται.", "tokens": [{"t": "ταχὺ", "o": 0, "k": "taxu/"}, {"t": "αἰσθάνεται", "o": 5, "k": "ai)sqa/netai"}, {"t": "ὥσπερ", "o": 17, "k": "w(/sper"}, {"t": "γὰρ", "o": 23, "k": "ga/r"}, {"t": "πῦρ", "o": 27, "k": "pu=r"}, {"t": "ἐπὶ", "o": 31, "k": "e)pi/"}, {"t": "πυρὶ", "o": 35, "k": "puri/"}, {"t": "γίνεται", "o": 40, "k": "gi/netai"}]}, {"n": 33, "text": "Διὰ τί ἡ γλῶττα σημαντικὸν πολλῶν; καὶ γὰρ τῶν", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ἡ", "o": 7, "k": "h("}, {"t": "γλῶττα", "o": 9, "k": "glw=tta"}, {"t": "σημαντικὸν", "o": 16, "k": "shmantiko/n"}, {"t": "πολλῶν", "o": 27, "k": "pollw=n"}, {"t": "καὶ", "o": 35, "k": "kai/"}, {"t": "γὰρ", "o": 39, "k": "ga/r"}, {"t": "τῶν", "o": 43, "k": "tw=n"}]}, {"n": 34, "text": "πυρετῶν ἐν τοῖς ὀξέσι νοσήμασι, καὶ ἐὰν χάλαζαι ἐνῶσιν·", "tokens": [{"t": "πυρετῶν", "o": 0, "k": "puretw=n"}, {"t": "ἐν", "o": 8, "k": "e)n"}, {"t": "τοῖς", "o": 11, "k": "toi=s"}, {"t": "ὀξέσι", "o": 16, "k": "o)ce/si"}, {"t": "νοσήμασι", "o": 22, "k": "nosh/masi"}, {"t": "καὶ", "o": 32, "k": "kai/"}, {"t": "ἐὰν", "o": 36, "k": "e)a/n"}, {"t": "χάλαζαι", "o": 40, "k": "xa/lazai"}, {"t": "ἐνῶσιν", "o": 48, "k": "e)nw=sin"}]}, {"n": 35, "text": "καὶ τῶν ποικίλων προβάτων ποικίλαι. ἢ ὅτι ὑγρότητος δεκτικόν,", "joined": true, "tokens": [{"t": "καὶ", "o": 0, "k": "kai/"}, {"t": "τῶν", "o": 4, "k": "tw=n"}, {"t": "ποικίλων", "o": 8, "k": "poiki/lwn"}, {"t": "προβάτων", "o": 17, "k": "proba/twn"}, {"t": "ποικίλαι", "o": 26, "k": "poiki/lai"}, {"t": "ἢ", "o": 36, "k": "h)/"}, {"t": "ὅτι", "o": 38, "k": "o(/ti"}, {"t": "ὑγρότητος", "o": 42, "k": "u(gro/thtos"}, {"t": "δεκτικόν", "o": 52, "k": "dektiko/n"}]}, {"n": 36, "text": "καὶ ἐπὶ τῷ πνεύμονι ἐπίκειται, οὗ ἡ ἀρχὴ ἐπὶ τῶν πυρετῶν.", "joined": true, "tokens": [{"t": "καὶ", "o": 0, "k": "kai/"}, {"t": "ἐπὶ", "o": 4, "k": "e)pi/"}, {"t": "τῷ", "o": 8, "k": "tw=|"}, {"t": "πνεύμονι", "o": 11, "k": "pneu/moni"}, {"t": "ἐπίκειται", "o": 20, "k": "e)pi/keitai"}, {"t": "οὗ", "o": 31, "k": "ou(="}, {"t": "ἡ", "o": 34, "k": "h("}, {"t": "ἀρχὴ", "o": 36, "k": "a)rxh/"}, {"t": "ἐπὶ", "o": 41, "k": "e)pi/"}, {"t": "τῶν", "o": 45, "k": "tw=n"}, {"t": "πυρετῶν", "o": 49, "k": "puretw=n"}]}, {"n": 37, "text": "πολύχροα δὲ πάντα διὰ τὴν πολύχροιαν τῶν ὑγρῶν·", "tokens": [{"t": "πολύχροα", "o": 0, "k": "polu/xroa"}, {"t": "δὲ", "o": 9, "k": "de/"}, {"t": "πάντα", "o": 12, "k": "pa/nta"}, {"t": "διὰ", "o": 18, "k": "dia/"}, {"t": "τὴν", "o": 22, "k": "th/n"}, {"t": "πολύχροιαν", "o": 26, "k": "polu/xroian"}, {"t": "τῶν", "o": 37, "k": "tw=n"}, {"t": "ὑγρῶν", "o": 41, "k": "u(grw=n"}]}, {"n": 38, "text": "βάπτεται δὲ πρῶτον δι' οὗ πρῶτον ἠθεῖται· ἡ δὲ γλῶττα", "tokens": [{"t": "βάπτεται", "o": 0, "k": "ba/ptetai"}, {"t": "δὲ", "o": 9, "k": "de/"}, {"t": "πρῶτον", "o": 12, "k": "prw=ton"}, {"t": "δι'", "o": 19, "k": "di'"}, {"t": "οὗ", "o": 23, "k": "ou(="}, {"t": "πρῶτον", "o": 26, "k": "prw=ton"}, {"t": "ἠθεῖται", "o": 33, "k": "h)qei=tai"}, {"t": "ἡ", "o": 42, "k": "h("}, {"t": "δὲ", "o": 44, "k": "de/"}, {"t": "γλῶττα", "o": 47, "k": "glw=tta"}]}, {"n": 39, "text": "τοιοῦτον. αἵ τε χάλαζαι διὰ τὸ σομφὴν εἶναι συλλέγονται·", "tokens": [{"t": "τοιοῦτον", "o": 0, "k": "toiou=ton"}, {"t": "αἵ", "o": 10, "k": "ai(/"}, {"t": "τε", "o": 13, "k": "te"}, {"t": "χάλαζαι", "o": 16, "k": "xa/lazai"}, {"t": "διὰ", "o": 24, "k": "dia/"}, {"t": "τὸ", "o": 28, "k": "to/"}, {"t": "σομφὴν", "o": 31, "k": "somfh/n"}, {"t": "εἶναι", "o": 38, "k": "ei)=nai"}, {"t": "συλλέγονται", "o": 44, "k": "sulle/gontai"}]}, {"n": 40, "text": "ἔστι γὰρ ἡ χάλαζα οἱονεὶ ἴονθος ἄπεπτος ἐν τοῖς ἐντός.", "tokens": [{"t": "ἔστι", "o": 0, "k": "e)/sti"}, {"t": "γὰρ", "o": 5, "k": "ga/r"}, {"t": "ἡ", "o": 9, "k": "h("}, {"t": "χάλαζα", "o": 11, "k": "xa/laza"}, {"t": "οἱονεὶ", "o": 18, "k": "oi(onei/"}, {"t": "ἴονθος", "o": 25, "k": "i)/onqos"}, {"t": "ἄπεπτος", "o": 32, "k": "a)/peptos"}, {"t": "ἐν", "o": 40, "k": "e)n"}, {"t": "τοῖς", "o": 43, "k": "toi=s"}, {"t": "ἐντός", "o": 48, "k": "e)nto/s"}]}], "english": {"text": "Why is it that those who have spongy teeth are not long-lived? Is it because the long-lived have more teeth, for instance males have more than females, men than women, and rams than ewes? Those then who have spongy teeth apparently resemble those who have fewer teeth. Why is it that, though the teeth are stronger than the flesh, yet they are more sensitive to cold? Is it because they are closely connected with the pores, in which the heat, because it is small, is quickly overcome by the cold and causes pain? Why are the teeth more sensitive to cold than to heat, while the contrary is true of the flesh? Is it because the flesh partakes of the mean and is of moderate temperature, but the teeth are cold and therefore more sensitive to cold? Or is it because the teeth consist of narrow pores in which the heat is scanty, so that they are quickly affected by the opposite of heat? Now the flesh is warm, so that it is unaffected by the cold, but is quickly sensitive to heat; for it is a case of ‘fire added to fire’. Why is it that the tongue is indicative of many things? For in acute diseases it indicates fever by the presence of blisters upon it; also the tongues of sheep are particoloured if the sheep are so. Is it because the tongue is capable of taking up moisture and is situated near the lungs, which are the seat of fevers? Now all things which are particoloured are so because their humours are particoloured, and that part first takes on colour through which the humour first passes; and this is what happens to the tongue. Now blisters collect on the tongue because it is spongy; for a blister is as it were an eruption which has not been concocted within.", "notes": [], "markers": [{"kind": "section", "n": "1", "offset": 0}, {"kind": "section", "n": "2", "offset": 269}, {"kind": "section", "n": "3", "offset": 514}, {"kind": "section", "n": "4", "offset": 1024}], "bekker": [{"n": 17, "offset": 0, "real": true}, {"n": 20, "offset": 109, "real": true}, {"n": 25, "offset": 455, "real": false}, {"n": 30, "offset": 799, "real": true}, {"n": 35, "offset": 1202, "real": true}, {"n": 40, "offset": 1608, "real": true}]}}, {"id": "34:964a", "column": "964a", "chapterStarts": [{"chapter": "5", "beforeLine": 1, "wordIndex": 0, "engOffset": 0, "bekker": "964a1–3"}, {"chapter": "6", "beforeLine": 4, "wordIndex": 0, "engOffset": 179, "bekker": "964a4–9"}, {"chapter": "7", "beforeLine": 10, "wordIndex": 0, "engOffset": 565, "bekker": "964a10–18"}, {"chapter": "8", "beforeLine": 19, "wordIndex": 0, "engOffset": 1348, "bekker": "964a19–24"}, {"chapter": "9", "beforeLine": 25, "wordIndex": 0, "engOffset": 1801, "bekker": "964a25–32"}, {"chapter": "10", "beforeLine": 33, "wordIndex": 0, "engOffset": 2333, "bekker": "964a33–38"}, {"chapter": "11", "beforeLine": 39, "wordIndex": 0, "engOffset": 2834, "bekker": "964a39–964b4"}], "greek": [{"n": 1, "text": "Διὰ τί ἡ γλῶττα γλυκεῖα μὲν οὐ γίνεται, πικρὰ δὲ", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ἡ", "o": 7, "k": "h("}, {"t": "γλῶττα", "o": 9, "k": "glw=tta"}, {"t": "γλυκεῖα", "o": 16, "k": "glukei=a"}, {"t": "μὲν", "o": 24, "k": "me/n"}, {"t": "οὐ", "o": 28, "k": "ou)"}, {"t": "γίνεται", "o": 31, "k": "gi/netai"}, {"t": "πικρὰ", "o": 40, "k": "pikra/"}, {"t": "δὲ", "o": 46, "k": "de/"}]}, {"n": 2, "text": "καὶ ἁλμυρὰ καὶ ὀξεῖα; ἢ ὅτι διαφθοραὶ ταῦτ' ἐστί, τῆς δὲ", "tokens": [{"t": "καὶ", "o": 0, "k": "kai/"}, {"t": "ἁλμυρὰ", "o": 4, "k": "a(lmura/"}, {"t": "καὶ", "o": 11, "k": "kai/"}, {"t": "ὀξεῖα", "o": 15, "k": "o)cei=a"}, {"t": "ἢ", "o": 22, "k": "h)/"}, {"t": "ὅτι", "o": 24, "k": "o(/ti"}, {"t": "διαφθοραὶ", "o": 28, "k": "diafqorai/"}, {"t": "ταῦτ'", "o": 38, "k": "tau=t'"}, {"t": "ἐστί", "o": 44, "k": "e)sti/"}, {"t": "τῆς", "o": 50, "k": "th=s"}, {"t": "δὲ", "o": 54, "k": "de/"}]}, {"n": 3, "text": "φύσεως οὐκ αἰσθάνεται;", "tokens": [{"t": "φύσεως", "o": 0, "k": "fu/sews"}, {"t": "οὐκ", "o": 7, "k": "ou)k"}, {"t": "αἰσθάνεται", "o": 11, "k": "ai)sqa/netai"}]}, {"n": 4, "text": "Διὰ τί, ὅσας ἂν χρόας ἔχῃ τὸ δέρμα, τοσαύτας ἔχει", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "ὅσας", "o": 8, "k": "o(/sas"}, {"t": "ἂν", "o": 13, "k": "a)/n"}, {"t": "χρόας", "o": 16, "k": "xro/as"}, {"t": "ἔχῃ", "o": 22, "k": "e)/xh|"}, {"t": "τὸ", "o": 26, "k": "to/"}, {"t": "δέρμα", "o": 29, "k": "de/rma"}, {"t": "τοσαύτας", "o": 36, "k": "tosau/tas"}, {"t": "ἔχει", "o": 45, "k": "e)/xei"}]}, {"n": 5, "text": "καὶ ἡ γλῶττα; πότερον ὅτι ἓν μέρος ἐστὶν ὥσπερ ἄλλο τι", "tokens": [{"t": "καὶ", "o": 0, "k": "kai/"}, {"t": "ἡ", "o": 4, "k": "h("}, {"t": "γλῶττα", "o": 6, "k": "glw=tta"}, {"t": "πό