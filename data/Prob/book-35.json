{"book": 35, "segments": [{"id": "35:964b", "column": "964b", "chapterStarts": [{"chapter": "1", "beforeLine": 22, "wordIndex": 0, "engOffset": 0, "bekker": "964b22–29"}, {"chapter": "2", "beforeLine": 30, "wordIndex": 0, "engOffset": 660, "bekker": "964b30–32"}, {"chapter": "3", "beforeLine": 33, "wordIndex": 0, "engOffset": 869, "bekker": "964b33–38"}, {"chapter": "4", "beforeLine": 39, "wordIndex": 0, "engOffset": 1295, "bekker": "964b39–965a7"}], "greek": [{"n": 21, "text": "ΛΕ. ΟΣΑ ΠΕΡΙ ΤΑ ΥΠΟ ΤΗΝ ΑΦΗΝ.", "tokens": [{"t": "ΛΕ", "o": 0, "k": "le"}, {"t": "ΟΣΑ", "o": 4, "k": "osa"}, {"t": "ΠΕΡΙ", "o": 8, "k": "peri"}, {"t": "ΤΑ", "o": 13, "k": "ta"}, {"t": "ΥΠΟ", "o": 16, "k": "upo"}, {"t": "ΤΗΝ", "o": 20, "k": "thn"}, {"t": "ΑΦΗΝ", "o": 24, "k": "afhn"}]}, {"n": 22, "text": "Διὰ τί μᾶλλον φρίττομεν ἑτέρου θιγόντος πως ἢ αὐτοὶ", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "μᾶλλον", "o": 7, "k": "ma=llon"}, {"t": "φρίττομεν", "o": 14, "k": "fri/ttomen"}, {"t": "ἑτέρου", "o": 24, "k": "e(te/rou"}, {"t": "θιγόντος", "o": 31, "k": "qigo/ntos"}, {"t": "πως", "o": 40, "k": "pws"}, {"t": "ἢ", "o": 44, "k": "h)/"}, {"t": "αὐτοὶ", "o": 46, "k": "au)toi/"}]}, {"n": 23, "text": "ἡμῶν; ἢ ὅτι αἰσθητικωτέρα ἡ ἁφὴ τοῦ ἀλλοτρίου ἢ ἡ τοῦ", "tokens": [{"t": "ἡμῶν", "o": 0, "k": "h(mw=n"}, {"t": "ἢ", "o": 6, "k": "h)/"}, {"t": "ὅτι", "o": 8, "k": "o(/ti"}, {"t": "αἰσθητικωτέρα", "o": 12, "k": "ai)sqhtikwte/ra"}, {"t": "ἡ", "o": 26, "k": "h("}, {"t": "ἁφὴ", "o": 28, "k": "a(fh/"}, {"t": "τοῦ", "o": 32, "k": "tou="}, {"t": "ἀλλοτρίου", "o": 36, "k": "a)llotri/ou"}, {"t": "ἢ", "o": 46, "k": "h)/"}, {"t": "ἡ", "o": 48, "k": "h("}, {"t": "τοῦ", "o": 50, "k": "tou="}]}, {"n": 24, "text": "οἰκείου; τὸ γὰρ συμφυὲς ἀναίσθητον. καὶ φοβερώτερον τὸ", "tokens": [{"t": "οἰκείου", "o": 0, "k": "oi)kei/ou"}, {"t": "τὸ", "o": 9, "k": "to/"}, {"t": "γὰρ", "o": 12, "k": "ga/r"}, {"t": "συμφυὲς", "o": 16, "k": "sumfue/s"}, {"t": "ἀναίσθητον", "o": 24, "k": "a)nai/sqhton"}, {"t": "καὶ", "o": 36, "k": "kai/"}, {"t": "φοβερώτερον", "o": 40, "k": "foberw/teron"}, {"t": "τὸ", "o": 52, "k": "to/"}]}, {"n": 25, "text": "λάθρᾳ καὶ ἐξαπιναίως γινόμενον, ὁ δὲ φόβος κατάψυξις·", "tokens": [{"t": "λάθρᾳ", "o": 0, "k": "la/qra|"}, {"t": "καὶ", "o": 6, "k": "kai/"}, {"t": "ἐξαπιναίως", "o": 10, "k": "e)capinai/ws"}, {"t": "γινόμενον", "o": 21, "k": "gino/menon"}, {"t": "ὁ", "o": 32, "k": "o("}, {"t": "δὲ", "o": 34, "k": "de/"}, {"t": "φόβος", "o": 37, "k": "fo/bos"}, {"t": "κατάψυξις", "o": 43, "k": "kata/yucis"}]}, {"n": 26, "text": "ἡ δὲ ἀλλοτρία ἁφὴ πρὸς τὴν οἰκείαν ἄμφω ταῦτα ἔχει", "tokens": [{"t": "ἡ", "o": 0, "k": "h("}, {"t": "δὲ", "o": 2, "k": "de/"}, {"t": "ἀλλοτρία", "o": 5, "k": "a)llotri/a"}, {"t": "ἁφὴ", "o": 14, "k": "a(fh/"}, {"t": "πρὸς", "o": 18, "k": "pro/s"}, {"t": "τὴν", "o": 23, "k": "th/n"}, {"t": "οἰκείαν", "o": 27, "k": "oi)kei/an"}, {"t": "ἄμφω", "o": 35, "k": "a)/mfw"}, {"t": "ταῦτα", "o": 40, "k": "tau=ta"}, {"t": "ἔχει", "o": 46, "k": "e)/xei"}]}, {"n": 27, "text": "καὶ ὅλως δὲ παθητικὸν ἕκαστον πέφυκεν ἢ μᾶλλον ἢ μόνον", "tokens": [{"t": "καὶ", "o": 0, "k": "kai/"}, {"t": "ὅλως", "o": 4, "k": "o(/lws"}, {"t": "δὲ", "o": 9, "k": "de/"}, {"t": "παθητικὸν", "o": 12, "k": "paqhtiko/n"}, {"t": "ἕκαστον", "o": 22, "k": "e(/kaston"}, {"t": "πέφυκεν", "o": 30, "k": "pe/fuken"}, {"t": "ἢ", "o": 38, "k": "h)/"}, {"t": "μᾶλλον", "o": 40, "k": "ma=llon"}, {"t": "ἢ", "o": 47, "k": "h)/"}, {"t": "μόνον", "o": 49, "k": "mo/non"}]}, {"n": 28, "text": "ὑπ' ἄλλου ἢ ὑφ' αὑτοῦ, οἷον καὶ ἐπὶ τοῦ γαργαλίζεσθαι", "tokens": [{"t": "ὑπ'", "o": 0, "k": "u(p'"}, {"t": "ἄλλου", "o": 4, "k": "a)/llou"}, {"t": "ἢ", "o": 10, "k": "h)/"}, {"t": "ὑφ'", "o": 12, "k": "u(f'"}, {"t": "αὑτοῦ", "o": 16, "k": "au(tou="}, {"t": "οἷον", "o": 23, "k": "oi(=on"}, {"t": "καὶ", "o": 28, "k": "kai/"}, {"t": "ἐπὶ", "o": 32, "k": "e)pi/"}, {"t": "τοῦ", "o": 36, "k": "tou="}, {"t": "γαργαλίζεσθαι", "o": 40, "k": "gargali/zesqai"}]}, {"n": 29, "text": "συμβαίνει.", "tokens": [{"t": "συμβαίνει", "o": 0, "k": "sumbai/nei"}]}, {"n": 30, "text": "Διὰ τί γαργαλίζονται τὰς μασχάλας καὶ τὰ ἐντὸς", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "γαργαλίζονται", "o": 7, "k": "gargali/zontai"}, {"t": "τὰς", "o": 21, "k": "ta/s"}, {"t": "μασχάλας", "o": 25, "k": "masxa/las"}, {"t": "καὶ", "o": 34, "k": "kai/"}, {"t": "τὰ", "o": 38, "k": "ta/"}, {"t": "ἐντὸς", "o": 41, "k": "e)nto/s"}]}, {"n": 31, "text": "τῶν ποδῶν; ἢ διὰ τὴν λεπτότητα τοῦ δέρματος; καὶ ὧν", "tokens": [{"t": "τῶν", "o": 0, "k": "tw=n"}, {"t": "ποδῶν", "o": 4, "k": "podw=n"}, {"t": "ἢ", "o": 11, "k": "h)/"}, {"t": "διὰ", "o": 13, "k": "dia/"}, {"t": "τὴν", "o": 17, "k": "th/n"}, {"t": "λεπτότητα", "o": 21, "k": "lepto/thta"}, {"t": "τοῦ", "o": 31, "k": "tou="}, {"t": "δέρματος", "o": 35, "k": "de/rmatos"}, {"t": "καὶ", "o": 45, "k": "kai/"}, {"t": "ὧν", "o": 49, "k": "w(=n"}]}, {"n": 32, "text": "ἀσυνήθης ἡ ἁφή, οἷον τούτων καὶ τοῦ ὠτός;", "tokens": [{"t": "ἀσυνήθης", "o": 0, "k": "a)sunh/qhs"}, {"t": "ἡ", "o": 9, "k": "h("}, {"t": "ἁφή", "o": 11, "k": "a(fh/"}, {"t": "οἷον", "o": 16, "k": "oi(=on"}, {"t": "τούτων", "o": 21, "k": "tou/twn"}, {"t": "καὶ", "o": 28, "k": "kai/"}, {"t": "τοῦ", "o": 32, "k": "tou="}, {"t": "ὠτός", "o": 36, "k": "w)to/s"}]}, {"n": 33, "text": "Διὰ τί φρίττουσιν οὐκ ἐπὶ τοῖς αὐτοῖς πάντες; ἢ ὅτι οὐδ'", "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "φρίττουσιν", "o": 7, "k": "fri/ttousin"}, {"t": "οὐκ", "o": 18, "k": "ou)k"}, {"t": "ἐπὶ", "o": 22, "k": "e)pi/"}, {"t": "τοῖς", "o": 26, "k": "toi=s"}, {"t": "αὐτοῖς", "o": 31, "k": "au)toi=s"}, {"t": "πάντες", "o": 38, "k": "pa/ntes"}, {"t": "ἢ", "o": 46, "k": "h)/"}, {"t": "ὅτι", "o": 48, "k": "o(/ti"}, {"t": "οὐδ'", "o": 52, "k": "ou)d'"}]}, {"n": 34, "text": "ἐπὶ τοῖς αὐτοῖς πάντες ἡδόμεθα, ὥσπερ οὐδὲ λυπούμεθα ἐπὶ", "tokens": [{"t": "ἐπὶ", "o": 0, "k": "e)pi/"}, {"t": "τοῖς", "o": 4, "k": "toi=s"}, {"t": "αὐτοῖς", "o": 9, "k": "au)toi=s"}, {"t": "πάντες", "o": 16, "k": "pa/ntes"}, {"t": "ἡδόμεθα", "o": 23, "k": "h(do/meqa"}, {"t": "ὥσπερ", "o": 32, "k": "w(/sper"}, {"t": "οὐδὲ", "o": 38, "k": "ou)de/"}, {"t": "λυπούμεθα", "o": 43, "k": "lupou/meqa"}, {"t": "ἐπὶ", "o": 53, "k": "e)pi/"}]}, {"n": 35, "text": "τοῖς αὐτοῖς πάντες; ὁμοίως δὴ οὐ φρίττομεν ἐπὶ τοῖς αὐτοῖς·", "tokens": [{"t": "τοῖς", "o": 0, "k": "toi=s"}, {"t": "αὐτοῖς", "o": 5, "k": "au)toi=s"}, {"t": "πάντες", "o": 12, "k": "pa/ntes"}, {"t": "ὁμοίως", "o": 20, "k": "o(moi/ws"}, {"t": "δὴ", "o": 27, "k": "dh/"}, {"t": "οὐ", "o": 30, "k": "ou)"}, {"t": "φρίττομεν", "o": 33, "k": "fri/ttomen"}, {"t": "ἐπὶ", "o": 43, "k": "e)pi/"}, {"t": "τοῖς", "o": 47, "k": "toi=s"}, {"t": "αὐτοῖς", "o": 52, "k": "au)toi=s"}]}, {"n": 36, "text": "ἔστι γὰρ ἡ αὐτὴ κατάψυξίς τις. διὸ οἱ μὲν τοῦ ἱματίου δακνομένου", "joined": true, "tokens": [{"t": "ἔστι", "o": 0, "k": "e)/sti"}, {"t": "γὰρ", "o": 5, "k": "ga/r"}, {"t": "ἡ", "o": 9, "k": "h("}, {"t": "αὐτὴ", "o": 11, "k": "au)th/"}, {"t": "κατάψυξίς", "o": 16, "k": "kata/yucis"}, {"t": "τις", "o": 26, "k": "tis"}, {"t": "διὸ", "o": 31, "k": "dio/"}, {"t": "οἱ", "o": 35, "k": "oi("}, {"t": "μὲν", "o": 38, "k": "me/n"}, {"t": "τοῦ", "o": 42, "k": "tou="}, {"t": "ἱματίου", "o": 46, "k": "i(mati/ou"}, {"t": "δακνομένου", "o": 54, "k": "daknome/nou"}]}, {"n": 37, "text": "φρίττουσιν, οἱ δὲ πρίονος ἀκονουμένου ἢ ἑλκομένου, οἱ δὲ", "tokens": [{"t": "φρίττουσιν", "o": 0, "k": "fri/ttousin"}, {"t": "οἱ", "o": 12, "k": "oi("}, {"t": "δὲ", "o": 15, "k": "de/"}, {"t": "πρίονος", "o": 18, "k": "pri/onos"}, {"t": "ἀκονουμένου", "o": 26, "k": "a)konoume/nou"}, {"t": "ἢ", "o": 38, "k": "h)/"}, {"t": "ἑλκομένου", "o": 40, "k": "e(lkome/nou"}, {"t": "οἱ", "o": 51, "k": "oi("}, {"t": "δὲ", "o": 54, "k": "de/"}]}, {"n": 38, "text": "κισήρεως τεμνομένης, οἱ δὲ ὄνου λίθον ἀλοῦντος.", "tokens": [{"t": "κισήρεως", "o": 0, "k": "kish/rews"}, {"t": "τεμνομένης", "o": 9, "k": "temnome/nhs"}, {"t": "οἱ", "o": 21, "k": "oi("}, {"t": "δὲ", "o": 24, "k": "de/"}, {"t": "ὄνου", "o": 27, "k": "o)/nou"}, {"t": "λίθον", "o": 32, "k": "li/qon"}, {"t": "ἀλοῦντος", "o": 38, "k": "a)lou=ntos"}]}, {"n": 39, "text": "Διὰ τί τοῦ μὲν θέρους ὄντος θερμοῦ, τοῦ δὲ χειμῶνος ψυχροῦ,", "joined": true, "tokens": [{"t": "Διὰ", "o": 0, "k": "dia/"}, {"t": "τί", "o": 4, "k": "ti/"}, {"t": "τοῦ", "o": 7, "k": "tou="}, {"t": "μὲν", "o": 11, "k": "me/n"}, {"t": "θέρους", "o": 15, "k": "qe/rous"}, {"t": "ὄντος", "o": 22, "k": "o)/ntos"}, {"t": "θερμοῦ", "o": 28, "k": "qermou="}, {"t": "τοῦ", "o": 36, "k": "tou="}, {"t": "δὲ", "o": 40, "k": "de/"}, {"t": "χειμῶνος", "o": 43, "k": "xeimw=nos"}, {"t": "ψυχροῦ", "o": 52, "k": "yuxrou="}]}], "english": {"text": "Why do we shudder more when some one else touches us than when we touch ourselves? Is it because the touch of a part of some one else has more power to produce sensation than that of a part of oneself, since that which is connected by growth with the sense-organ is imperceptible? Also anything which occurs unawares and suddenly is more frightening, and fright is a process of cooling; and both these qualities are possessed by the touch of another as contrasted with one’s own touch. And, speaking generally, passive sensation is produced either solely by some one else or at any rate in a greater degree than by oneself; as happens for example in tickling. Why do we feel tickling in the armpits and on the soles of the feet? Is it owing to the thinness of the skin? And do we feel it most where we are unaccustomed to being touched, as in these parts and the ears? Why is it that every one does not shudder at the same things? Is it because, just as we do not all feel pleasure or pain at the same things, so we do not shudder at the same things? For the same sort of cooling process takes place. So some people shudder when a garment is torn, others when a saw is being sharpened or drawn through wood, others when pumice-stone is being cut, others when the millstone is grinding on stone. Why is it that, though the summer is warm and the", "notes": [], "markers": [{"kind": "section", "n": "1", "offset": 0}, {"kind": "section", "n": "2", "offset": 660}, {"kind": "section", "n": "3", "offset": 869}, {"kind": "section", "n": "4", "offset": 1295}], "bekker": [{"n": 21, "offset": 0, "real": true}, {"n": 25, "offset": 281, "real": true}, {"n": 30, "offset": 660, "real": true}, {"n": 35, "offset": 1038, "real": true}]}}, {"id": "35:965a", "column": "965a", "chapterStarts": [{"chapter": "5", "beforeLine": 8, "wordIndex": 0, "engOffset": 461, "bekker": "965a8–10"}, {"chapter": "6", "beforeLine": 11, "wordIndex": 0, "engOffset": 643, "bekker": "965a11–17"}, {"chapter": "7", "beforeLine": 18, "wordIndex": 0, "engOffset": 1239, "bekker": "965a18–22"}, {"chapter": "8", "beforeLine": 23, "wordIndex": 0, "engOffset": 1578, "bekker": "965a23–32"}, {"chapter": "9", "beforeLine": 33, "wordIndex": 0, "engOffset": 2389, "bekker": "965a33–35"}, {"chapter": "10", "beforeLine": 36, "wordIndex": 0, "engOffset": 2567, "bekker": "965a36–39"}], "greek": [{"n": 1, "text": "τὰ σώματα θιγγανόντων ψυχεινότερά ἐστι τοῦ θέρους ἢ", "tokens": [{"t": "τὰ", "o": 0, "k": "ta/"}, {"t": "σώματα", "o": 3, "k": "sw/mata"}, {"t": "θιγγανόντων", "o": 10, "k": "qiggano/ntwn"}, {"t": "ψυχεινότερά", "o": 22, "k": "yuxeino/tera"}, {"t": "ἐστι", "o": 34, "k": "e)sti"}, {"t": "τοῦ", "o": 39, "k": "tou="}, {"t": "θέρους", "o": 43, "k": "qe/rous"}, {"t": "ἢ", "o": 50, "k": "h)/"}]}, {"n": 2, "text": "τοῦ χειμῶνος; πότερον ὅτι ὁ ἱδρὼς καὶ ἡ ἴδισις καταψύχει", "tokens": [{"t": "τοῦ", "o": 0, "k": "tou="}, {"t": "χειμῶνος", "o": 4, "k": "xeimw=nos"}, {"t": "πότερον", "o": 14, "k": "po/teron"}, {"t": "ὅτι", "o": 22, "k": "o(/ti"}, {"t": "ὁ", "o": 26, "k": "o("}, {"t": "ἱδρὼς", "o": 28, "k": "i(drw/s"}, {"t": "καὶ", "o": 34, "k": "kai/"}, {"t": "ἡ", "o": 38, "k": "h("}, {"t": "ἴδισις", "o": 40, "k": "i)/disis"}, {"t": "καταψύχει", "o": 47, "k": "katayu/xei"}]}, {"n": 3, "text"