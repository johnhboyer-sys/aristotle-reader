{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: read the bundled/app-data corpus; native dialogs for the future import flow.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-resource-read-recursive",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "opener:allow-open-url",
    "updater:default"
  ]
}
