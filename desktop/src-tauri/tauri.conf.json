{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Aristotle Reader",
  "version": "0.1.0",
  "identifier": "org.aristotlereader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Aristotle Reader",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/corpus/**", "$RESOURCE/corpus/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
