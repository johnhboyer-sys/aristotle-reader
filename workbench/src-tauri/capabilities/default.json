{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: read/write the app-data workspace; native dialogs for import/export; clipboard for copy actions; shell to run Diogenes' perl exporter and pandoc as subprocesses. The fs:allow-exists scope covers onboarding's existence checks only (Diogenes install location and the user-picked TLG folder).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-resource-read-recursive",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "/Applications/Diogenes.app/**" }, { "path": "/**" }]
    },
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    "opener:allow-open-path",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "diogenes-export",
          "cmd": "perl",
          "args": [
            "xml-export.pl",
            "-c",
            "tlg",
            "-n",
            { "validator": "^\\d{4}$" },
            "-y",
            "-o",
            { "validator": "^/.+" }
          ]
        }
      ]
    },
    "shell:allow-open"
  ]
}
